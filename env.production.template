# =============================================================================
# Dethernety OSS Production Environment Configuration Template
# =============================================================================
# Copy this file to .env.production and customize for your deployment
#
# This template shows the backend's environment variables, including those it
# serves to the frontend, and how they should be coordinated for production
# deployment.

# =============================================================================
# BACKEND CONFIGURATION (dt-ws)
# =============================================================================

# Application Settings
NODE_ENV=production
PORT=3000
LOG_LEVEL=log
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Neo4j Database Configuration
NEO4J_URI=neo4j+s://your-cluster.databases.neo4j.io:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-secure-password-here
NEO4J_DATABASE=production
NEO4J_ENCRYPTED=true
NEO4J_TRUST_CERT=false
NEO4J_MAX_POOL_SIZE=100

# Authentication (OIDC/OAuth2)
# This MUST match the issuer used in frontend configuration
OIDC_JWKS_URI=https://auth.yourdomain.com/.well-known/jwks.json
# Expected token audience (aud claim, or client_id if no aud); differs by provider
OIDC_AUDIENCE=your-token-audience

# GraphQL Security
GQL_QUERY_DEPTH_LIMIT=10
GQL_QUERY_COMPLEXITY_LIMIT=1000
GQL_ENABLE_SUBSCRIPTIONS=true

# Module Registry (Production Security)
ALLOWED_MODULES=dethermine-module,dt-built-in-module
ENABLE_MODULE_HOT_RELOAD=false
CUSTOM_MODULES_PATH=custom_modules

# Performance & Caching
TEMPLATE_CACHE_SIZE=500
TEMPLATE_CACHE_TTL_MS=600000
ANALYSIS_CACHE_SIZE=200
ANALYSIS_CACHE_TTL_MS=1200000

# Monitoring
MONITORING_ENABLED=true
HEALTH_CHECK_INTERVAL_MS=30000
STATISTICS_RETENTION_HOURS=48

# Embeddings (optional — vector similarity for class and MITRE technique matching)
# The platform embeds in process with a built-in embedding profile. Leave
# EMBEDDING_MODEL unset for the default (embeddinggemma-300m-retrieval-v1, the
# profile the MITRE data's vectors are made with); with EMBEDDING_ENABLED=true the
# platform refuses any other model. Its weights (about 1.26 GB) are downloaded and verified on first start
# into EMBEDDING_MODEL_DIR: keep that directory on persistent storage.
# EMBEDDING_THREADS sets the inference threads (default 4); HF_TOKEN is needed only
# for a gated weight source. EMBEDDING_THRESHOLD_CLASSES / _MITRE / _COMPONENTS
# override the profile's similarity floors.
EMBEDDING_ENABLED=false
EMBEDDING_MODEL=
EMBEDDING_MODEL_DIR=models
EMBEDDING_THREADS=4

# =============================================================================
# FRONTEND CONFIGURATION (dt-ui) - SERVED BY THE BACKEND AT RUN TIME
# =============================================================================
# The backend reads these from its environment and serves them to the frontend
# from GET /config. A production dt-ui build reads its configuration only from
# that response; their VITE_* counterparts apply to a development build only.
# See docs/CONFIGURATION_GUIDE.md.
# The backend also uses OIDC_ISSUER itself to validate tokens. For the variables
# it refuses to start in production without, see "Production Requirements" in
# docs/CONFIGURATION_GUIDE.md.

# OIDC Configuration (same provider as OIDC_JWKS_URI above)
OIDC_ISSUER=https://auth.yourdomain.com
OIDC_CLIENT_ID=your-production-client-id
OIDC_REDIRECT_URI=https://yourdomain.com/auth/callback

# Application Configuration
APP_BASE_URL=/
APP_URL=https://yourdomain.com

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================

# 1. OIDC Coordination:
#    - Backend OIDC_JWKS_URI should be: https://auth.yourdomain.com/.well-known/jwks.json
#    - Backend OIDC_ISSUER (served to the frontend by GET /config) should be: https://auth.yourdomain.com
#    - Both must use the same authentication provider

# 2. CORS Configuration:
#    - ALLOWED_ORIGINS should include your domain
#    - Frontend will be served from the same domain as backend

# 3. Database Security:
#    - Use encrypted connections (NEO4J_ENCRYPTED=true)
#    - Use strong passwords
#    - Consider network-level security

# 4. Module Security:
#    - Explicitly list allowed modules in ALLOWED_MODULES
#    - Disable hot reload in production (ENABLE_MODULE_HOT_RELOAD=false)

# 5. Frontend URLs:
#    - GET /config serves the relative URL /graphql, since the backend serves the frontend
#    - WebSocket URL auto-detection handles wss:// protocol
