    "test": "vitest run"
  },
  "dependencies": {
    "@apollo/client": "^4.2.12",
    "@vue-flow/core": "^1.48.2",
    "graphql-tag": "^2.12.7",
    "js-yaml": "^4.3.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.5",
    "vitest": "^4.1.11"
