{
  "name": "@dethernety/dt-module",
  "version": "0.9.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./embedding": {
      "types": "./dist/embedding-text.d.ts",
      "require": "./dist/embedding-text.js",
      "default": "./dist/embedding-text.js"
    },
    "./rego-adhoc": {
      "types": "./dist/rego-adhoc.d.ts",
      "require": "./dist/rego-adhoc.js",
      "default": "./dist/rego-adhoc.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "require": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "embedding": [
        "dist/embedding-text.d.ts"
      ],
      "rego-adhoc": [
        "dist/rego-adhoc.d.ts"
      ],
      "testing": [
        "dist/testing/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev": "tsc -b tsconfig.build.json -w",
    "test": "vitest run"
  },
  "dependencies": {
    "@dethernety/dt-core": "workspace:*",
    "@dethernety/regorus-wasm": "workspace:*",
    "@langchain/langgraph-sdk": "^1.9.28",
    "@nestjs/common": "^11.1.28",
    "graphql": "^16.14.2",
    "graphql-subscriptions": "^3.0.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@types/uuid": "^10.0.0",
    "vitest": "^4.1.10"
  }
}
