{
  "name": "@dethernety/dt-module",
  "version": "0.12.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cypher-lint": {
      "types": "./dist/cypher-lint.d.ts",
      "require": "./dist/cypher-lint.js",
      "default": "./dist/cypher-lint.js"
    },
    "./embedding": {
      "types": "./dist/embedding.d.ts",
      "require": "./dist/embedding.js",
      "default": "./dist/embedding.js"
    },
    "./rego-adhoc": {
      "types": "./dist/rego-adhoc.d.ts",
      "require": "./dist/rego-adhoc.js",
      "default": "./dist/rego-adhoc.js"
    },
    "./rego-engine": {
      "types": "./dist/rego-engine.d.ts",
      "require": "./dist/rego-engine.js",
      "default": "./dist/rego-engine.js"
    },
    "./rego-mapping": {
      "types": "./dist/rego-mapping.d.ts",
      "require": "./dist/rego-mapping.js",
      "default": "./dist/rego-mapping.js"
    },
    "./test-database": {
      "types": "./dist/test-database.d.ts",
      "require": "./dist/test-database.js",
      "default": "./dist/test-database.js"
    },
    "./frontend-manifest": {
      "types": "./dist/frontend-manifest.d.ts",
      "require": "./dist/frontend-manifest.js",
      "default": "./dist/frontend-manifest.js"
    },
    "./frontend-manifest.schema.json": "./dist/frontend-manifest.schema.json",
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "require": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "cypher-lint": [
        "dist/cypher-lint.d.ts"
      ],
      "embedding": [
        "dist/embedding.d.ts"
      ],
      "rego-adhoc": [
        "dist/rego-adhoc.d.ts"
      ],
      "rego-engine": [
        "dist/rego-engine.d.ts"
      ],
      "rego-mapping": [
        "dist/rego-mapping.d.ts"
      ],
      "test-database": [
        "dist/test-database.d.ts"
      ],
      "frontend-manifest": [
        "dist/frontend-manifest.d.ts"
      ],
      "testing": [
        "dist/testing/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev": "tsc -b tsconfig.build.json -w",
    "test": "vitest run"
  },
  "dependencies": {
    "@dethernety/dt-core": "workspace:*",
    "@dethernety/regorus-wasm": "workspace:*",
    "@langchain/langgraph-sdk": "^1.12.8",
    "@nestjs/common": "^11.2.8",
    "graphql": "^16.14.2",
    "graphql-subscriptions": "^3.0.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "@types/uuid": "^10.0.0",
    "vitest": "^4.1.12"
  }
}
