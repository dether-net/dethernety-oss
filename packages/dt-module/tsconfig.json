{
  "compilerOptions": {
    "target": "ES2023",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "dist",
    "declaration": true,      // This enables the generation of .d.ts files
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true, // the built-in embedding profiles are JSON, emitted into dist
    "skipLibCheck": true
  },
  "include": ["src"]
}
