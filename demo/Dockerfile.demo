# Demo Dockerfile — builds a Dethernety image with authentication disabled.
#
# This image includes schema-noauth.graphql and defaults to NODE_ENV=development
# so the backend and frontend run in auth-less mode.
#
# Build context must be the oss/ directory (parent of demo/):
#   docker build -f demo/Dockerfile.demo -t dethernety:demo .
#
# DO NOT use this image in production.

FROM node:26-alpine AS runtime

# Install specific pnpm version, curl for healthcheck
RUN npm install -g pnpm@9.13.2 && \
    apk add --no-cache curl bash && \
    rm -rf /var/cache/apk/* && \
    rm -rf ~/.npm

# Create app user for security
RUN addgroup -g 1001 -S nodejs
RUN adduser -S nestjs -u 1001

WORKDIR /app

# Copy workspace configuration to respect overrides
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/dt-ws/package.json ./apps/dt-ws/package.json
COPY packages/dt-core/package.json ./packages/dt-core/package.json
COPY packages/dt-module/package.json ./packages/dt-module/package.json
COPY packages/regorus-wasm/package.json ./packages/regorus-wasm/package.json

# Copy built workspace packages
COPY packages/dt-core/dist ./packages/dt-core/dist
COPY packages/dt-module/dist ./packages/dt-module/dist

# Copy the vendored Regorus WASM artifact. This package has no build step — its
# committed files ARE the deliverable, so they live at the package root rather
# than in dist/. Files are listed explicitly: a wholesale directory COPY would
# also pull in packages/regorus-wasm/node_modules (.dockerignore's `node_modules`
# only matches the context root).
COPY packages/regorus-wasm/regorusjs.js \
     packages/regorus-wasm/regorusjs_bg.wasm \
     packages/regorus-wasm/regorusjs.d.ts \
     packages/regorus-wasm/regorusjs_bg.wasm.d.ts \
     packages/regorus-wasm/SHA256SUMS \
     packages/regorus-wasm/LICENSE \
     packages/regorus-wasm/THIRD_PARTY_LICENSES.txt \
     ./packages/regorus-wasm/

# Install dependencies with workspace context (respects overrides)
RUN pnpm install --prod --frozen-lockfile --no-optional && \
    rm -rf /var/cache/apk/*

# Create symlinks for workspace packages (pnpm doesn't auto-link them in prod mode)
# This allows dynamically loaded modules to resolve @dethernety/dt-module
RUN mkdir -p /app/node_modules/@dethernety && \
    ln -s /app/packages/dt-module /app/node_modules/@dethernety/dt-module && \
    ln -s /app/packages/dt-core /app/node_modules/@dethernety/dt-core && \
    ln -s /app/packages/regorus-wasm /app/node_modules/@dethernety/regorus-wasm

# Copy pre-built backend to the workspace app directory
COPY apps/dt-ws/dist ./apps/dt-ws/dist
COPY apps/dt-ws/schema ./apps/dt-ws/schema

# Copy pre-built frontend (already placed in public by build-production.sh)
COPY apps/dt-ws/public ./apps/dt-ws/public

# Set ownership
RUN chown -R nestjs:nodejs /app
USER nestjs

# Demo: development mode — enables auth-less mode when OIDC is not configured
ENV NODE_ENV=development

# Expose port
EXPOSE 3003

# Set working directory to where the app and its node_modules are
WORKDIR /app/apps/dt-ws

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:3003/health/simple || exit 1

# Add metadata
LABEL maintainer="dether-net" \
      description="Dethernety demo container (auth disabled — NOT for production)"

# Start the application with proper signal handling
CMD ["node", "--enable-source-maps", "dist/main.js"]
