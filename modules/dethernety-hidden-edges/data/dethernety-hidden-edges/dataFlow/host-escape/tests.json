[
  {
    "name": "Minimal Input",
    "description": "Empty input: no technique ids, no exposure",
    "input": {},
    "expectedExposures": []
  },
  {
    "name": "One Technique",
    "description": "One path technique gives one exposure",
    "input": {
      "technique_ids": [
        "T1021"
      ],
      "tier": "high",
      "hidden_edge_kind": "remote-service"
    },
    "expectedExposures": [
