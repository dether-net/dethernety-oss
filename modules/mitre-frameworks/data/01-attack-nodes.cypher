SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[FIVEHANDS](https://attack.mitre.org/software/S0618) is a customized version of [DEATHRANSOM](https://attack.mitre.org/software/S0616) ransomware written in C++. [FIVEHANDS](https://attack.mitre.org/software/S0618) has been used since at least 2021, including in Ransomware-as-a-Service (RaaS) campaigns, sometimes along with [SombRAT](https://attack.mitre.org/software/S0615).(Citation: FireEye FiveHands April 2021)(Citation: NCC Group Fivehands June 2021)", n.name = "FIVEHANDS", n.ontolocy_created = "2026-06-18T09:26:41.453228000", n.ontolocy_merged = "2026-06-18T09:26:41.453228000", n.ref_url = "https://attack.mitre.org/software/S0618", n.stix_created = "2021-06-04T15:34:01.097000000+00:00", n.stix_id = "malware--f464354c-7103-47c6-969b-8766f0157ed2", n.stix_modified = "2024-04-11T02:33:06.963000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

