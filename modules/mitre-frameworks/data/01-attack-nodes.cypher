SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[Chrommme](https://attack.mitre.org/software/S0667) is a backdoor tool written using the Microsoft Foundation Class (MFC) framework that was first reported in June 2021; security researchers noted infrastructure overlaps with [Gelsemium](https://attack.mitre.org/software/S0666) malware.(Citation: ESET Gelsemium June 2021)", n.name = "Chrommme", n.ontolocy_created = "2026-06-18T09:26:41.189405000", n.ontolocy_merged = "2026-06-18T09:26:41.189405000", n.ref_url = "https://attack.mitre.org/software/S0667", n.stix_created = "2021-12-01T18:36:54.260000000+00:00", n.stix_id = "malware--579607c2-d046-40df-99ab-beb479c37a2a", n.stix_modified = "2024-04-11T02:45:43.666000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

