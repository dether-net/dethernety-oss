SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "2.2", n.description = "[PoisonIvy](https://attack.mitre.org/software/S0012) is a popular remote access tool (RAT) that has been used by many groups.(Citation: FireEye Poison Ivy)(Citation: Symantec Elderwood Sept 2012)(Citation: Symantec Darkmoon Aug 2005)", n.name = "PoisonIvy", n.ontolocy_created = "2026-06-18T09:26:41.350363000", n.ontolocy_merged = "2026-06-18T09:26:41.350363000", n.ref_url = "https://attack.mitre.org/software/S0012", n.stix_created = "2017-05-31T21:32:15.263000000+00:00", n.stix_id = "malware--b42378e0-f147-496f-992a-26a49705395b", n.stix_modified = "2024-11-17T19:55:07.591000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

