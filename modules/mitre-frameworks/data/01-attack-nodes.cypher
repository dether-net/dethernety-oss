ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "2.1", n.description = "[Bisonal](https://attack.mitre.org/software/S0268) is a remote access tool (RAT) that has been used by [Tonto Team](https://attack.mitre.org/groups/G0131) against public and private sector organizations in Russia, South Korea, and Japan since at least December 2010.(Citation: Unit 42 Bisonal July 2018)(Citation: Talos Bisonal Mar 2020)", n.name = "Bisonal", n.ontolocy_created = "2026-06-18T09:26:41.221954000", n.ontolocy_merged = "2026-06-18T09:26:41.221954000", n.ref_url = "https://attack.mitre.org/software/S0268", n.stix_created = "2018-10-17T00:14:20.652000000+00:00", n.stix_id = "malware--65ffc206-d7c1-45b3-b543-f6b726e7840d", n.stix_modified = "2024-04-11T02:53:35.918000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

