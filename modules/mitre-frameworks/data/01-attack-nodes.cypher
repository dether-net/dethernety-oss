SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.6", n.description = "[LaZagne](https://attack.mitre.org/software/S0349) is a post-exploitation, open-source tool used to recover stored passwords on a system. It has modules for Windows, Linux, and OSX, but is mainly focused on Windows systems. [LaZagne](https://attack.mitre.org/software/S0349) is publicly available on GitHub.(Citation: GitHub LaZagne Dec 2018)", n.name = "LaZagne", n.ontolocy_created = "2026-06-18T09:26:41.514698000", n.ontolocy_merged = "2026-06-18T09:26:41.514698000", n.ref_url = "https://attack.mitre.org/software/S0349", n.stix_created = "2019-01-30T16:44:59.887000000+00:00", n.stix_id = "tool--b76b2d94-60e4-4107-a903-4a3a7622fb3b", n.stix_modified = "2024-04-04T03:49:27.035000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "tool";

