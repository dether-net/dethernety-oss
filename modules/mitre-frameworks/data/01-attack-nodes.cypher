MERGE (n:MitreAttackSoftware {attack_id: "S1229"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.3.0", n.attack_version = "1.0", n.description = "[Havoc](https://attack.mitre.org/software/S1229) is an open-source post-exploitation command and control (C2) framework first released on GitHub in October 2022 by C5pider (Paul Ungur), who continues to maintain and develop it with community contributors. [Havoc](https://attack.mitre.org/software/S1229) provides a wide range of offensive security capabilities and has been adopted by multiple threat actors to establish and maintain control over compromised systems.", n.name = "Havoc", n.ontolocy_created = "2026-06-18T09:26:41.066905000", n.ontolocy_merged = "2026-06-18T09:26:41.066905000", n.ref_url = "https://attack.mitre.org/software/S1229", n.stix_created = "2025-08-05T18:12:15.228000000+00:00", n.stix_id = "malware--1996aed9-6234-4c1d-a145-e8a4913679dd", n.stix_modified = "2025-10-24T03:07:43.276000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

