SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "2.2", n.description = "[jRAT](https://attack.mitre.org/software/S0283) is a cross-platform, Java-based backdoor originally available for purchase in 2012. Variants of [jRAT](https://attack.mitre.org/software/S0283) have been distributed via a software-as-a-service platform, similar to an online subscription model.(Citation: Kaspersky Adwind Feb 2016) (Citation: jRAT Symantec Aug 2018)", n.name = "jRAT", n.ontolocy_created = "2026-06-18T09:26:41.444875000", n.ontolocy_merged = "2026-06-18T09:26:41.444875000", n.ref_url = "https://attack.mitre.org/software/S0283", n.stix_created = "2018-10-17T00:14:20.652000000+00:00", n.stix_id = "malware--efece7e8-e40b-49c2-9f84-c55c5c93d05c", n.stix_modified = "2023-10-03T19:38:43.114000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

