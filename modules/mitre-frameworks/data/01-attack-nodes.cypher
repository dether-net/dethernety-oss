SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[SeaDuke](https://attack.mitre.org/software/S0053) is malware that was used by [APT29](https://attack.mitre.org/groups/G0016) from 2014 to 2015. It was used primarily as a secondary backdoor for victims that were already compromised with [CozyCar](https://attack.mitre.org/software/S0046). (Citation: F-Secure The Dukes)", n.name = "SeaDuke", n.ontolocy_created = "2026-06-18T09:26:41.224764000", n.ontolocy_merged = "2026-06-18T09:26:41.224764000", n.ref_url = "https://attack.mitre.org/software/S0053", n.stix_created = "2017-05-31T21:32:37.767000000+00:00", n.stix_id = "malware--67e6d66b-1b82-4699-b47a-e2efb6268d14", n.stix_modified = "2025-04-25T14:43:37.740000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

