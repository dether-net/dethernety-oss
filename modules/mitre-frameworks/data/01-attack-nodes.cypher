SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[SpicyOmelette](https://attack.mitre.org/software/S0646) is a JavaScript based remote access tool that has been used by [Cobalt Group](https://attack.mitre.org/groups/G0080) since at least 2018.(Citation: Secureworks GOLD KINGSWOOD September 2018)", n.name = "SpicyOmelette", n.ontolocy_created = "2026-06-18T09:26:41.195412000", n.ontolocy_merged = "2026-06-18T09:26:41.195412000", n.ref_url = "https://attack.mitre.org/software/S0646", n.stix_created = "2021-09-21T14:55:00.996000000+00:00", n.stix_id = "malware--599cd7b5-37b5-4cdd-8174-2811531ce9d0", n.stix_modified = "2025-04-25T14:43:27.242000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0161"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.3", n.description = "[XAgentOSX](https://attack.mitre.org/software/S0161) is a trojan that has been used by [APT28](https://attack.mitre.org/groups/G0007)  on OS X and appears to be a port of their standard [CHOPSTICK](https://attack.mitre.org/software/S0023) or XAgent trojan. (Citation: XAgentOSX 2017)", n.name = "XAgentOSX", n.ontolocy_created = "2026-06-18T09:26:41.195997000", n.ontolocy_merged = "2026-06-18T09:26:41.195997000", n.ref_url = "https://attack.mitre.org/software/S0161", n.stix_created = "2017-12-14T16:46:06.044000000+00:00", n.stix_id = "malware--59a97b15-8189-4d51-9404-e1ce8ea4a069", n.stix_modified = "2025-04-25T14:43:27.602000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0690"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[Green Lambert](https://attack.mitre.org/software/S0690) is a modular backdoor that security researchers assess has been used by an advanced threat group referred to as Longhorn and The Lamberts. First reported in 2017, the Windows variant of [Green Lambert](https://attack.mitre.org/software/S0690) may have been used as early as 2008; a macOS version was uploaded to a multiscanner service in September 2014.(Citation: Kaspersky Lamberts Toolkit April 2017)(Citation: Objective See Green Lambert for OSX Oct 2021)  ", n.name = "Green Lambert", n.ontolocy_created = "2026-06-18T09:26:41.196601000", n.ontolocy_merged = "2026-06-18T09:26:41.196601000", n.ref_url = "https://attack.mitre.org/software/S0690", n.stix_created = "2022-03-21T20:55:40.638000000+00:00", n.stix_id = "malware--59c8a28c-200c-4565-9af1-cbdb24870ba0", n.stix_modified = "2025-04-16T20:38:10.718000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0020"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "2.5", n.description = "[China Chopper](https://attack.mitre.org/software/S0020) is a [Web Shell](https://attack.mitre.org/techniques/T1505/003) hosted on Web servers to provide access back into an enterprise network that does not rely on an infected system calling back to a remote command and control server.(Citation: Lee 2013) It has been used by several threat groups.(Citation: Dell TG-3390)(Citation: FireEye Periscope March 2018)(Citation: CISA AA21-200A APT40 July 2021)(Citation: Rapid7 HAFNIUM Mar 2021)", n.name = "China Chopper", n.ontolocy_created = "2026-06-18T09:26:41.197170000", n.ontolocy_merged = "2026-06-18T09:26:41.197170000", n.ref_url = "https://attack.mitre.org/software/S0020", n.stix_created = "2017-05-31T21:32:18.315000000+00:00", n.stix_id = "malware--5a3a31fe-5a8f-48e1-bff0-a753e5b1be70", n.stix_modified = "2024-01-03T21:37:14.516000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S1163"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[SnappyTCP](https://attack.mitre.org/software/S1163) is a web shell used by [Sea Turtle](https://attack.mitre.org/groups/G1041) between 2021 and 2023 against multiple victims. [SnappyTCP](https://attack.mitre.org/software/S1163) appears to be based on a public GitHub project that has since been removed from the code-sharing site. [SnappyTCP](https://attack.mitre.org/software/S1163) includes a simple reverse TCP shell for Linux and Unix environments with basic command and control capabilities.(Citation: PWC Sea Turtle 2023)", n.name = "SnappyTCP", n.ontolocy_created = "2026-06-18T09:26:41.197741000", n.ontolocy_merged = "2026-06-18T09:26:41.197741000", n.ref_url = "https://attack.mitre.org/software/S1163", n.stix_created = "2024-11-20T20:59:11.460000000+00:00", n.stix_id = "malware--5a6fa62e-4ddf-4ae3-974a-f17f24058350", n.stix_modified = "2025-01-07T16:01:34.817000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

