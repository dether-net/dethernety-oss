ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[BlackByte 2.0 Ransomware](https://attack.mitre.org/software/S1181) is a replacement for [BlackByte Ransomware](https://attack.mitre.org/software/S1180). Unlike [BlackByte Ransomware](https://attack.mitre.org/software/S1180), [BlackByte 2.0 Ransomware](https://attack.mitre.org/software/S1181) does not have a common key for victim decryption. [BlackByte 2.0 Ransomware](https://attack.mitre.org/software/S1181) remains uniquely associated with [BlackByte](https://attack.mitre.org/groups/G1043) operations.(Citation: Microsoft BlackByte 2023)", n.name = "BlackByte 2.0 Ransomware", n.ontolocy_created = "2026-06-18T09:26:41.137940000", n.ontolocy_merged = "2026-06-18T09:26:41.137940000", n.ref_url = "https://attack.mitre.org/software/S1181", n.stix_created = "2024-12-17T01:09:17.837000000+00:00", n.stix_id = "malware--42fdf9db-6005-4bb3-96f6-496b94ce519d", n.stix_modified = "2025-03-09T16:01:39.889000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

