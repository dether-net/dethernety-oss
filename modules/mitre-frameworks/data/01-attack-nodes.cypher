SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[Ferocious Kitten](https://attack.mitre.org/groups/G0137) is a threat group that has primarily targeted Persian-speaking individuals in Iran since at least 2015.(Citation: Kaspersky Ferocious Kitten Jun 2021)", n.name = "Ferocious Kitten", n.ontolocy_created = "2026-06-18T09:26:45.290387000", n.ontolocy_merged = "2026-06-18T09:26:45.290387000", n.ref_url = "https://attack.mitre.org/groups/G0137", n.stix_created = "2021-09-28T17:41:12.950000000+00:00", n.stix_id = "intrusion-set--6566aac9-dad8-4332-ae73-20c23bad7f02", n.stix_modified = "2025-04-25T14:49:38.455000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "intrusion-set";

