ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.3.0", n.attack_version = "2.0", n.description = "Changes made to a running process, such as writing data into memory, modifying execution behavior, or injecting code into an existing process. Adversaries frequently modify processes to execute malicious payloads, evade detection, or gain escalated privileges.", n.name = "Process Modification", n.ontolocy_created = "2026-06-18T09:26:44.812728000", n.ontolocy_merged = "2026-06-18T09:26:44.812728000", n.ref_url = "https://attack.mitre.org/datacomponents/DC0020", n.stix_created = "2021-10-20T15:05:19.272000000+00:00", n.stix_id = "x-mitre-data-component--d5fca4e4-e47a-487b-873f-3d22f8865e96", n.stix_modified = "2025-11-12T22:03:39.105000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "x-mitre-data-component";

