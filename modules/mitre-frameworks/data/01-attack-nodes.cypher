ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[GoBear](https://attack.mitre.org/software/S1197) is a Go-based backdoor that abuses legitimate, stolen certificates for defense evasion purposes. [GoBear](https://attack.mitre.org/software/S1197) is exclusively linked to [Kimsuky](https://attack.mitre.org/groups/G0094) operations.(Citation: S2W Troll Stealer 2024)(Citation: Symantec Troll Stealer 2024)", n.name = "GoBear", n.ontolocy_created = "2026-06-18T09:26:41.307443000", n.ontolocy_merged = "2026-06-18T09:26:41.307443000", n.ref_url = "https://attack.mitre.org/software/S1197", n.stix_created = "2025-01-17T23:19:53.786000000+00:00", n.stix_id = "malware--98943603-5be6-4551-8c98-bbaf0d229d39", n.stix_modified = "2025-01-17T23:38:02.063000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

