MERGE (n:MitreAttackSoftware {attack_id: "S1155"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[Covenant](https://attack.mitre.org/software/S1155) is a multi-platform command and control framework written in .NET. While designed for penetration testing and security research, the tool has also been used by threat actors such as [HAFNIUM](https://attack.mitre.org/groups/G0125) during operations. [Covenant](https://attack.mitre.org/software/S1155) functions through a central listener managing multiple deployed \"Grunts\" that communicate back to the controller.(Citation: Github Covenant)(Citation: Microsoft HAFNIUM March 2020)", n.name = "Covenant", n.ontolocy_created = "2026-06-18T09:26:41.473893000", n.ontolocy_merged = "2026-06-18T09:26:41.473893000", n.ref_url = "https://attack.mitre.org/software/S1155", n.stix_created = "2024-09-04T17:08:08.985000000+00:00", n.stix_id = "tool--05fb53c8-e2ac-4e17-a0c9-a0825e1198bf", n.stix_modified = "2024-09-06T18:11:55.619000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "tool";

MERGE (n:MitreAttackSoftware {attack_id: "S1131"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "NPPSPY is an implementation of a theoretical mechanism first presented in 2004 for capturing credentials submitted to a Windows system via a rogue Network Provider API item. NPPSPY captures credentials following submission and writes them to a file on the victim system for follow-on exfiltration.(Citation: Huntress NPPSPY 2022)(Citation: Polak NPPSPY 2004)", n.name = "NPPSPY", n.ontolocy_created = "2026-06-18T09:26:41.474494000", n.ontolocy_merged = "2026-06-18T09:26:41.474494000", n.ref_url = "https://attack.mitre.org/software/S1131", n.stix_created = "2024-05-17T18:49:15.318000000+00:00", n.stix_id = "tool--0630d1a7-54da-4a48-a6af-eb8a62b13c17", n.stix_modified = "2024-10-28T19:00:14.732000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "tool";

