ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[Apostle](https://attack.mitre.org/software/S1133) is malware that has functioned as both a wiper and, in more recent versions, as ransomware.  [Apostle](https://attack.mitre.org/software/S1133) is written in .NET and shares various programming and functional overlaps with [IPsec Helper](https://attack.mitre.org/software/S1132).(Citation: SentinelOne Agrius 2021)", n.name = "Apostle", n.ontolocy_created = "2026-06-18T09:26:41.152170000", n.ontolocy_merged = "2026-06-18T09:26:41.152170000", n.ref_url = "https://attack.mitre.org/software/S1133", n.stix_created = "2024-05-22T19:16:58.646000000+00:00", n.stix_id = "malware--48d96fa0-d027-45aa-a8c3-5d09f65d596d", n.stix_modified = "2024-08-29T15:21:36.079000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

