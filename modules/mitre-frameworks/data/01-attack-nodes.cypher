MERGE (n:MitreAttackSoftware {attack_id: "S0348"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.2", n.description = "[Cardinal RAT](https://attack.mitre.org/software/S0348) is a potentially low volume remote access trojan (RAT) observed since December 2015. [Cardinal RAT](https://attack.mitre.org/software/S0348) is notable for its unique utilization of uncompiled C# source code and the Microsoft Windows built-in csc.exe compiler.(Citation: PaloAlto CardinalRat Apr 2017)", n.name = "Cardinal RAT", n.ontolocy_created = "2026-06-18T09:26:41.357679000", n.ontolocy_merged = "2026-06-18T09:26:41.357679000", n.ref_url = "https://attack.mitre.org/software/S0348", n.stix_created = "2019-01-30T16:39:53.573000000+00:00", n.stix_id = "malware--b879758f-bbc4-4cab-b5ba-177ac9b009b4", n.stix_modified = "2024-04-11T02:47:11.431000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

