ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[CreepyDrive](https://attack.mitre.org/software/S1023) is a custom implant has been used by [POLONIUM](https://attack.mitre.org/groups/G1005) since at least early 2022 for C2 with and exfiltration to actor-controlled OneDrive accounts.(Citation: Microsoft POLONIUM June 2022)  [POLONIUM](https://attack.mitre.org/groups/G1005) has used a similar implant called CreepyBox that relies on actor-controlled DropBox accounts.(Citation: Microsoft POLONIUM June 2022)", n.name = "CreepyDrive", n.ontolocy_created = "2026-06-18T09:26:41.245209000", n.ontolocy_merged = "2026-06-18T09:26:41.245209000", n.ref_url = "https://attack.mitre.org/software/S1023", n.stix_created = "2022-07-07T14:30:25.403000000+00:00", n.stix_id = "malware--750eb92a-7fdf-451e-9592-1d42357018f1", n.stix_modified = "2025-04-16T20:38:17.473000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

