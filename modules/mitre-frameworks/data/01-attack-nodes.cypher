SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.3", n.description = "[Pupy](https://attack.mitre.org/software/S0192) is an open source, cross-platform (Windows, Linux, OSX, Android) remote administration and post-exploitation tool. (Citation: GitHub Pupy) It is written in Python and can be generated as a payload in several different ways (Windows exe, Python file, PowerShell oneliner/file, Linux elf, APK, Rubber Ducky, etc.). (Citation: GitHub Pupy) [Pupy](https://attack.mitre.org/software/S0192) is publicly available on GitHub. (Citation: GitHub Pupy)", n.name = "Pupy", n.ontolocy_created = "2026-06-18T09:26:41.521102000", n.ontolocy_merged = "2026-06-18T09:26:41.521102000", n.ref_url = "https://attack.mitre.org/software/S0192", n.stix_created = "2018-04-18T17:59:24.739000000+00:00", n.stix_id = "tool--cb69b20d-56d0-41ab-8440-4a4b251614d4", n.stix_modified = "2023-09-28T21:08:47.128000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "tool";

