ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[LIGHTWIRE](https://attack.mitre.org/software/S1119) is a web shell written in Perl that was used during [Cutting Edge](https://attack.mitre.org/campaigns/C0029) to maintain access and enable command execution by imbedding into the legitimate compcheckresult.cgi component of Ivanti Secure Connect VPNs.(Citation: Mandiant Cutting Edge Part 2 January 2024)(Citation: Mandiant Cutting Edge January 2024)", n.name = "LIGHTWIRE", n.ontolocy_created = "2026-06-18T09:26:41.204837000", n.ontolocy_merged = "2026-06-18T09:26:41.204837000", n.ref_url = "https://attack.mitre.org/software/S1119", n.stix_created = "2024-03-07T20:52:41.463000000+00:00", n.stix_id = "malware--5dc9e8ec-9917-4de7-b8ab-16007899dd80", n.stix_modified = "2025-04-15T19:46:34.303000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0387"})
