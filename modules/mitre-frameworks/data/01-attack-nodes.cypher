MERGE (n:MitreAttackSoftware {attack_id: "S0447"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "2.0", n.description = "[Lokibot](https://attack.mitre.org/software/S0447) is a widely distributed information stealer that was first reported in 2015. It is designed to steal sensitive information such as usernames, passwords, cryptocurrency wallets, and other credentials. [Lokibot](https://attack.mitre.org/software/S0447) can also create a backdoor into infected systems to allow an attacker to install additional payloads.(Citation: Infoblox Lokibot January 2019)(Citation: Morphisec Lokibot April 2020)(Citation: CISA Lokibot September 2020)", n.name = "Lokibot", n.ontolocy_created = "2026-06-18T09:26:41.387674000", n.ontolocy_merged = "2026-06-18T09:26:41.387674000", n.ref_url = "https://attack.mitre.org/software/S0447", n.stix_created = "2020-05-14T17:31:33.707000000+00:00", n.stix_id = "malware--cb741463-f0fe-42e0-8d45-bc7e8335f5ae", n.stix_modified = "2025-04-25T14:44:41.863000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

