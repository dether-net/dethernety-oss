ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.2", n.description = "[BADNEWS](https://attack.mitre.org/software/S0128) is malware that has been used by the actors responsible for the [Patchwork](https://attack.mitre.org/groups/G0040) campaign. Its name was given due to its use of RSS feeds, forums, and blogs for command and control. (Citation: Forcepoint Monsoon) (Citation: TrendMicro Patchwork Dec 2017)", n.name = "BADNEWS", n.ontolocy_created = "2026-06-18T09:26:41.437229000", n.ontolocy_merged = "2026-06-18T09:26:41.437229000", n.ref_url = "https://attack.mitre.org/software/S0128", n.stix_created = "2017-05-31T21:33:14.118000000+00:00", n.stix_id = "malware--e9595678-d269-469e-ae6b-75e49259de63", n.stix_modified = "2025-04-25T14:44:59.677000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

