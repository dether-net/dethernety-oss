SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.2", n.description = "[Grandoreiro](https://attack.mitre.org/software/S0531) is a banking trojan written in Delphi that was first observed in 2016 and uses a Malware-as-a-Service (MaaS) business model. [Grandoreiro](https://attack.mitre.org/software/S0531) has confirmed victims in Brazil, Mexico, Portugal, and Spain.(Citation: Securelist Brazilian Banking Malware July 2020)(Citation: ESET Grandoreiro April 2020)", n.name = "Grandoreiro", n.ontolocy_created = "2026-06-18T09:26:41.300734000", n.ontolocy_merged = "2026-06-18T09:26:41.300734000", n.ref_url = "https://attack.mitre.org/software/S0531", n.stix_created = "2020-11-10T21:13:44.259000000+00:00", n.stix_id = "malware--958b5d06-8bb0-4c5b-a2e7-0130fe654ac7", n.stix_modified = "2024-04-11T02:25:51.549000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

