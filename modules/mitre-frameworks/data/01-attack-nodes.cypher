SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[WannaCry](https://attack.mitre.org/software/S0366) is ransomware that was first seen in a global attack during May 2017, which affected more than 150 countries. It contains worm-like features to spread itself across a computer network using the SMBv1 exploit EternalBlue.(Citation: LogRhythm WannaCry)(Citation: US-CERT WannaCry 2017)(Citation: Washington Post WannaCry 2017)(Citation: FireEye WannaCry 2017)", n.name = "WannaCry", n.ontolocy_created = "2026-06-18T09:26:41.248143000", n.ontolocy_merged = "2026-06-18T09:26:41.248143000", n.ref_url = "https://attack.mitre.org/software/S0366", n.stix_created = "2019-03-25T17:30:17.004000000+00:00", n.stix_id = "malware--75ecdbf1-c2bb-4afc-a3f9-c8da4de8c661", n.stix_modified = "2024-12-09T02:29:13.859000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

