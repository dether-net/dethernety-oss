MERGE (n:MitreAttackSoftware {attack_id: "S0686"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[QuietSieve](https://attack.mitre.org/software/S0686) is an information stealer that has been used by [Gamaredon Group](https://attack.mitre.org/groups/G0047) since at least 2021.(Citation: Microsoft Actinium February 2022)", n.name = "QuietSieve", n.ontolocy_created = "2026-06-18T09:26:41.026415000", n.ontolocy_merged = "2026-06-18T09:26:41.026415000", n.ref_url = "https://attack.mitre.org/software/S0686", n.stix_created = "2022-02-18T16:46:39.268000000+00:00", n.stix_id = "malware--03eb4a05-6a02-43f6-afb7-3c7835501828", n.stix_modified = "2025-04-16T20:37:52.215000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

