ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[STEADYPULSE](https://attack.mitre.org/software/S1112) is a web shell that infects targeted Pulse Secure VPN servers through modification of a legitimate Perl script that was used as early as 2020 including in activity against US Defense Industrial Base (DIB) entities.(Citation: Mandiant Pulse Secure Zero-Day April 2021)", n.name = "STEADYPULSE", n.ontolocy_created = "2026-06-18T09:26:41.385224000", n.ontolocy_merged = "2026-06-18T09:26:41.385224000", n.ref_url = "https://attack.mitre.org/software/S1112", n.stix_created = "2024-02-09T20:19:34.719000000+00:00", n.stix_id = "malware--ca0fead6-5277-427a-825b-42ff1fbe476e", n.stix_modified = "2025-04-15T19:46:35.400000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

