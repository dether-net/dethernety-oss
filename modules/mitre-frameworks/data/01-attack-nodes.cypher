SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[ObliqueRAT](https://attack.mitre.org/software/S0644) is a remote access trojan, similar to [Crimson](https://attack.mitre.org/software/S0115), that has been in use by [Transparent Tribe](https://attack.mitre.org/groups/G0134) since at least 2020.(Citation: Talos Oblique RAT March 2021)(Citation: Talos Transparent Tribe May 2021)", n.name = "ObliqueRAT", n.ontolocy_created = "2026-06-18T09:26:41.190545000", n.ontolocy_merged = "2026-06-18T09:26:41.190545000", n.ref_url = "https://attack.mitre.org/software/S0644", n.stix_created = "2021-09-08T19:53:27.937000000+00:00", n.stix_id = "malware--5864e59f-eb4c-43ad-83b2-b5e4fae056c9", n.stix_modified = "2025-04-25T14:43:25.456000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

