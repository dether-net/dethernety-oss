ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[SPACESHIP](https://attack.mitre.org/software/S0035) is malware developed by [APT30](https://attack.mitre.org/groups/G0013) that allows propagation and exfiltration of data over removable devices. [APT30](https://attack.mitre.org/groups/G0013) may use this capability to exfiltrate data across air-gaps. (Citation: FireEye APT30)", n.name = "SPACESHIP", n.ontolocy_created = "2026-06-18T09:26:41.277322000", n.ontolocy_merged = "2026-06-18T09:26:41.277322000", n.ref_url = "https://attack.mitre.org/software/S0035", n.stix_created = "2017-05-31T21:32:28.257000000+00:00", n.stix_id = "malware--8b880b41-5139-4807-baa9-309690218719", n.stix_modified = "2024-11-17T15:05:25.107000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

