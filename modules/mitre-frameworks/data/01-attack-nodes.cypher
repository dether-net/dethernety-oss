SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[Explosive](https://attack.mitre.org/software/S0569) is a custom-made remote access tool used by the group [Volatile Cedar](https://attack.mitre.org/groups/G0123). It was first identified in the wild in 2015.(Citation: CheckPoint Volatile Cedar March 2015)(Citation: ClearSky Lebanese Cedar Jan 2021)  ", n.name = "Explosive", n.ontolocy_created = "2026-06-18T09:26:41.229837000", n.ontolocy_merged = "2026-06-18T09:26:41.229837000", n.ref_url = "https://attack.mitre.org/software/S0569", n.stix_created = "2021-02-08T21:41:25.501000000+00:00", n.stix_id = "malware--6a21e3a4-5ffe-4581-af9a-6a54c7536f44", n.stix_modified = "2025-04-25T14:43:40.097000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0341"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.2", n.description = "[Xbash](https://attack.mitre.org/software/S0341) is a malware family that has targeted Linux and Microsoft Windows servers. The malware has been tied to the Iron Group, a threat actor group known for previous ransomware attacks. [Xbash](https://attack.mitre.org/software/S0341) was developed in Python and then converted into a self-contained Linux ELF executable by using PyInstaller.(Citation: Unit42 Xbash Sept 2018)", n.name = "Xbash", n.ontolocy_created = "2026-06-18T09:26:41.230439000", n.ontolocy_merged = "2026-06-18T09:26:41.230439000", n.ref_url = "https://attack.mitre.org/software/S0341", n.stix_created = "2019-01-30T13:28:47.452000000+00:00", n.stix_id = "malware--6a92d80f-cc65-45f6-aa66-3cdea6786b3c", n.stix_modified = "2025-04-25T14:43:40.462000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

