ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[EvilGrab](https://attack.mitre.org/software/S0152) is a malware family with common reconnaissance capabilities. It has been deployed by [menuPass](https://attack.mitre.org/groups/G0045) via malicious Microsoft Office documents as part of spearphishing campaigns. (Citation: PWC Cloud Hopper Technical Annex April 2017)", n.name = "EvilGrab", n.ontolocy_created = "2026-06-18T09:26:41.095674000", n.ontolocy_merged = "2026-06-18T09:26:41.095674000", n.ref_url = "https://attack.mitre.org/software/S0152", n.stix_created = "2017-12-14T16:46:06.044000000+00:00", n.stix_id = "malware--2f1a9fd0-3b7c-4d77-a358-78db13adbe78", n.stix_modified = "2025-04-16T20:38:00.969000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

