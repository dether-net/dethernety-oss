MERGE (n:MitreAttackSoftware {attack_id: "S1030"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[Squirrelwaffle](https://attack.mitre.org/software/S1030) is a loader that was first seen in September 2021. It has been used in spam email campaigns to deliver additional malware such as [Cobalt Strike](https://attack.mitre.org/software/S0154) and the [QakBot](https://attack.mitre.org/software/S0650) banking trojan.(Citation: ZScaler Squirrelwaffle Sep 2021)(Citation: Netskope Squirrelwaffle Oct 2021)", n.name = "Squirrelwaffle", n.ontolocy_created = "2026-06-18T09:26:41.123962000", n.ontolocy_merged = "2026-06-18T09:26:41.123962000", n.ref_url = "https://attack.mitre.org/software/S1030", n.stix_created = "2022-08-09T16:45:36.234000000+00:00", n.stix_id = "malware--3c18ad16-9eaf-4649-984e-68551bff0d47", n.stix_modified = "2024-04-11T00:02:15.805000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

