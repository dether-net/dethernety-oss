SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[KEYPLUG](https://attack.mitre.org/software/S1051) is a modular backdoor written in C++, with Windows and Linux variants, that has been used by [APT41](https://attack.mitre.org/groups/G0096) since at least June 2021.(Citation: Mandiant APT41)", n.name = "KEYPLUG", n.ontolocy_created = "2026-06-18T09:26:41.233495000", n.ontolocy_merged = "2026-06-18T09:26:41.233495000", n.ref_url = "https://attack.mitre.org/software/S1051", n.stix_created = "2022-12-12T15:47:08.197000000+00:00", n.stix_id = "malware--6c575670-d14c-4c7f-9b9d-fd1b363e255d", n.stix_modified = "2024-04-11T01:46:20.169000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

