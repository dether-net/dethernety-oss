ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[NetTraveler](https://attack.mitre.org/software/S0033) is malware that has been used in multiple cyber espionage campaigns for basic surveillance of victims. The earliest known samples have timestamps back to 2005, and the largest number of observed samples were created between 2010 and 2013. (Citation: Kaspersky NetTraveler)", n.name = "NetTraveler", n.ontolocy_created = "2026-06-18T09:26:41.386519000", n.ontolocy_merged = "2026-06-18T09:26:41.386519000", n.ref_url = "https://attack.mitre.org/software/S0033", n.stix_created = "2017-05-31T21:32:25.361000000+00:00", n.stix_id = "malware--cafd0bf8-2b9c-46c7-ae3c-3e0f42c5062e", n.stix_modified = "2024-11-17T18:04:41.738000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

