MERGE (n:MitreAttackSoftware {attack_id: "S1146"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[MgBot](https://attack.mitre.org/software/S1146) is a modular malware framework exclusively associated with [Daggerfly](https://attack.mitre.org/groups/G1034) operations since at least 2012. [MgBot](https://attack.mitre.org/software/S1146) was developed in C++ and features a module design with multiple available plugins that have been under active development through 2024.(Citation: Szappanos MgBot 2014)(Citation: ESET EvasivePanda 2023)(Citation: Symantec Daggerfly 2024)", n.name = "MgBot", n.ontolocy_created = "2026-06-18T09:26:41.323911000", n.ontolocy_merged = "2026-06-18T09:26:41.323911000", n.ref_url = "https://attack.mitre.org/software/S1146", n.stix_created = "2024-07-25T18:16:57.099000000+00:00", n.stix_id = "malware--a36eedea-9523-4abb-96e8-205f171ee763", n.stix_modified = "2024-10-10T14:34:23.655000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

