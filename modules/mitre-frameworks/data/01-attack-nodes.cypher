SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[CookieMiner](https://attack.mitre.org/software/S0492) is mac-based malware that targets information associated with cryptocurrency exchanges as well as enabling cryptocurrency mining on the victim system itself. It was first discovered in the wild in 2019.(Citation: Unit42 CookieMiner Jan 2019)", n.name = "CookieMiner", n.ontolocy_created = "2026-06-18T09:26:41.443029000", n.ontolocy_merged = "2026-06-18T09:26:41.443029000", n.ref_url = "https://attack.mitre.org/software/S0492", n.stix_created = "2020-07-22T19:00:00.779000000+00:00", n.stix_id = "malware--eedc01d5-95e6-4d21-bcd4-1121b1df4586", n.stix_modified = "2025-04-16T20:38:42.106000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

