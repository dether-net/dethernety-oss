SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[httpclient](https://attack.mitre.org/software/S0068) is malware used by [Putter Panda](https://attack.mitre.org/groups/G0024). It is a simple tool that provides a limited range of functionality, suggesting it is likely used as a second-stage or supplementary/backup tool. (Citation: CrowdStrike Putter Panda)", n.name = "httpclient", n.ontolocy_created = "2026-06-18T09:26:41.434306000", n.ontolocy_merged = "2026-06-18T09:26:41.434306000", n.ref_url = "https://attack.mitre.org/software/S0068", n.stix_created = "2017-05-31T21:32:45.315000000+00:00", n.stix_id = "malware--e8268361-a599-4e45-bd3f-71c8c7e700c0", n.stix_modified = "2025-04-25T14:44:58.407000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

