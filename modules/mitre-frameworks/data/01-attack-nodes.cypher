SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[IMAPLoader](https://attack.mitre.org/software/S1152) is a .NET-based loader malware exclusively associated with [CURIUM](https://attack.mitre.org/groups/G1012) operations since at least 2022. [IMAPLoader](https://attack.mitre.org/software/S1152) leverages email protocols for command and control and payload delivery.(Citation: PWC Yellow Liderc 2023)", n.name = "IMAPLoader", n.ontolocy_created = "2026-06-18T09:26:41.098158000", n.ontolocy_merged = "2026-06-18T09:26:41.098158000", n.ref_url = "https://attack.mitre.org/software/S1152", n.stix_created = "2024-08-14T22:12:17.650000000+00:00", n.stix_id = "malware--3058b264-fe6b-46be-8948-2d1fadaf8adf", n.stix_modified = "2024-10-02T12:20:43.866000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

