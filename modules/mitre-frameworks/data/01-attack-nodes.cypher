ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.3.0", n.attack_version = "2.0", n.description = "Removal of a virtual machine (VM) or compute instance within a cloud infrastructure. This activity results in the termination and deletion of the allocated resources (e.g., CPU, memory, storage), making the instance unavailable for future use. Examples:  - AWS: instance deletion involves the `TerminateInstances` API call, which is recorded in CloudTrail logs. - Azure: VM deletion can be monitored via Azure Activity Logs, showing the `Microsoft.Compute/virtualMachines/delete` operation. - GCP: instance deletion is logged as an instance.delete operation within GCP Audit Logs.", n.name = "Instance Deletion", n.ontolocy_created = "2026-06-18T09:26:44.787241000", n.ontolocy_merged = "2026-06-18T09:26:44.787241000", n.ref_url = "https://attack.mitre.org/datacomponents/DC0081", n.stix_created = "2021-10-20T15:05:19.274000000+00:00", n.stix_id = "x-mitre-data-component--7561ed50-16cb-4826-82c7-c1ddca61785e", n.stix_modified = "2025-11-12T22:03:39.105000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "x-mitre-data-component";

