SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.3", n.description = "[Volgmer](https://attack.mitre.org/software/S0180) is a backdoor Trojan designed to provide covert access to a compromised system. It has been used since at least 2013 to target the government, financial, automotive, and media industries. Its primary delivery mechanism is suspected to be spearphishing. (Citation: US-CERT Volgmer Nov 2017)", n.name = "Volgmer", n.ontolocy_created = "2026-06-18T09:26:41.152736000", n.ontolocy_merged = "2026-06-18T09:26:41.152736000", n.ref_url = "https://attack.mitre.org/software/S0180", n.stix_created = "2018-01-16T16:13:52.465000000+00:00", n.stix_id = "malware--495b6cdb-7b5a-4fbc-8d33-e7ef68806d08", n.stix_modified = "2024-04-10T22:16:05.440000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

