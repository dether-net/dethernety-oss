ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.2", n.description = "[Seasalt](https://attack.mitre.org/software/S0345) is malware that has been linked to [APT1](https://attack.mitre.org/groups/G0006)'s 2010 operations. It shares some code similarities with [OceanSalt](https://attack.mitre.org/software/S0346).(Citation: Mandiant APT1 Appendix)(Citation: McAfee Oceansalt Oct 2018)", n.name = "Seasalt", n.ontolocy_created = "2026-06-18T09:26:41.350929000", n.ontolocy_merged = "2026-06-18T09:26:41.350929000", n.ref_url = "https://attack.mitre.org/software/S0345", n.stix_created = "2019-01-30T15:27:06.404000000+00:00", n.stix_id = "malware--b45747dc-87ca-4597-a245-7e16a61bc491", n.stix_modified = "2024-04-11T00:08:51.818000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0637"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[NativeZone](https://attack.mitre.org/software/S0637) is the name given collectively to disposable custom [Cobalt Strike](https://attack.mitre.org/software/S0154) loaders used by [APT29](https://attack.mitre.org/groups/G0016) since at least 2021.(Citation: MSTIC Nobelium Toolset May 2021)(Citation: SentinelOne NobleBaron June 2021)", n.name = "NativeZone", n.ontolocy_created = "2026-06-18T09:26:41.351620000", n.ontolocy_merged = "2026-06-18T09:26:41.351620000", n.ref_url = "https://attack.mitre.org/software/S0637", n.stix_created = "2021-08-04T19:36:55.518000000+00:00", n.stix_id = "malware--b4783be3-35d9-4a56-ac8d-1f3e1c9d9a84", n.stix_modified = "2025-04-25T14:44:28.081000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0336"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[NanoCore](https://attack.mitre.org/software/S0336) is a modular remote access tool developed in .NET that can be used to spy on victims and steal information. It has been used by threat actors since 2013.(Citation: DigiTrust NanoCore Jan 2017)(Citation: Cofense NanoCore Mar 2018)(Citation: PaloAlto NanoCore Feb 2016)(Citation: Unit 42 Gorgon Group Aug 2018)", n.name = "NanoCore", n.ontolocy_created = "2026-06-18T09:26:41.352209000", n.ontolocy_merged = "2026-06-18T09:26:41.352209000", n.ref_url = "https://attack.mitre.org/software/S0336", n.stix_created = "2019-01-29T20:05:35.952000000+00:00", n.stix_id = "malware--b4d80f8b-d2b9-4448-8844-4bef777ed676", n.stix_modified = "2024-09-25T15:05:04.341000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0467"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[TajMahal](https://attack.mitre.org/software/S0467) is a multifunctional spying framework that has been in use since at least 2014. [TajMahal](https://attack.mitre.org/software/S0467) is comprised of two separate packages, named Tokyo and Yokohama, and can deploy up to 80 plugins.(Citation: Kaspersky TajMahal April 2019)", n.name = "TajMahal", n.ontolocy_created = "2026-06-18T09:26:41.352787000", n.ontolocy_merged = "2026-06-18T09:26:41.352787000", n.ref_url = "https://attack.mitre.org/software/S0467", n.stix_created = "2020-06-08T14:57:32.842000000+00:00", n.stix_id = "malware--b51797f7-57da-4210-b8ac-b8632ee75d70", n.stix_modified = "2025-04-25T14:44:28.616000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0435"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "2.0", n.description = "[PLEAD](https://attack.mitre.org/software/S0435) is a remote access tool (RAT) and downloader used by [BlackTech](https://attack.mitre.org/groups/G0098) in targeted attacks in East Asia including Taiwan, Japan, and Hong Kong.(Citation: TrendMicro BlackTech June 2017)(Citation: JPCert PLEAD Downloader June 2018) [PLEAD](https://attack.mitre.org/software/S0435) has also been referred to as [TSCookie](https://attack.mitre.org/software/S0436), though more recent reporting indicates likely separation between the two. [PLEAD](https://attack.mitre.org/software/S0435) was observed in use as early as March 2017.(Citation: JPCert TSCookie March 2018)(Citation: JPCert PLEAD Downloader June 2018)", n.name = "PLEAD", n.ontolocy_created = "2026-06-18T09:26:41.353365000", n.ontolocy_merged = "2026-06-18T09:26:41.353365000", n.ref_url = "https://attack.mitre.org/software/S0435", n.stix_created = "2020-05-06T12:55:10.969000000+00:00", n.stix_id = "malware--b57f419e-8b12-49d3-886b-145383725dcd", n.stix_modified = "2025-04-25T19:04:32.446000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S1148"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.3.0", n.attack_version = "1.1", n.description = "[Raccoon Stealer](https://attack.mitre.org/software/S1148) is an information stealer malware family active since at least 2019 as a malware-as-a-service offering sold in underground forums. [Raccoon Stealer](https://attack.mitre.org/software/S1148) has experienced two periods of activity across two variants, from 2019 to March 2022, then resurfacing in a revised version in June 2022.(Citation: S2W Racoon 2022)(Citation: Sekoia Raccoon1 2022)", n.name = "Raccoon Stealer", n.ontolocy_created = "2026-06-18T09:26:41.354119000", n.ontolocy_merged = "2026-06-18T09:26:41.354119000", n.ref_url = "https://attack.mitre.org/software/S1148", n.stix_created = "2024-08-01T21:53:48.812000000+00:00", n.stix_id = "malware--b5a8fb8b-4ff1-43e5-a1ad-75ae565f5175", n.stix_modified = "2025-10-14T21:40:02.258000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S1132"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[IPsec Helper](https://attack.mitre.org/software/S1132) is a post-exploitation remote access tool linked to [Agrius](https://attack.mitre.org/groups/G1030) operations. This malware shares significant programming and functional overlaps with [Apostle](https://attack.mitre.org/software/S1133) ransomware, also linked to [Agrius](https://attack.mitre.org/groups/G1030). [IPsec Helper](https://attack.mitre.org/software/S1132) provides basic remote access tool functionality such as uploading files from victim systems, running commands, and deploying additional payloads.(Citation: SentinelOne Agrius 2021)", n.name = "IPsec Helper", n.ontolocy_created = "2026-06-18T09:26:41.354722000", n.ontolocy_merged = "2026-06-18T09:26:41.354722000", n.ref_url = "https://attack.mitre.org/software/S1132", n.stix_created = "2024-05-22T19:13:15.858000000+00:00", n.stix_id = "malware--b5dc19b7-588d-403b-848d-c868bd61ffa1", n.stix_modified = "2024-08-29T15:20:43.368000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0187"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[Daserf](https://attack.mitre.org/software/S0187) is a backdoor that has been used to spy on and steal from Japanese, South Korean, Russian, Singaporean, and Chinese victims. Researchers have identified versions written in both Visual C and Delphi. (Citation: Trend Micro Daserf Nov 2017) (Citation: Secureworks BRONZE BUTLER Oct 2017)", n.name = "Daserf", n.ontolocy_created = "2026-06-18T09:26:41.355303000", n.ontolocy_merged = "2026-06-18T09:26:41.355303000", n.ref_url = "https://attack.mitre.org/software/S0187", n.stix_created = "2018-01-16T16:13:52.465000000+00:00", n.stix_id = "malware--b6b3dfc7-9a81-43ff-ac04-698bad48973a", n.stix_modified = "2025-04-25T14:44:29.509000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0597"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[GoldFinder](https://attack.mitre.org/software/S0597) is a custom HTTP tracer tool written in Go that logs the route a packet takes between a compromised network and a C2 server. It can be used to inform  threat actors of potential points of discovery or logging of their actions, including C2 related to other malware. [GoldFinder](https://attack.mitre.org/software/S0597) was discovered in early 2021 during an investigation into the [SolarWinds Compromise](https://attack.mitre.org/campaigns/C0024) by [APT29](https://attack.mitre.org/groups/G0016).(Citation: MSTIC NOBELIUM Mar 2021)", n.name = "GoldFinder", n.ontolocy_created = "2026-06-18T09:26:41.355890000", n.ontolocy_merged = "2026-06-18T09:26:41.355890000", n.ref_url = "https://attack.mitre.org/software/S0597", n.stix_created = "2021-03-26T16:48:31.793000000+00:00", n.stix_id = "malware--b7010785-699f-412f-ba49-524da6033c76", n.stix_modified = "2025-04-16T20:38:31.830000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0335"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.2", n.description = "[Carbon](https://attack.mitre.org/software/S0335) is a sophisticated, second-stage backdoor and framework that can be used to steal sensitive information from victims. [Carbon](https://attack.mitre.org/software/S0335) has been selectively used by [Turla](https://attack.mitre.org/groups/G0010) to target government and foreign affairs-related organizations in Central Asia.(Citation: ESET Carbon Mar 2017)(Citation: Securelist Turla Oct 2018)", n.name = "Carbon", n.ontolocy_created = "2026-06-18T09:26:41.356470000", n.ontolocy_merged = "2026-06-18T09:26:41.356470000", n.ref_url = "https://attack.mitre.org/software/S0335", n.stix_created = "2019-01-29T19:36:02.103000000+00:00", n.stix_id = "malware--b7e9880a-7a7c-4162-bddb-e28e8ef2bf1f", n.stix_modified = "2025-04-25T14:44:30.048000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

