ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[QUIETEXIT](https://attack.mitre.org/software/S1084) is a novel backdoor, based on the open-source Dropbear SSH client-server software, that has been used by [APT29](https://attack.mitre.org/groups/G0016) since at least 2021. [APT29](https://attack.mitre.org/groups/G0016) has deployed [QUIETEXIT](https://attack.mitre.org/software/S1084) on opaque network appliances that typically don't support antivirus or endpoint detection and response tools within a victim environment.(Citation: Mandiant APT29 Eye Spy Email Nov 22)", n.name = "QUIETEXIT", n.ontolocy_created = "2026-06-18T09:26:41.151021000", n.ontolocy_merged = "2026-06-18T09:26:41.151021000", n.ref_url = "https://attack.mitre.org/software/S1084", n.stix_created = "2023-08-17T17:06:19.976000000+00:00", n.stix_id = "malware--4816d361-f82b-4a18-aa05-b215e7cf9200", n.stix_modified = "2025-04-15T19:46:34.040000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

