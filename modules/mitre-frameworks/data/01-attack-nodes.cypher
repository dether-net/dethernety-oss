ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[ISMInjector](https://attack.mitre.org/software/S0189) is a Trojan used to install another [OilRig](https://attack.mitre.org/groups/G0049) backdoor, ISMAgent. (Citation: OilRig New Delivery Oct 2017)", n.name = "ISMInjector", n.ontolocy_created = "2026-06-18T09:26:41.200624000", n.ontolocy_merged = "2026-06-18T09:26:41.200624000", n.ref_url = "https://attack.mitre.org/software/S0189", n.stix_created = "2018-01-16T16:13:52.465000000+00:00", n.stix_id = "malware--5be33fef-39c0-4532-84ee-bea31e1b5324", n.stix_modified = "2025-04-25T14:43:29.589000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0196"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "2.1", n.description = "[PUNCHBUGGY](https://attack.mitre.org/software/S0196) is a backdoor malware used by [FIN8](https://attack.mitre.org/groups/G0061) that has been observed targeting POS networks in the hospitality industry. (Citation: Morphisec ShellTea June 2019)(Citation: FireEye Fin8 May 2016) (Citation: FireEye Know Your Enemy FIN8 Aug 2016)", n.name = "PUNCHBUGGY", n.ontolocy_created = "2026-06-18T09:26:41.201199000", n.ontolocy_merged = "2026-06-18T09:26:41.201199000", n.ref_url = "https://attack.mitre.org/software/S0196", n.stix_created = "2018-04-18T17:59:24.739000000+00:00", n.stix_id = "malware--5c6ed2dc-37f4-40ea-b2e1-4c76140a388c", n.stix_modified = "2025-04-16T20:38:11.382000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0588"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "2.3", n.description = "[GoldMax](https://attack.mitre.org/software/S0588) is a second-stage C2 backdoor written in Go with Windows and Linux variants that are nearly identical in functionality. [GoldMax](https://attack.mitre.org/software/S0588) was discovered in early 2021 during the investigation into the [SolarWinds Compromise](https://attack.mitre.org/campaigns/C0024), and has likely been used by [APT29](https://attack.mitre.org/groups/G0016) since at least mid-2019. [GoldMax](https://attack.mitre.org/software/S0588) uses multiple defense evasion techniques, including avoiding virtualization execution and masking malicious traffic.(Citation: MSTIC NOBELIUM Mar 2021)(Citation: FireEye SUNSHUTTLE Mar 2021)(Citation: CrowdStrike StellarParticle January 2022)", n.name = "GoldMax", n.ontolocy_created = "2026-06-18T09:26:41.201762000", n.ontolocy_merged = "2026-06-18T09:26:41.201762000", n.ref_url = "https://attack.mitre.org/software/S0588", n.stix_created = "2021-03-12T16:10:45.416000000+00:00", n.stix_id = "malware--5c747acd-47f0-4c5a-b9e5-213541fc01e0", n.stix_modified = "2024-04-11T02:26:45.606000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0617"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[HELLOKITTY](https://attack.mitre.org/software/S0617) is a ransomware written in C++  that shares similar code structure and functionality with [DEATHRANSOM](https://attack.mitre.org/software/S0616) and [FIVEHANDS](https://attack.mitre.org/software/S0618). [HELLOKITTY](https://attack.mitre.org/software/S0617) has been used since at least 2020, targets have included a Polish video game developer and a Brazilian electric power company.(Citation: FireEye FiveHands April 2021)", n.name = "HELLOKITTY", n.ontolocy_created = "2026-06-18T09:26:41.202511000", n.ontolocy_merged = "2026-06-18T09:26:41.202511000", n.ref_url = "https://attack.mitre.org/software/S0617", n.stix_created = "2021-06-03T20:07:21.788000000+00:00", n.stix_id = "malware--5d11d418-95dd-4377-b782-23160dfa17b4", n.stix_modified = "2025-04-25T14:43:30.306000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

