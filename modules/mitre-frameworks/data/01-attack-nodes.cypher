SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.2", n.description = "[CALENDAR](https://attack.mitre.org/software/S0025) is malware used by [APT1](https://attack.mitre.org/groups/G0006) that mimics legitimate Gmail Calendar traffic. (Citation: Mandiant APT1)", n.name = "CALENDAR", n.ontolocy_created = "2026-06-18T09:26:41.198327000", n.ontolocy_merged = "2026-06-18T09:26:41.198327000", n.ref_url = "https://attack.mitre.org/software/S0025", n.stix_created = "2017-05-31T21:32:20.137000000+00:00", n.stix_id = "malware--5a84dc36-df0d-4053-9b7c-f0c388a57283", n.stix_modified = "2025-04-25T14:43:28.496000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0372"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "2.0", n.description = "[LockerGoga](https://attack.mitre.org/software/S0372) is ransomware that was first reported in January 2019, and has been tied to various attacks on European companies, including industrial and manufacturing firms.(Citation: Unit42 LockerGoga 2019)(Citation: CarbonBlack LockerGoga 2019)", n.name = "LockerGoga", n.ontolocy_created = "2026-06-18T09:26:41.198901000", n.ontolocy_merged = "2026-06-18T09:26:41.198901000", n.ref_url = "https://attack.mitre.org/software/S0372", n.stix_created = "2019-04-16T19:00:49.435000000+00:00", n.stix_id = "malware--5af7a825-2d9f-400d-931a-e00eb9e27f48", n.stix_modified = "2023-10-17T20:05:34.648000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S1185"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "First observed in 2018, LightSpy is a modular malware family that initially targeted iOS devices in Southern Asia before expanding to Android and macOS platforms. It consists of a downloader, a main executable that manages network communications, and functionality-specific modules, typically implemented as `.dylib` files (iOS, macOS) or `.apk` files (Android). LightSpy can collect VoIP call recordings, SMS messages, and credential stores, which are then exfiltrated to a command and control (C2) server.(Citation: MelikovBlackBerry LightSpy 2024) ", n.name = "LightSpy", n.ontolocy_created = "2026-06-18T09:26:41.199471000", n.ontolocy_merged = "2026-06-18T09:26:41.199471000", n.ref_url = "https://attack.mitre.org/software/S1185", n.stix_created = "2025-01-03T20:41:46.276000000+00:00", n.stix_id = "malware--5b5d1e6c-e7de-4b46-ab8f-8556e8745927", n.stix_modified = "2025-04-15T18:40:23.781000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0220"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[Chaos](https://attack.mitre.org/software/S0220) is Linux malware that compromises systems by brute force attacks against SSH services. Once installed, it provides a reverse shell to its controllers, triggered by unsolicited packets. (Citation: Chaos Stolen Backdoor)", n.name = "Chaos", n.ontolocy_created = "2026-06-18T09:26:41.200057000", n.ontolocy_merged = "2026-06-18T09:26:41.200057000", n.ref_url = "https://attack.mitre.org/software/S0220", n.stix_created = "2018-04-18T17:59:24.739000000+00:00", n.stix_id = "malware--5bcd5511-6756-4824-a692-e8bb109364af", n.stix_modified = "2025-04-25T14:43:29.227000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

