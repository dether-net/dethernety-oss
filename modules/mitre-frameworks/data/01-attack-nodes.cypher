MERGE (n:MitreAttackSoftware {attack_id: "S0449"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.2", n.description = "[Maze](https://attack.mitre.org/software/S0449) ransomware, previously known as \"ChaCha\", was discovered in May 2019. In addition to encrypting files on victim machines for impact, [Maze](https://attack.mitre.org/software/S0449) operators conduct information stealing campaigns prior to encryption and post the information online to extort affected companies.(Citation: FireEye Maze May 2020)(Citation: McAfee Maze March 2020)(Citation: Sophos Maze VM September 2020)", n.name = "Maze", n.ontolocy_created = "2026-06-18T09:26:41.408921000", n.ontolocy_merged = "2026-06-18T09:26:41.408921000", n.ref_url = "https://attack.mitre.org/software/S0449", n.stix_created = "2020-05-18T16:17:59.464000000+00:00", n.stix_id = "malware--d9f7383c-95ec-4080-bbce-121c9384457b", n.stix_modified = "2025-04-25T14:44:49.604000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0114"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[BOOTRASH](https://attack.mitre.org/software/S0114) is a [Bootkit](https://attack.mitre.org/techniques/T1542/003) that targets Windows operating systems. It has been used by threat actors that target the financial sector.(Citation: Mandiant M Trends 2016)(Citation: FireEye Bootkits)(Citation: FireEye BOOTRASH SANS)", n.name = "BOOTRASH", n.ontolocy_created = "2026-06-18T09:26:41.409919000", n.ontolocy_merged = "2026-06-18T09:26:41.409919000", n.ref_url = "https://attack.mitre.org/software/S0114", n.stix_created = "2017-05-31T21:33:08.292000000+00:00", n.stix_id = "malware--da2ef4a9-7cbe-400a-a379-e2f230f28db3", n.stix_modified = "2024-11-17T16:24:43.289000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S1230"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.3.0", n.attack_version = "1.0", n.description = "[HIUPAN](https://attack.mitre.org/software/S1230) (aka U2DiskWatch) is a is a worm that propagates through removable drives known to be leveraged by [Mustang Panda](https://attack.mitre.org/groups/G0129) and was first observed utilized in 2024. (Citation: 2025_IBM_PUBLOAD_TONESHELL_HIUPAN_CLAIMLOADER_MUSTANG PANDA)(Citation: Trend Micro MUSTANG PANDA PUBLOAD HIUPAN SEPTEMBER 2024)", n.name = "HIUPAN", n.ontolocy_created = "2026-06-18T09:26:41.410772000", n.ontolocy_merged = "2026-06-18T09:26:41.410772000", n.ref_url = "https://attack.mitre.org/software/S1230", n.stix_created = "2025-08-06T18:10:57.601000000+00:00", n.stix_id = "malware--da43312a-0188-4949-bab3-0df9a5df0aba", n.stix_modified = "2025-10-21T16:52:13.214000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0126"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.4", n.description = "[ComRAT](https://attack.mitre.org/software/S0126) is a second stage implant suspected of being a descendant of [Agent.btz](https://attack.mitre.org/software/S0092) and used by [Turla](https://attack.mitre.org/groups/G0010). The first version of [ComRAT](https://attack.mitre.org/software/S0126) was identified in 2007, but the tool has undergone substantial development for many years since.(Citation: Symantec Waterbug)(Citation: NorthSec 2015 GData Uroburos Tools)(Citation: ESET ComRAT May 2020)", n.name = "ComRAT", n.ontolocy_created = "2026-06-18T09:26:41.411382000", n.ontolocy_merged = "2026-06-18T09:26:41.411382000", n.ref_url = "https://attack.mitre.org/software/S0126", n.stix_created = "2017-05-31T21:33:13.252000000+00:00", n.stix_id = "malware--da5880b4-f7da-4869-85f2-e0aba84b8565", n.stix_modified = "2025-04-16T20:38:37.924000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0199"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[TURNEDUP](https://attack.mitre.org/software/S0199) is a non-public backdoor. It has been dropped by [APT33](https://attack.mitre.org/groups/G0064)'s [StoneDrill](https://attack.mitre.org/software/S0380) malware. (Citation: FireEye APT33 Sept 2017) (Citation: FireEye APT33 Webinar Sept 2017)", n.name = "TURNEDUP", n.ontolocy_created = "2026-06-18T09:26:41.411983000", n.ontolocy_merged = "2026-06-18T09:26:41.411983000", n.ref_url = "https://attack.mitre.org/software/S0199", n.stix_created = "2018-04-18T17:59:24.739000000+00:00", n.stix_id = "malware--db1355a7-e5c9-4e2c-8da7-eccf2ae9bf5c", n.stix_modified = "2025-04-25T14:44:50.321000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0144"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[ChChes](https://attack.mitre.org/software/S0144) is a Trojan that appears to be used exclusively by [menuPass](https://attack.mitre.org/groups/G0045). It was used to target Japanese organizations in 2016. Its lack of persistence methods suggests it may be intended as a first-stage tool. (Citation: Palo Alto menuPass Feb 2017) (Citation: JPCERT ChChes Feb 2017) (Citation: PWC Cloud Hopper Technical Annex April 2017)", n.name = "ChChes", n.ontolocy_created = "2026-06-18T09:26:41.412575000", n.ontolocy_merged = "2026-06-18T09:26:41.412575000", n.ref_url = "https://attack.mitre.org/software/S0144", n.stix_created = "2017-05-31T21:33:22.451000000+00:00", n.stix_id = "malware--dc5d1a33-62aa-4a0c-aa8c-589b87beb11e", n.stix_modified = "2024-11-17T16:46:57.582000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0393"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[PowerStallion](https://attack.mitre.org/software/S0393) is a lightweight [PowerShell](https://attack.mitre.org/techniques/T1059/001) backdoor used by [Turla](https://attack.mitre.org/groups/G0010), possibly as a recovery access tool to install other backdoors.(Citation: ESET Turla PowerShell May 2019)", n.name = "PowerStallion", n.ontolocy_created = "2026-06-18T09:26:41.413156000", n.ontolocy_merged = "2026-06-18T09:26:41.413156000", n.ref_url = "https://attack.mitre.org/software/S0393", n.stix_created = "2019-06-21T17:23:27.855000000+00:00", n.stix_id = "malware--dcac85c1-6485-4790-84f6-de5e6f6b91dd", n.stix_modified = "2025-04-25T14:44:50.859000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S1074"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[ANDROMEDA](https://attack.mitre.org/software/S1074) is commodity malware that was widespread in the early 2010's and continues to be observed in infections across a wide variety of industries. During the 2022 [C0026](https://attack.mitre.org/campaigns/C0026) campaign, threat actors re-registered expired [ANDROMEDA](https://attack.mitre.org/software/S1074) C2 domains to spread malware to select targets in Ukraine.(Citation: Mandiant Suspected Turla Campaign February 2023)", n.name = "ANDROMEDA", n.ontolocy_created = "2026-06-18T09:26:41.413733000", n.ontolocy_merged = "2026-06-18T09:26:41.413733000", n.ref_url = "https://attack.mitre.org/software/S1074", n.stix_created = "2023-05-16T19:24:37.394000000+00:00", n.stix_id = "malware--dcd9548e-df9e-47c2-81f3-bc084289959d", n.stix_modified = "2023-09-29T18:11:31.659000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S1156"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[Manjusaka](https://attack.mitre.org/software/S1156) is a Chinese-language intrusion framework, similar to [Sliver](https://attack.mitre.org/software/S0633) and [Cobalt Strike](https://attack.mitre.org/software/S0154), with an ELF binary written in GoLang as the controller for Windows and Linux implants written in Rust. First identified in 2022, [Manjusaka](https://attack.mitre.org/software/S1156) consists of multiple components, only one of which (a command and control module) is freely available.(Citation: Talos Manjusaka 2022)", n.name = "Manjusaka", n.ontolocy_created = "2026-06-18T09:26:41.414305000", n.ontolocy_merged = "2026-06-18T09:26:41.414305000", n.ref_url = "https://attack.mitre.org/software/S1156", n.stix_created = "2024-09-04T18:15:43.225000000+00:00", n.stix_id = "malware--dd2ad3d7-d7ef-4af5-a919-bfe8f2571705", n.stix_modified = "2024-09-06T18:11:40.228000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S1022"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[IceApple](https://attack.mitre.org/software/S1022) is a modular Internet Information Services (IIS) post-exploitation framework, that has been used since at least 2021 against the technology, academic, and government sectors.(Citation: CrowdStrike IceApple May 2022)", n.name = "IceApple", n.ontolocy_created = "2026-06-18T09:26:41.414888000", n.ontolocy_merged = "2026-06-18T09:26:41.414888000", n.ref_url = "https://attack.mitre.org/software/S1022", n.stix_created = "2022-06-27T15:22:22.979000000+00:00", n.stix_id = "malware--dd889a55-fb2c-4ec7-8e9f-c399939a49e1", n.stix_modified = "2025-04-16T20:38:38.400000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0201"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[JPIN](https://attack.mitre.org/software/S0201) is a custom-built backdoor family used by [PLATINUM](https://attack.mitre.org/groups/G0068). Evidence suggests developers of [JPIN](https://attack.mitre.org/software/S0201) and [Dipsind](https://attack.mitre.org/software/S0200) code bases were related in some way. (Citation: Microsoft PLATINUM April 2016)", n.name = "JPIN", n.ontolocy_created = "2026-06-18T09:26:41.415486000", n.ontolocy_merged = "2026-06-18T09:26:41.415486000", n.ref_url = "https://attack.mitre.org/software/S0201", n.stix_created = "2018-04-18T17:59:24.739000000+00:00", n.stix_id = "malware--de6cb631-52f6-4169-a73b-7965390b0c30", n.stix_modified = "2025-04-25T14:44:51.758000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S1217"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[VIRTUALPITA](https://attack.mitre.org/software/S1217) is a passive backdoor with ESXi and Linux vCenter variants capable of command execution, file transfer, and starting and stopping processes. [VIRTUALPITA](https://attack.mitre.org/software/S1217) has been in use since at least 2022 including by [UNC3886](https://attack.mitre.org/groups/G1048) who leveraged malicious vSphere Installation Bundles (VIBs) for install on ESXi hypervisors.(Citation: Google Cloud Threat Intelligence ESXi VIBs 2022)", n.name = "VIRTUALPITA", n.ontolocy_created = "2026-06-18T09:26:41.416069000", n.ontolocy_merged = "2026-06-18T09:26:41.416069000", n.ref_url = "https://attack.mitre.org/software/S1217", n.stix_created = "2025-06-02T18:53:39.966000000+00:00", n.stix_id = "malware--df0b59fe-0193-49ea-84e1-9207139c716c", n.stix_modified = "2025-06-03T18:53:01.340000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S1059"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[metaMain](https://attack.mitre.org/software/S1059) is a backdoor used by [Metador](https://attack.mitre.org/groups/G1013) to maintain long-term access to compromised machines; it has also been used to decrypt [Mafalda](https://attack.mitre.org/software/S1060) into memory.(Citation: SentinelLabs Metador Sept 2022)(Citation: SentinelLabs Metador Technical Appendix Sept 2022)", n.name = "metaMain", n.ontolocy_created = "2026-06-18T09:26:41.416665000", n.ontolocy_merged = "2026-06-18T09:26:41.416665000", n.ref_url = "https://attack.mitre.org/software/S1059", n.stix_created = "2023-01-24T00:12:34.751000000+00:00", n.stix_id = "malware--df350889-4de9-44e5-8cb3-888b8343e97c", n.stix_modified = "2024-04-11T00:45:31.029000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

