ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.3.0", n.attack_version = "1.0", n.description = "[StarProxy](https://attack.mitre.org/software/S1227) is custom malware used by [Mustang Panda](https://attack.mitre.org/groups/G0129) as a post-compromise tool, to enable proxying of traffic between the infected machine and other machines on the same network. (Citation: Zscaler)", n.name = "StarProxy", n.ontolocy_created = "2026-06-18T09:26:41.436045000", n.ontolocy_merged = "2026-06-18T09:26:41.436045000", n.ref_url = "https://attack.mitre.org/software/S1227", n.stix_created = "2025-07-21T20:08:20.983000000+00:00", n.stix_id = "malware--e91d3543-ca5d-474b-8b20-5a753ebc6e49", n.stix_modified = "2025-10-21T22:47:13.304000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0593"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[ECCENTRICBANDWAGON](https://attack.mitre.org/software/S0593) is a remote access Trojan (RAT) used by North Korean cyber actors that was first identified in August 2020. It is a reconnaissance tool--with keylogging and screen capture functionality--used for information gathering on compromised systems.(Citation: CISA EB Aug 2020)", n.name = "ECCENTRICBANDWAGON", n.ontolocy_created = "2026-06-18T09:26:41.436638000", n.ontolocy_merged = "2026-06-18T09:26:41.436638000", n.ref_url = "https://attack.mitre.org/software/S0593", n.stix_created = "2021-03-18T16:15:53.977000000+00:00", n.stix_id = "malware--e928333f-f3df-4039-9b8b-556c2add0e42", n.stix_modified = "2025-04-25T14:44:59.309000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

