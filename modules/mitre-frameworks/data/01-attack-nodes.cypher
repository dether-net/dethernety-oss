MERGE (n:MitreAttackSoftware {attack_id: "S0178"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[Truvasys](https://attack.mitre.org/software/S0178) is first-stage malware that has been used by [PROMETHIUM](https://attack.mitre.org/groups/G0056). It is a collection of modules written in the Delphi programming language. (Citation: Microsoft Win Defender Truvasys Sep 2017) (Citation: Microsoft NEODYMIUM Dec 2016) (Citation: Microsoft SIR Vol 21)", n.name = "Truvasys", n.ontolocy_created = "2026-06-18T09:26:41.227213000", n.ontolocy_merged = "2026-06-18T09:26:41.227213000", n.ref_url = "https://attack.mitre.org/software/S0178", n.stix_created = "2018-01-16T16:13:52.465000000+00:00", n.stix_id = "malware--691c60e2-273d-4d56-9ce6-b67e0f8719ad", n.stix_modified = "2025-04-25T14:43:39.011000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

