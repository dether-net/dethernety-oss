SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "2.0", n.description = "[Dok](https://attack.mitre.org/software/S0281) is a Trojan application disguised as a .zip file that is able to collect user credentials and install a malicious proxy server to redirect a user's network traffic (i.e. [Adversary-in-the-Middle](https://attack.mitre.org/techniques/T1557)).(Citation: objsee mac malware 2017)(Citation: hexed osx.dok analysis 2019)(Citation: CheckPoint Dok)", n.name = "Dok", n.ontolocy_created = "2026-06-18T09:26:41.451487000", n.ontolocy_merged = "2026-06-18T09:26:41.451487000", n.ref_url = "https://attack.mitre.org/software/S0281", n.stix_created = "2018-10-17T00:14:20.652000000+00:00", n.stix_id = "malware--f36b2598-515f-4345-84e5-5ccde253edbe", n.stix_modified = "2024-11-17T17:15:10.558000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

