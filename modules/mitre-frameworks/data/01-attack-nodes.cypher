ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[DarkTortilla](https://attack.mitre.org/software/S1066) is a highly configurable .NET-based crypter that has been possibly active since at least August 2015. [DarkTortilla](https://attack.mitre.org/software/S1066) has been used to deliver popular information stealers, RATs, and payloads such as [Agent Tesla](https://attack.mitre.org/software/S0331), AsyncRat, [NanoCore](https://attack.mitre.org/software/S0336), RedLine, [Cobalt Strike](https://attack.mitre.org/software/S0154), and Metasploit.(Citation: Secureworks DarkTortilla Aug 2022)", n.name = "DarkTortilla", n.ontolocy_created = "2026-06-18T09:26:41.210584000", n.ontolocy_merged = "2026-06-18T09:26:41.210584000", n.ref_url = "https://attack.mitre.org/software/S1066", n.stix_created = "2023-02-16T13:57:53.205000000+00:00", n.stix_id = "malware--5faaf81a-aa5b-4a4b-bae5-522439e068f8", n.stix_modified = "2025-04-16T20:38:12.375000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S1246"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.3.0", n.attack_version = "1.0", n.description = "[BeaverTail](https://attack.mitre.org/software/S1246) is a malware that has both a JavaScript and C++ variant.  Active since 2022, [BeaverTail](https://attack.mitre.org/software/S1246) is capable of stealing logins from browsers and serves as a downloader for second stage payloads. [BeaverTail](https://attack.mitre.org/software/S1246) has previously been leveraged by North Korea-affiliated actors identified as DeceptiveDevelopment or [Contagious Interview](https://attack.mitre.org/groups/G1052). [BeaverTail](https://attack.mitre.org/software/S1246) has been delivered to victims through code repository sites and has been embedded within malicious attachments.(Citation: PaloAlto ContagiousInterview BeaverTail InvisibleFerret November 2023)(Citation: Esentire ContagiousInterview BeaverTail InvisibleFerret November 2024)(Citation: ESET Contagious Interview BeaverTail InvisibleFerret February 2025)(Citation: Zscaler ContagiousInterview BeaverTail InvisibleFerret November 2024)", n.name = "BeaverTail", n.ontolocy_created = "2026-06-18T09:26:41.211169000", n.ontolocy_merged = "2026-06-18T09:26:41.211169000", n.ref_url = "https://attack.mitre.org/software/S1246", n.stix_created = "2025-10-19T17:13:08.728000000+00:00", n.stix_id = "malware--6055aee2-d1c6-4877-94e9-a3bde9936470", n.stix_modified = "2025-10-24T00:40:04.709000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0240"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "2.3", n.description = "[ROKRAT](https://attack.mitre.org/software/S0240) is a cloud-based remote access tool (RAT) used by [APT37](https://attack.mitre.org/groups/G0067) to target victims in South Korea. [APT37](https://attack.mitre.org/groups/G0067) has used ROKRAT during several campaigns from 2016 through 2021.(Citation: Talos ROKRAT)(Citation: Talos Group123)(Citation: Volexity InkySquid RokRAT August 2021)", n.name = "ROKRAT", n.ontolocy_created = "2026-06-18T09:26:41.211922000", n.ontolocy_merged = "2026-06-18T09:26:41.211922000", n.ref_url = "https://attack.mitre.org/software/S0240", n.stix_created = "2018-10-17T00:14:20.652000000+00:00", n.stix_id = "malware--60a9c2f0-b7a5-4e8e-959c-e1a3ff314a5f", n.stix_modified = "2025-04-25T14:43:33.037000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0137"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.3.0", n.attack_version = "2.2", n.description = "[CORESHELL](https://attack.mitre.org/software/S0137) is a downloader used by [APT28](https://attack.mitre.org/groups/G0007). The older versions of this malware are known as SOURFACE and newer versions as CORESHELL.(Citation: FireEye APT28) (Citation: FireEye APT28 January 2017)", n.name = "CORESHELL", n.ontolocy_created = "2026-06-18T09:26:41.212527000", n.ontolocy_merged = "2026-06-18T09:26:41.212527000", n.ref_url = "https://attack.mitre.org/software/S0137", n.stix_created = "2017-05-31T21:33:18.506000000+00:00", n.stix_id = "malware--60c18d06-7b91-4742-bae3-647845cd9d81", n.stix_modified = "2025-10-22T02:47:28.036000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0253"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.3.0", n.attack_version = "1.2", n.description = "[RunningRAT](https://attack.mitre.org/software/S0253) is a remote access tool that appeared in operations surrounding the 2018 Pyeongchang Winter Olympics along with [Gold Dragon](https://attack.mitre.org/software/S0249) and [Brave Prince](https://attack.mitre.org/software/S0252). (Citation: McAfee Gold Dragon)", n.name = "RunningRAT", n.ontolocy_created = "2026-06-18T09:26:41.213227000", n.ontolocy_merged = "2026-06-18T09:26:41.213227000", n.ref_url = "https://attack.mitre.org/software/S0253", n.stix_created = "2018-10-17T00:14:20.652000000+00:00", n.stix_id = "malware--60d50676-459a-47dd-92e9-a827a9fe9c58", n.stix_modified = "2025-10-22T03:02:12.918000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S1010"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "2.1", n.description = "[VPNFilter](https://attack.mitre.org/software/S1010) is a multi-stage, modular platform with versatile capabilities to support both intelligence-collection and destructive cyber attack operations. [VPNFilter](https://attack.mitre.org/software/S1010) modules such as its packet sniffer ('ps') can collect traffic that passes through an infected device, allowing the theft of website credentials and monitoring of Modbus SCADA protocols. (Citation: William Largent June 2018) (Citation: Carl Hurd March 2019) [VPNFilter](https://attack.mitre.org/software/S1010) was assessed to be replaced by [Sandworm Team](https://attack.mitre.org/groups/G0034) with [Cyclops Blink](https://attack.mitre.org/software/S0687) starting in 2019.(Citation: NCSC CISA Cyclops Blink Advisory February 2022)", n.name = "VPNFilter", n.ontolocy_created = "2026-06-18T09:26:41.213961000", n.ontolocy_merged = "2026-06-18T09:26:41.213961000", n.ref_url = "https://attack.mitre.org/software/S1010", n.stix_created = "2019-03-26T15:02:14.907000000+00:00", n.stix_id = "malware--6108f800-10b8-4090-944e-be579f01263d", n.stix_modified = "2025-04-15T19:46:34.471000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S1232"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.3.0", n.attack_version = "1.0", n.description = "[SplatDropper](https://attack.mitre.org/software/S1232) is a loader that utilizes native windows API to deliver its payload to the victim environment.  [SplatDropper](https://attack.mitre.org/software/S1232) has been delivered through RAR archives and used legitimate executable for DLL side-loading.  [SplatDropper](https://attack.mitre.org/software/S1232) is known to be leveraged by [Mustang Panda](https://attack.mitre.org/groups/G0129) and was first observed utilized in 2025.", n.name = "SplatDropper", n.ontolocy_created = "2026-06-18T09:26:41.214572000", n.ontolocy_merged = "2026-06-18T09:26:41.214572000", n.ref_url = "https://attack.mitre.org/software/S1232", n.stix_created = "2025-09-12T14:46:05.125000000+00:00", n.stix_id = "malware--6114c345-4c09-42ce-8d37-aef16360a7f3", n.stix_modified = "2025-10-21T16:56:26.801000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0638"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[Babuk](https://attack.mitre.org/software/S0638) is a Ransomware-as-a-service (RaaS) malware that has been used since at least 2021. The operators of [Babuk](https://attack.mitre.org/software/S0638) employ a \"Big Game Hunting\" approach to targeting major enterprises and operate a leak site to post stolen data as part of their extortion scheme.(Citation: Sogeti CERT ESEC Babuk March 2021)(Citation: McAfee Babuk February 2021)(Citation: CyberScoop Babuk February 2021)", n.name = "Babuk", n.ontolocy_created = "2026-06-18T09:26:41.215173000", n.ontolocy_merged = "2026-06-18T09:26:41.215173000", n.ref_url = "https://attack.mitre.org/software/S0638", n.stix_created = "2021-08-11T17:36:46.197000000+00:00", n.stix_id = "malware--61c7a91a-0b83-461d-ad32-75d96eed4a09", n.stix_modified = "2025-04-25T14:43:34.138000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S1179"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[Exbyte](https://attack.mitre.org/software/S1179) is an exfiltration tool written in Go that is uniquely associated with [BlackByte](https://attack.mitre.org/groups/G1043) operations. Observed since 2022, [Exbyte](https://attack.mitre.org/software/S1179) transfers collected files to online file sharing and hosting services.(Citation: Symantec BlackByte 2022)", n.name = "Exbyte", n.ontolocy_created = "2026-06-18T09:26:41.215764000", n.ontolocy_merged = "2026-06-18T09:26:41.215764000", n.ref_url = "https://attack.mitre.org/software/S1179", n.stix_created = "2024-12-17T00:18:02.466000000+00:00", n.stix_id = "malware--6207dd22-bf18-4c96-aada-c573a9bbf5ec", n.stix_modified = "2025-03-09T16:02:02.193000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

