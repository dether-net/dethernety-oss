MERGE (n:MitreAttackSoftware {attack_id: "S0371"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[POWERTON](https://attack.mitre.org/software/S0371) is a custom PowerShell backdoor first observed in 2018. It has typically been deployed as a late-stage backdoor by [APT33](https://attack.mitre.org/groups/G0064). At least two variants of the backdoor have been identified, with the later version containing improved functionality.(Citation: FireEye APT33 Guardrail)", n.name = "POWERTON", n.ontolocy_created = "2026-06-18T09:26:41.435440000", n.ontolocy_merged = "2026-06-18T09:26:41.435440000", n.ref_url = "https://attack.mitre.org/software/S0371", n.stix_created = "2019-04-16T17:43:42.724000000+00:00", n.stix_id = "malware--e85cae1a-bce3-4ac4-b36b-b00acac0567b", n.stix_modified = "2025-04-25T14:44:58.949000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

