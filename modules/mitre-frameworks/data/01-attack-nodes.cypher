ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[Mythic](https://attack.mitre.org/software/S0699) is an open source, cross-platform post-exploitation/command and control platform. [Mythic](https://attack.mitre.org/software/S0699) is designed to \"plug-n-play\" with various agents and communication channels.(Citation: Mythic Github)(Citation: Mythic SpecterOps)(Citation: Mythc Documentation) Deployed [Mythic](https://attack.mitre.org/software/S0699) C2 servers have been observed as part of potentially malicious infrastructure.(Citation: RecordedFuture 2021 Ad Infra)", n.name = "Mythic", n.ontolocy_created = "2026-06-18T09:26:41.522890000", n.ontolocy_merged = "2026-06-18T09:26:41.522890000", n.ref_url = "https://attack.mitre.org/software/S0699", n.stix_created = "2022-03-26T01:38:12.966000000+00:00", n.stix_id = "tool--d505fc8b-2e64-46eb-96d6-9ef7ffca5b66", n.stix_modified = "2025-04-16T20:38:56.653000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "tool";

