SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[PACEMAKER](https://attack.mitre.org/software/S1109) is a credential stealer that was used by [APT5](https://attack.mitre.org/groups/G1023) as early as 2020 including activity against US Defense Industrial Base (DIB) companies.(Citation: Mandiant Pulse Secure Zero-Day April 2021)", n.name = "PACEMAKER", n.ontolocy_created = "2026-06-18T09:26:41.218707000", n.ontolocy_merged = "2026-06-18T09:26:41.218707000", n.ref_url = "https://attack.mitre.org/software/S1109", n.stix_created = "2024-02-08T19:38:27.401000000+00:00", n.stix_id = "malware--647215dd-29a6-4528-b354-ca8b5e08fca1", n.stix_modified = "2025-04-15T19:46:34.604000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S1143"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[LunarLoader](https://attack.mitre.org/software/S1143) is the loader component for the [LunarWeb](https://attack.mitre.org/software/S1141) and [LunarMail](https://attack.mitre.org/software/S1142) backdoors that has been used by [Turla](https://attack.mitre.org/groups/G0010) since at least 2020 including against a European ministry of foreign affairs (MFA). [LunarLoader](https://attack.mitre.org/software/S1143) has been observed as a standalone and as a part of trojanized open-source software such as AdmPwd.(Citation: ESET Turla Lunar toolset May 2024)", n.name = "LunarLoader", n.ontolocy_created = "2026-06-18T09:26:41.219628000", n.ontolocy_merged = "2026-06-18T09:26:41.219628000", n.ref_url = "https://attack.mitre.org/software/S1143", n.stix_created = "2024-06-27T19:07:21.574000000+00:00", n.stix_id = "malware--6490afef-d88e-4e2b-b9d9-a472508ca59d", n.stix_modified = "2024-06-27T20:01:04.973000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

