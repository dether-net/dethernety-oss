ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[LazyScripter](https://attack.mitre.org/groups/G0140) is threat group that has mainly targeted the airlines industry since at least 2018, primarily using open-source toolsets.(Citation: MalwareBytes LazyScripter Feb 2021)", n.name = "LazyScripter", n.ontolocy_created = "2026-06-18T09:26:45.284683000", n.ontolocy_merged = "2026-06-18T09:26:45.284683000", n.ref_url = "https://attack.mitre.org/groups/G0140", n.stix_created = "2021-11-24T19:26:27.305000000+00:00", n.stix_id = "intrusion-set--abc5a1d4-f0dc-49d1-88a1-4a80e478bb03", n.stix_modified = "2024-11-17T14:12:07.294000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "intrusion-set";

MERGE (n:MitreAttackGroup {attack_id: "G0084"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[Gallmaker](https://attack.mitre.org/groups/G0084) is a cyberespionage group that has targeted victims in the Middle East and has been active since at least December 2017. The group has mainly targeted victims in the defense, military, and government sectors.(Citation: Symantec Gallmaker Oct 2018)", n.name = "Gallmaker", n.ontolocy_created = "2026-06-18T09:26:45.285256000", n.ontolocy_merged = "2026-06-18T09:26:45.285256000", n.ref_url = "https://attack.mitre.org/groups/G0084", n.stix_created = "2019-01-30T14:26:42.897000000+00:00", n.stix_id = "intrusion-set--2fd2be6a-d3a2-4a65-b499-05ea2693abee", n.stix_modified = "2025-04-25T14:49:34.304000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "intrusion-set";

