SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[CaddyWiper](https://attack.mitre.org/software/S0693) is a destructive data wiper that has been used in attacks against organizations in Ukraine since at least March 2022.(Citation: ESET CaddyWiper March 2022)(Citation: Cisco CaddyWiper March 2022)", n.name = "CaddyWiper", n.ontolocy_created = "2026-06-18T09:26:41.349221000", n.ontolocy_merged = "2026-06-18T09:26:41.349221000", n.ref_url = "https://attack.mitre.org/software/S0693", n.stix_created = "2022-03-23T20:15:38.177000000+00:00", n.stix_id = "malware--b30d999d-64e0-4e35-9856-884e4b83d611", n.stix_modified = "2024-04-17T15:09:37.646000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0687"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.2", n.description = "[Cyclops Blink](https://attack.mitre.org/software/S0687) is a modular malware that has been used in widespread campaigns by [Sandworm Team](https://attack.mitre.org/groups/G0034) since at least 2019 to target Small/Home Office (SOHO) network devices, including WatchGuard and Asus. [Cyclops Blink](https://attack.mitre.org/software/S0687) is assessed to be a replacement for [VPNFilter](https://attack.mitre.org/software/S1010), a similar platform targeting network devices.(Citation: NCSC Cyclops Blink February 2022)(Citation: NCSC CISA Cyclops Blink Advisory February 2022)(Citation: Trend Micro Cyclops Blink March 2022)", n.name = "Cyclops Blink", n.ontolocy_created = "2026-06-18T09:26:41.349796000", n.ontolocy_merged = "2026-06-18T09:26:41.349796000", n.ref_url = "https://attack.mitre.org/software/S0687", n.stix_created = "2022-03-03T15:37:41.440000000+00:00", n.stix_id = "malware--b350b47f-88fe-4921-8538-6d9c59bac84e", n.stix_modified = "2025-04-15T19:46:35.048000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

