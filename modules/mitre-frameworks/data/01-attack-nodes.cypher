SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[Moneybird](https://attack.mitre.org/software/S1137) is a ransomware variant written in C++ associated with [Agrius](https://attack.mitre.org/groups/G1030) operations. The name \"Moneybird\" is contained in the malware's ransom note and as strings in the executable.(Citation: CheckPoint Agrius 2023)", n.name = "Moneybird", n.ontolocy_created = "2026-06-18T09:26:41.148690000", n.ontolocy_merged = "2026-06-18T09:26:41.148690000", n.ref_url = "https://attack.mitre.org/software/S1137", n.stix_created = "2024-05-22T23:05:34.895000000+00:00", n.stix_id = "malware--47ab6350-054f-4754-ba4d-e52a4e8751e2", n.stix_modified = "2024-08-29T15:19:39.017000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0260"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "2.1", n.description = "[InvisiMole](https://attack.mitre.org/software/S0260) is a modular spyware program that has been used by the InvisiMole Group since at least 2013. [InvisiMole](https://attack.mitre.org/software/S0260) has two backdoor modules called RC2FM and RC2CL that are used to perform post-exploitation activities. It has been discovered on compromised victims in the Ukraine and Russia. [Gamaredon Group](https://attack.mitre.org/groups/G0047) infrastructure has been used to download and execute [InvisiMole](https://attack.mitre.org/software/S0260) against a small number of victims.(Citation: ESET InvisiMole June 2018)(Citation: ESET InvisiMole June 2020)", n.name = "InvisiMole", n.ontolocy_created = "2026-06-18T09:26:41.149295000", n.ontolocy_merged = "2026-06-18T09:26:41.149295000", n.ref_url = "https://attack.mitre.org/software/S0260", n.stix_created = "2018-10-17T00:14:20.652000000+00:00", n.stix_id = "malware--47afe41c-4c08-485e-b062-c3bd209a1cce", n.stix_modified = "2025-04-25T14:43:10.665000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

