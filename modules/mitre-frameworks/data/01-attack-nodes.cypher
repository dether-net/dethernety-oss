MERGE (n:MitreAttackSoftware {attack_id: "S1141"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[LunarWeb](https://attack.mitre.org/software/S1141) is a backdoor that has been used by [Turla](https://attack.mitre.org/groups/G0010) since at least 2020 including in a compromise of a European ministry of foreign affairs (MFA) together with [LunarLoader](https://attack.mitre.org/software/S1143) and [LunarMail](https://attack.mitre.org/software/S1142). [LunarWeb](https://attack.mitre.org/software/S1141) has only been observed deployed against servers and can use [Steganography](https://attack.mitre.org/techniques/T1001/002) to obfuscate command and control.(Citation: ESET Turla Lunar toolset May 2024)", n.name = "LunarWeb", n.ontolocy_created = "2026-06-18T09:26:41.422207000", n.ontolocy_merged = "2026-06-18T09:26:41.422207000", n.ref_url = "https://attack.mitre.org/software/S1141", n.stix_created = "2024-06-26T18:07:37.796000000+00:00", n.stix_id = "malware--e1284931-3f85-4262-a641-9ae8bb0576a0", n.stix_modified = "2024-08-16T14:42:02.739000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0658"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.3", n.description = "[XCSSET](https://attack.mitre.org/software/S0658) is a modular macOS malware family delivered through infected Xcode projects and executed when the project is compiled. Active since August 2020, it has been observed installing backdoors, spoofed browsers, collecting data, and encrypting user files. It is composed of SHC-compiled shell scripts and run-only AppleScripts, often hiding in apps that mimic system tools (such as Xcode, Mail, or Notes) or use familiar icons (like Launchpad) to avoid detection.(Citation: trendmicro xcsset xcode project 2020)(Citation: April 2021 TrendMicro XCSSET)(Citation: Microsoft March 2025 XCSSET)", n.name = "XCSSET", n.ontolocy_created = "2026-06-18T09:26:41.422810000", n.ontolocy_merged = "2026-06-18T09:26:41.422810000", n.ref_url = "https://attack.mitre.org/software/S0658", n.stix_created = "2021-10-05T21:58:51.161000000+00:00", n.stix_id = "malware--e14085cb-0e8d-4be6-92ba-e3b93ee5978f", n.stix_modified = "2025-04-04T17:39:46.453000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S1088"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[Disco](https://attack.mitre.org/software/S1088) is a custom implant that has been used by [MoustachedBouncer](https://attack.mitre.org/groups/G1019) since at least 2020 including in campaigns using targeted malicious content injection for initial access and command and control.(Citation: MoustachedBouncer ESET August 2023)", n.name = "Disco", n.ontolocy_created = "2026-06-18T09:26:41.423393000", n.ontolocy_merged = "2026-06-18T09:26:41.423393000", n.ref_url = "https://attack.mitre.org/software/S1088", n.stix_created = "2023-09-25T20:29:37.737000000+00:00", n.stix_id = "malware--e1445afd-c359-45ed-8f27-626dc4d5e157", n.stix_modified = "2023-10-04T17:18:07.384000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

