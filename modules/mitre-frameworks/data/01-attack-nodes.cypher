SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.2", n.description = "[Helminth](https://attack.mitre.org/software/S0170) is a backdoor that has at least two variants - one written in VBScript and PowerShell that is delivered via a macros in Excel spreadsheets, and one that is a standalone Windows executable. (Citation: Palo Alto OilRig May 2016)", n.name = "Helminth", n.ontolocy_created = "2026-06-18T09:26:41.445470000", n.ontolocy_merged = "2026-06-18T09:26:41.445470000", n.ref_url = "https://attack.mitre.org/software/S0170", n.stix_created = "2018-01-16T16:13:52.465000000+00:00", n.stix_id = "malware--eff1a885-6f90-42a1-901f-eef6e7a1905e", n.stix_modified = "2024-04-11T02:22:38.177000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0384"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "2.1", n.description = "[Dridex](https://attack.mitre.org/software/S0384) is a prolific banking Trojan that first appeared in 2014. By December 2019, the US Treasury estimated [Dridex](https://attack.mitre.org/software/S0384) had infected computers in hundreds of banks and financial institutions in over 40 countries, leading to more than $100 million in theft. [Dridex](https://attack.mitre.org/software/S0384) was created from the source code of the Bugat banking Trojan (also known as Cridex).(Citation: Dell Dridex Oct 2015)(Citation: Kaspersky Dridex May 2017)(Citation: Treasury EvilCorp Dec 2019)", n.name = "Dridex", n.ontolocy_created = "2026-06-18T09:26:41.446065000", n.ontolocy_merged = "2026-06-18T09:26:41.446065000", n.ref_url = "https://attack.mitre.org/software/S0384", n.stix_created = "2019-05-30T19:47:37.192000000+00:00", n.stix_id = "malware--f01e2711-4b48-4192-a2e8-5f56c945ca19", n.stix_modified = "2025-04-16T20:38:42.420000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

