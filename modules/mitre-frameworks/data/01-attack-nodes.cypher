MERGE (n:MitreAttackSoftware {attack_id: "S1154"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[VersaMem](https://attack.mitre.org/software/S1154) is a web shell designed for deployment to Versa Director servers following exploitation. Discovered in August 2024, [VersaMem](https://attack.mitre.org/software/S1154) was used during [Versa Director Zero Day Exploitation](https://attack.mitre.org/campaigns/C0039) by [Volt Typhoon](https://attack.mitre.org/groups/G1017) to target ISPs and MSPs.  [VersaMem](https://attack.mitre.org/software/S1154) is deployed as a Java Archive (JAR) and allows for credential capture for Versa Director logon activity as well as follow-on execution of arbitrary Java payloads.(Citation: Lumen Versa 2024)", n.name = "VersaMem", n.ontolocy_created = "2026-06-18T09:26:41.043860000", n.ontolocy_merged = "2026-06-18T09:26:41.043860000", n.ref_url = "https://attack.mitre.org/software/S1154", n.stix_created = "2024-08-27T19:00:38.548000000+00:00", n.stix_id = "malware--0a6ec267-83a9-41a5-98c7-57c3ff81e11f", n.stix_modified = "2025-04-15T19:46:33.283000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

