SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.8", n.description = "[Impacket](https://attack.mitre.org/software/S0357) is an open source collection of modules written in Python for programmatically constructing and manipulating network protocols. [Impacket](https://attack.mitre.org/software/S0357) contains several tools for remote service execution, Kerberos manipulation, Windows credential dumping, packet sniffing, and relay attacks.(Citation: Impacket Tools)", n.name = "Impacket", n.ontolocy_created = "2026-06-18T09:26:41.481612000", n.ontolocy_merged = "2026-06-18T09:26:41.481612000", n.ref_url = "https://attack.mitre.org/software/S0357", n.stix_created = "2019-01-31T01:39:56.283000000+00:00", n.stix_id = "tool--26c87906-d750-42c5-946c-d4162c73fc7b", n.stix_modified = "2025-04-04T17:16:12.597000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "tool";

