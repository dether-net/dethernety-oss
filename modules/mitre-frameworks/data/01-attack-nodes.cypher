SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[Siloscape](https://attack.mitre.org/software/S0623) is malware that targets Kubernetes clusters through Windows containers. [Siloscape](https://attack.mitre.org/software/S0623) was first observed in March 2021.(Citation: Unit 42 Siloscape Jun 2021)", n.name = "Siloscape", n.ontolocy_created = "2026-06-18T09:26:41.169298000", n.ontolocy_merged = "2026-06-18T09:26:41.169298000", n.ref_url = "https://attack.mitre.org/software/S0623", n.stix_created = "2021-06-18T15:26:55.509000000+00:00", n.stix_id = "malware--4fbd565b-bf55-4ac7-80b4-b183a7b64b9c", n.stix_modified = "2025-04-25T14:43:17.695000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S1068"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.3.0", n.attack_version = "1.1", n.description = "[BlackCat](https://attack.mitre.org/software/S1068) is ransomware written in Rust that has been offered via the Ransomware-as-a-Service (RaaS) model. First observed November 2021, [BlackCat](https://attack.mitre.org/software/S1068) has been used to target multiple sectors and organizations in various countries and regions in Africa, the Americas, Asia, Australia, and Europe.(Citation: Microsoft BlackCat Jun 2022)(Citation: Sophos BlackCat Jul 2022)(Citation: ACSC BlackCat Apr 2022)", n.name = "BlackCat", n.ontolocy_created = "2026-06-18T09:26:41.170025000", n.ontolocy_merged = "2026-06-18T09:26:41.170025000", n.ref_url = "https://attack.mitre.org/software/S1068", n.stix_created = "2023-02-28T20:50:36.164000000+00:00", n.stix_id = "malware--50c44c34-3abb-48ae-9433-a2337de5b0bc", n.stix_modified = "2025-10-21T15:28:37.027000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

