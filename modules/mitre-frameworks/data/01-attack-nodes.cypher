ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.3.0", n.attack_version = "3.2", n.description = "[PlugX](https://attack.mitre.org/software/S0013) is a remote access tool (RAT) with modular plugins that has been used by multiple threat groups.(Citation: Lastline PlugX Analysis)(Citation: FireEye Clandestine Fox Part 2)(Citation: New DragonOK)(Citation: Dell TG-3390)", n.name = "PlugX", n.ontolocy_created = "2026-06-18T09:26:41.220790000", n.ontolocy_merged = "2026-06-18T09:26:41.220790000", n.ref_url = "https://attack.mitre.org/software/S0013", n.stix_created = "2017-05-31T21:32:15.638000000+00:00", n.stix_id = "malware--64fa0de0-6240-41f4-8638-f4ca7ed528fd", n.stix_modified = "2025-09-11T18:28:54.041000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0172"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.3.0", n.attack_version = "1.3", n.description = "[Reaver](https://attack.mitre.org/software/S0172) is a malware family that has been in the wild since at least late 2016. Reporting indicates victims have primarily been associated with the \"Five Poisons,\" which are movements the Chinese government considers dangerous. The type of malware is rare due to its final payload being in the form of [Control Panel](https://attack.mitre.org/techniques/T1218/002) items.(Citation: Palo Alto Reaver Nov 2017)", n.name = "Reaver", n.ontolocy_created = "2026-06-18T09:26:41.221366000", n.ontolocy_merged = "2026-06-18T09:26:41.221366000", n.ref_url = "https://attack.mitre.org/software/S0172", n.stix_created = "2018-01-16T16:13:52.465000000+00:00", n.stix_id = "malware--65341f30-bec6-4b1d-8abf-1a5620446c29", n.stix_modified = "2025-10-22T03:21:09.704000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

