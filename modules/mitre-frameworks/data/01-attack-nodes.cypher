SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.3", n.description = "[KeyBoy](https://attack.mitre.org/software/S0387) is malware that has been used in targeted campaigns against members of the Tibetan Parliament in 2016.(Citation: CitizenLab KeyBoy Nov 2016)(Citation: PWC KeyBoys Feb 2017)", n.name = "KeyBoy", n.ontolocy_created = "2026-06-18T09:26:41.205509000", n.ontolocy_merged = "2026-06-18T09:26:41.205509000", n.ref_url = "https://attack.mitre.org/software/S0387", n.stix_created = "2019-06-14T16:45:33.729000000+00:00", n.stix_id = "malware--5dd649c0-bca4-488b-bd85-b180474ec62e", n.stix_modified = "2024-04-18T18:25:18.520000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0150"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.2", n.description = "[POSHSPY](https://attack.mitre.org/software/S0150) is a backdoor that has been used by [APT29](https://attack.mitre.org/groups/G0016) since at least 2015. It appears to be used as a secondary backdoor used if the actors lost access to their primary backdoors. (Citation: FireEye POSHSPY April 2017)", n.name = "POSHSPY", n.ontolocy_created = "2026-06-18T09:26:41.206246000", n.ontolocy_merged = "2026-06-18T09:26:41.206246000", n.ref_url = "https://attack.mitre.org/software/S0150", n.stix_created = "2017-12-14T16:46:06.044000000+00:00", n.stix_id = "malware--5e595477-2e78-4ce7-ae42-e0b059b17808", n.stix_modified = "2025-04-25T14:43:31.381000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0051"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.3", n.description = "[MiniDuke](https://attack.mitre.org/software/S0051) is malware that was used by [APT29](https://attack.mitre.org/groups/G0016) from 2010 to 2015. The [MiniDuke](https://attack.mitre.org/software/S0051) toolset consists of multiple downloader and backdoor components. The loader has been used with other [MiniDuke](https://attack.mitre.org/software/S0051) components as well as in conjunction with [CosmicDuke](https://attack.mitre.org/software/S0050) and [PinchDuke](https://attack.mitre.org/software/S0048). (Citation: F-Secure The Dukes)", n.name = "MiniDuke", n.ontolocy_created = "2026-06-18T09:26:41.206990000", n.ontolocy_merged = "2026-06-18T09:26:41.206990000", n.ref_url = "https://attack.mitre.org/software/S0051", n.stix_created = "2017-05-31T21:32:36.919000000+00:00", n.stix_id = "malware--5e7ef1dc-7fb6-4913-ac75-e06113b59e0c", n.stix_modified = "2025-04-25T14:43:31.760000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

