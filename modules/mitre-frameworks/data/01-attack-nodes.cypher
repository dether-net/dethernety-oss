SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[ZxxZ](https://attack.mitre.org/software/S1013) is a trojan written in Visual C++ that has been used by [BITTER](https://attack.mitre.org/groups/G1002) since at least August 2021, including against Bangladeshi government personnel.(Citation: Cisco Talos Bitter Bangladesh May 2022)", n.name = "ZxxZ", n.ontolocy_created = "2026-06-18T09:26:41.306030000", n.ontolocy_merged = "2026-06-18T09:26:41.306030000", n.ref_url = "https://attack.mitre.org/software/S1013", n.stix_created = "2022-06-02T12:27:33.899000000+00:00", n.stix_id = "malware--97cfbdc6-504d-41e9-a46c-78a9f806ff0d", n.stix_modified = "2024-04-10T20:29:50.729000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S1011"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[Tarrask](https://attack.mitre.org/software/S1011) is malware that has been used by [HAFNIUM](https://attack.mitre.org/groups/G0125) since at least August 2021. [Tarrask](https://attack.mitre.org/software/S1011) was designed to evade digital defenses and maintain persistence by generating concealed scheduled tasks.(Citation: Tarrask scheduled task)", n.name = "Tarrask", n.ontolocy_created = "2026-06-18T09:26:41.306836000", n.ontolocy_merged = "2026-06-18T09:26:41.306836000", n.ref_url = "https://attack.mitre.org/software/S1011", n.stix_created = "2022-06-01T17:01:32.151000000+00:00", n.stix_id = "malware--988976ff-beeb-4fb5-b07d-ca7437ea66e8", n.stix_modified = "2025-04-16T20:38:25.204000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

