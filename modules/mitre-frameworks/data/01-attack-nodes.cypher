MERGE (n:MitreAttackSoftware {attack_id: "S0364"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[RawDisk](https://attack.mitre.org/software/S0364) is a legitimate commercial driver from the EldoS Corporation that is used for interacting with files, disks, and partitions. The driver allows for direct modification of data on a local computer's hard drive. In some cases, the tool can enact these raw disk modifications from user-mode processes, circumventing Windows operating system security features.(Citation: EldoS RawDisk ITpro)(Citation: Novetta Blockbuster Destructive Malware)", n.name = "RawDisk", n.ontolocy_created = "2026-06-18T09:26:41.489978000", n.ontolocy_merged = "2026-06-18T09:26:41.489978000", n.ref_url = "https://attack.mitre.org/software/S0364", n.stix_created = "2019-03-25T12:30:40.919000000+00:00", n.stix_id = "tool--3ffbdc1f-d2bf-41ab-91a2-c7b857e98079", n.stix_modified = "2024-11-17T19:51:16.652000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "tool";

