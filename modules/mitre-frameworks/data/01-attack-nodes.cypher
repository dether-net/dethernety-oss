MERGE (n:MitreAttackSoftware {attack_id: "S1238"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.3.0", n.attack_version = "1.0", n.description = "[STATICPLUGIN](https://attack.mitre.org/software/S1238) is a downloader known to be leveraged by [Mustang Panda](https://attack.mitre.org/groups/G0129) and was first observed utilized in 2025.  [STATICPLUGIN](https://attack.mitre.org/software/S1238) has utilized a valid certificate in order to bypass endpoint security protections.  [STATICPLUGIN](https://attack.mitre.org/software/S1238) masqueraded as legitimate software installer by using a custom TForm.  [STATICPLUGIN](https://attack.mitre.org/software/S1238) has been leveraged to deploy a loader that facilitates follow on malware.(Citation: Google Threat Intelligence Group MUSTANG PANDA PLUGX August 2025)", n.name = "STATICPLUGIN", n.ontolocy_created = "2026-06-18T09:26:41.097574000", n.ontolocy_merged = "2026-06-18T09:26:41.097574000", n.ref_url = "https://attack.mitre.org/software/S1238", n.stix_created = "2025-09-12T17:38:17.697000000+00:00", n.stix_id = "malware--301e7370-c3d3-4f3e-893f-8a79345c2eb5", n.stix_modified = "2025-10-21T16:55:19.794000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

