MERGE (n:MitreAttackSoftware {attack_id: "S0036"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[FLASHFLOOD](https://attack.mitre.org/software/S0036) is malware developed by [APT30](https://attack.mitre.org/groups/G0013) that allows propagation and exfiltration of data over removable devices. [APT30](https://attack.mitre.org/groups/G0013) may use this capability to exfiltrate data across air-gaps. (Citation: FireEye APT30)", n.name = "FLASHFLOOD", n.ontolocy_created = "2026-06-18T09:26:41.139362000", n.ontolocy_merged = "2026-06-18T09:26:41.139362000", n.ref_url = "https://attack.mitre.org/software/S0036", n.stix_created = "2017-05-31T21:32:28.754000000+00:00", n.stix_id = "malware--43213480-78f7-4fb3-976f-d48f5f6a4c2a", n.stix_modified = "2024-11-17T15:05:25.105000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

