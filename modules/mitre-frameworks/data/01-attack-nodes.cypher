ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.3.0", n.attack_version = "1.2", n.description = "[Mafalda](https://attack.mitre.org/software/S1060) is a flexible interactive implant that has been used by [Metador](https://attack.mitre.org/groups/G1013). Security researchers assess the [Mafalda](https://attack.mitre.org/software/S1060) name may be inspired by an Argentinian cartoon character that has been popular as a means of political commentary since the 1960s. (Citation: SentinelLabs Metador Sept 2022)", n.name = "Mafalda", n.ontolocy_created = "2026-06-18T09:26:41.120073000", n.ontolocy_merged = "2026-06-18T09:26:41.120073000", n.ref_url = "https://attack.mitre.org/software/S1060", n.stix_created = "2023-01-26T01:21:43.409000000+00:00", n.stix_id = "malware--3be1fb7a-0f7e-415e-8e3a-74a80d596e68", n.stix_modified = "2025-10-21T22:47:45.475000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

