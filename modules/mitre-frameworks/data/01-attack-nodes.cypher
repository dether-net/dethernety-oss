ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.3.0", n.attack_version = "1.0", n.description = "[BOOKWORM](https://attack.mitre.org/software/S1226) is a modular trojan known to be leveraged by [Mustang Panda](https://attack.mitre.org/groups/G0129) and was first observed utilized in 2015.  [BOOKWORM](https://attack.mitre.org/software/S1226) was later updated in late 2021 and the fall of 2022 to launch shellcode represented as UUID parameters. (Citation: Broadcom)(Citation: Unit42 Bookworm Nov2015)(Citation: Palo Alto Networks, Unit 42)", n.name = "BOOKWORM", n.ontolocy_created = "2026-06-18T09:26:41.091246000", n.ontolocy_merged = "2026-06-18T09:26:41.091246000", n.ref_url = "https://attack.mitre.org/software/S1226", n.stix_created = "2025-07-21T19:02:10.637000000+00:00", n.stix_id = "malware--2ceddaf9-b16a-4f8b-b252-bcccccd3d79f", n.stix_modified = "2025-10-21T16:51:50.819000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

