SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[MechaFlounder](https://attack.mitre.org/software/S0459) is a python-based remote access tool (RAT) that has been used by [APT39](https://attack.mitre.org/groups/G0087). The payload uses a combination of actor developed code and code snippets freely available online in development communities.(Citation: Unit 42 MechaFlounder March 2019)", n.name = "MechaFlounder", n.ontolocy_created = "2026-06-18T09:26:41.418615000", n.ontolocy_merged = "2026-06-18T09:26:41.418615000", n.ref_url = "https://attack.mitre.org/software/S0459", n.stix_created = "2020-05-27T19:05:29.386000000+00:00", n.stix_id = "malware--dfa03c7d-79ed-4ce2-b9d1-ddc9dbf56ad2", n.stix_modified = "2025-04-25T14:44:52.837000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0078"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[Psylo](https://attack.mitre.org/software/S0078) is a shellcode-based Trojan that has been used by [Scarlet Mimic](https://attack.mitre.org/groups/G0029). It has similar characteristics as [FakeM](https://attack.mitre.org/software/S0076). (Citation: Scarlet Mimic Jan 2016)", n.name = "Psylo", n.ontolocy_created = "2026-06-18T09:26:41.419189000", n.ontolocy_merged = "2026-06-18T09:26:41.419189000", n.ref_url = "https://attack.mitre.org/software/S0078", n.stix_created = "2017-05-31T21:32:53.268000000+00:00", n.stix_id = "malware--dfb5fa9b-3051-4b97-8035-08f80aef945b", n.stix_modified = "2025-04-25T14:44:53.196000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

