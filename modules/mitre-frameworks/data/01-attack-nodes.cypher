MERGE (n:MitreAttackDataComponent {attack_id: "DC0027"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.3.0", n.attack_version = "2.0", n.description = "Cloud Storage Metadata provides contextual information about cloud storage infrastructure and its associated activity. This data may include attributes such as storage name, size, owner, permissions, creation date, region, and activity metadata. It is essential for monitoring, auditing, and identifying anomalies in cloud storage environments. Examples:   - AWS S3 Bucket Metadata: Metadata about an S3 bucket includes the bucket name, region, creation date, owner, storage class, and permissions. - Azure Blob Storage Metadata: Metadata for an Azure Blob container includes container name, access level (e.g., private or public), size, and tags. - Google Cloud Storage Metadata: Metadata includes bucket name, storage class, location, labels, lifecycle policies, and versioning status. - OpenStack Swift Metadata: Metadata for a Swift container includes name, access level, quota, and custom attributes.", n.name = "Cloud Storage Metadata", n.ontolocy_created = "2026-06-18T09:26:44.816042000", n.ontolocy_merged = "2026-06-18T09:26:44.816042000", n.ref_url = "https://attack.mitre.org/datacomponents/DC0027", n.stix_created = "2021-10-20T15:05:19.272000000+00:00", n.stix_id = "x-mitre-data-component--e214eb6d-de8f-4154-9015-6d47915fbed1", n.stix_modified = "2025-11-12T22:03:39.105000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "x-mitre-data-component";

MERGE (n:MitreAttackDataComponent {attack_id: "DC0069"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.3.0", n.attack_version = "2.0", n.description = "Cloud service modification refers to changes made to the configuration, settings, or data of a cloud service. These modifications can include administrative changes such as enabling or disabling features, altering permissions, or deleting critical components. Monitoring these changes is critical to detect potential misconfigurations or malicious activity. Examples:   - AWS Cloud Service Modifications: A user disables AWS CloudTrail logging (StopLogging) or deletes a CloudWatch configuration rule (DeleteConfigRule). - Azure Cloud Service Modifications: Changes to Azure Role-Based Access Control (RBAC) roles, such as adding a new Contributor role to a sensitive resource. - Google Cloud Service Modifications: Deletion of a Google Cloud Storage bucket or disabling a Google Cloud Function. - Office 365 Cloud Service Modifications: Altering mailbox permissions or disabling auditing in Microsoft 365.", n.name = "Cloud Service Modification", n.ontolocy_created = "2026-06-18T09:26:44.816666000", n.ontolocy_merged = "2026-06-18T09:26:44.816666000", n.ref_url = "https://attack.mitre.org/datacomponents/DC0069", n.stix_created = "2021-10-20T15:05:19.274000000+00:00", n.stix_id = "x-mitre-data-component--e52d89f9-1710-4708-88a5-cbef77c4cd5e", n.stix_modified = "2025-11-12T22:03:39.105000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "x-mitre-data-component";

MERGE (n:MitreAttackDataComponent {attack_id: "DC0040"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.3.0", n.attack_version = "2.0", n.description = "Refers to events where files are removed from a system or storage device. These events can indicate legitimate housekeeping activities or malicious actions such as attackers attempting to cover their tracks. Monitoring file deletions helps organizations identify unauthorized or suspicious activities.", n.name = "File Deletion", n.ontolocy_created = "2026-06-18T09:26:44.817705000", n.ontolocy_merged = "2026-06-18T09:26:44.817705000", n.ref_url = "https://attack.mitre.org/datacomponents/DC0040", n.stix_created = "2021-10-20T15:05:19.273000000+00:00", n.stix_id = "x-mitre-data-component--e905dad2-00d6-477c-97e8-800427abd0e8", n.stix_modified = "2025-11-12T22:03:39.105000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "x-mitre-data-component";

MERGE (n:MitreAttackDataComponent {attack_id: "DC0090"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.3.0", n.attack_version = "2.0", n.description = "This data component refers to monitoring actions that deactivate or stop a cloud service in a cloud control plane. Examples include disabling essential logging services like AWS CloudTrail (`StopLogging` API call), Microsoft Azure Monitor Logs, or Google Cloud's Operations Suite (formerly Stackdriver). Disabling such services can hinder visibility into adversary activities within the cloud environment. Examples:   - AWS CloudTrail StopLogging: This action stops logging of API activity for a particular trail, effectively reducing the monitoring and visibility of AWS resources and activities. - Microsoft Azure Monitor Logs: Disabling these logs hinders the organization's ability to detect anomalous activities and trace malicious actions. - Google Cloud Logging: Disabling cloud logging removes visibility into resource activity, preventing monitoring of service access or configuration changes. - SaaS Applications: Stopping logging removes visibility into user activities, such as email access or file downloads, enabling undetected malicious behavior.", n.name = "Cloud Service Disable", n.ontolocy_created = "2026-06-18T09:26:44.818540000", n.ontolocy_merged = "2026-06-18T09:26:44.818540000", n.ref_url = "https://attack.mitre.org/datacomponents/DC0090", n.stix_created = "2021-10-20T15:05:19.274000000+00:00", n.stix_id = "x-mitre-data-component--ec0612c5-2644-4c50-bcac-82586974fedd", n.stix_modified = "2025-11-12T22:03:39.105000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "x-mitre-data-component";

MERGE (n:MitreAttackDataComponent {attack_id: "DC0095"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.3.0", n.attack_version = "2.0", n.description = "An extracted list of available volumes within a cloud environment (ex: AWS describe-volumes)", n.name = "Volume Enumeration", n.ontolocy_created = "2026-06-18T09:26:44.819416000", n.ontolocy_merged = "2026-06-18T09:26:44.819416000", n.ref_url = "https://attack.mitre.org/datacomponents/DC0095", n.stix_created = "2021-10-20T15:05:19.275000000+00:00", n.stix_id = "x-mitre-data-component--ec225357-8197-47a4-a9cd-57741d592877", n.stix_modified = "2025-10-21T15:10:28.402000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "x-mitre-data-component";

MERGE (n:MitreAttackDataComponent {attack_id: "DC0050"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.3.0", n.attack_version = "2.0", n.description = "The action of opening a specific Windows Registry key, typically to read its associated value. This activity can be used for system configuration, application settings retrieval, and security policies.", n.name = "Windows Registry Key Access", n.ontolocy_created = "2026-06-18T09:26:44.820202000", n.ontolocy_merged = "2026-06-18T09:26:44.820202000", n.ref_url = "https://attack.mitre.org/datacomponents/DC0050", n.stix_created = "2021-10-20T15:05:19.273000000+00:00", n.stix_id = "x-mitre-data-component--ed0dd8aa-1677-4551-bb7d-8da767617e1b", n.stix_modified = "2025-11-12T22:03:39.105000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "x-mitre-data-component";

