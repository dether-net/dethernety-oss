SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[BlackMould](https://attack.mitre.org/software/S0564) is a web shell based on [China Chopper](https://attack.mitre.org/software/S0020) for servers running Microsoft IIS. First reported in December 2019, it has been used in malicious campaigns by [GALLIUM](https://attack.mitre.org/groups/G0093) against telecommunication providers.(Citation: Microsoft GALLIUM December 2019)", n.name = "BlackMould", n.ontolocy_created = "2026-06-18T09:26:41.217535000", n.ontolocy_merged = "2026-06-18T09:26:41.217535000", n.ref_url = "https://attack.mitre.org/software/S0564", n.stix_created = "2021-01-14T19:58:17.917000000+00:00", n.stix_id = "malware--63c4511b-2d6e-4bb2-b582-e2e99a8a467d", n.stix_modified = "2025-04-25T14:43:35.224000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

