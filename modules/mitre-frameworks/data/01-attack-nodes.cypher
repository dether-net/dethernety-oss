MERGE (n:MitreAttackSoftware {attack_id: "S0362"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.2", n.description = "[Linux Rabbit](https://attack.mitre.org/software/S0362) is malware that targeted Linux servers and IoT devices in a campaign lasting from August to October 2018. It shares code with another strain of malware known as Rabbot. The goal of the campaign was to install cryptocurrency miners onto the targeted servers and devices.(Citation: Anomali Linux Rabbit 2018) ", n.name = "Linux Rabbit", n.ontolocy_created = "2026-06-18T09:26:41.053305000", n.ontolocy_merged = "2026-06-18T09:26:41.053305000", n.ref_url = "https://attack.mitre.org/software/S0362", n.stix_created = "2019-03-04T17:12:37.586000000+00:00", n.stix_id = "malware--0efefea5-78da-4022-92bc-d726139e8883", n.stix_modified = "2025-04-25T14:42:42.534000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

