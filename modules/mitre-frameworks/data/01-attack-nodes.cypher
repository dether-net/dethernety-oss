SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[Clambling](https://attack.mitre.org/software/S0660) is a modular backdoor written in C++ that has been used by [Threat Group-3390](https://attack.mitre.org/groups/G0027) since at least 2017.(Citation: Trend Micro DRBControl February 2020)", n.name = "Clambling", n.ontolocy_created = "2026-06-18T09:26:41.235425000", n.ontolocy_merged = "2026-06-18T09:26:41.235425000", n.ref_url = "https://attack.mitre.org/software/S0660", n.stix_created = "2021-11-12T20:54:55.974000000+00:00", n.stix_id = "malware--6e95feb1-78ee-48d3-b421-4d76663b5c49", n.stix_modified = "2025-04-25T14:43:43.008000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S1129"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "2.0", n.description = "[Akira](https://attack.mitre.org/software/S1129) ransomware, written in C++, is most prominently (but not exclusively) associated with the ransomware-as-a-service entity [Akira](https://attack.mitre.org/groups/G1024). [Akira](https://attack.mitre.org/software/S1129) ransomware has been used in attacks across North America, Europe, and Australia, with a focus on critical infrastructure sectors including manufacturing, education, and IT services. [Akira](https://attack.mitre.org/software/S1129) ransomware employs hybrid encryption and threading to increase the speed and efficiency of encryption and runtime arguments for tailored attacks. Notable variants include Rust-based [Megazord](https://attack.mitre.org/software/S1191) for targeting Windows and [Akira _v2](https://attack.mitre.org/software/S1194) for targeting VMware ESXi servers.(Citation: Kersten Akira 2023)(Citation: CISA Akira Ransomware APR 2024)(Citation: Cisco Akira Ransomware OCT 2024)", n.name = "Akira", n.ontolocy_created = "2026-06-18T09:26:41.236006000", n.ontolocy_merged = "2026-06-18T09:26:41.236006000", n.ref_url = "https://attack.mitre.org/software/S1129", n.stix_created = "2024-04-04T17:59:46.698000000+00:00", n.stix_id = "malware--6f6b2353-4b39-40ce-9d6d-d00b7a61e656", n.stix_modified = "2025-03-11T15:37:13.258000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S1111"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.3.0", n.attack_version = "1.1", n.description = "[DarkGate](https://attack.mitre.org/software/S1111) first emerged in 2018 and has evolved into an initial access and data gathering tool associated with various criminal cyber operations. Written in Delphi and named \"DarkGate\" by its author, [DarkGate](https://attack.mitre.org/software/S1111) is associated with credential theft, cryptomining, cryptotheft, and pre-ransomware actions.(Citation: Ensilo Darkgate 2018) DarkGate use increased significantly starting in 2022 and is under active development by its author, who provides it as a Malware-as-a-Service offering.(Citation: Trellix Darkgate 2023)", n.name = "DarkGate", n.ontolocy_created = "2026-06-18T09:26:41.236604000", n.ontolocy_merged = "2026-06-18T09:26:41.236604000", n.ref_url = "https://attack.mitre.org/software/S1111", n.stix_created = "2024-02-09T19:52:30.428000000+00:00", n.stix_id = "malware--6f6f67c9-556d-4459-95c2-78d272190e52", n.stix_modified = "2025-10-21T03:02:05.582000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S1026"})
