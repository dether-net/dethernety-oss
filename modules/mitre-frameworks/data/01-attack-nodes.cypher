SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[DUSTPAN](https://attack.mitre.org/software/S1158) is an in-memory dropper written in C/C++ used by [APT41](https://attack.mitre.org/groups/G0096) since 2021 that decrypts and executes an embedded payload.(Citation: Google Cloud APT41 2024)(Citation: Google Cloud APT41 2022)", n.name = "DUSTPAN", n.ontolocy_created = "2026-06-18T09:26:41.110553000", n.ontolocy_merged = "2026-06-18T09:26:41.110553000", n.ref_url = "https://attack.mitre.org/software/S1158", n.stix_created = "2024-09-16T08:29:07.124000000+00:00", n.stix_id = "malware--37487ff6-de2a-4c14-9e8b-ba3b97f78aaf", n.stix_modified = "2024-09-21T07:18:26.370000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0113"})
