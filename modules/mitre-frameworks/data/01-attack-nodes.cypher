SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[Javali](https://attack.mitre.org/software/S0528) is a banking trojan that has targeted Portuguese and Spanish-speaking countries since 2017, primarily focusing on customers of financial institutions in Brazil and Mexico.(Citation: Securelist Brazilian Banking Malware July 2020)", n.name = "Javali", n.ontolocy_created = "2026-06-18T09:26:41.218123000", n.ontolocy_merged = "2026-06-18T09:26:41.218123000", n.ref_url = "https://attack.mitre.org/software/S0528", n.stix_created = "2020-11-09T18:32:18.369000000+00:00", n.stix_id = "malware--64122557-5940-4271-9123-25bfc0c693db", n.stix_modified = "2025-04-25T14:43:35.588000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

