SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[P2P ZeuS](https://attack.mitre.org/software/S0016) is a closed-source fork of the leaked version of the ZeuS botnet. It presents improvements over the leaked version, including a peer-to-peer architecture. (Citation: Dell P2P ZeuS)", n.name = "P2P ZeuS", n.ontolocy_created = "2026-06-18T09:26:41.348049000", n.ontolocy_merged = "2026-06-18T09:26:41.348049000", n.ref_url = "https://attack.mitre.org/software/S0016", n.stix_created = "2017-05-31T21:32:16.715000000+00:00", n.stix_id = "malware--b2c5d3ca-b43a-4888-ad8d-e2d43497bf85", n.stix_modified = "2024-04-24T19:08:50.637000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

