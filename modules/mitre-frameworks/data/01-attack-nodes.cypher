SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.6", n.description = "[NETWIRE](https://attack.mitre.org/software/S0198) is a publicly available, multiplatform remote administration tool (RAT) that has been used by criminal and APT groups since at least 2012.(Citation: FireEye APT33 Sept 2017)(Citation: McAfee Netwire Mar 2015)(Citation: FireEye APT33 Webinar Sept 2017)", n.name = "NETWIRE", n.ontolocy_created = "2026-06-18T09:26:41.088178000", n.ontolocy_merged = "2026-06-18T09:26:41.088178000", n.ref_url = "https://attack.mitre.org/software/S0198", n.stix_created = "2018-04-18T17:59:24.739000000+00:00", n.stix_id = "malware--2a70812b-f1ef-44db-8578-a496a227aef2", n.stix_modified = "2025-04-16T20:38:00.152000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

