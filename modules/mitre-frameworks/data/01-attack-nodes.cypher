SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[KGH_SPY](https://attack.mitre.org/software/S0526) is a modular suite of tools used by [Kimsuky](https://attack.mitre.org/groups/G0094) for reconnaissance, information stealing, and backdoor capabilities. [KGH_SPY](https://attack.mitre.org/software/S0526) derived its name from PDB paths and internal names found in samples containing \"KGH\".(Citation: Cybereason Kimsuky November 2020)", n.name = "KGH_SPY", n.ontolocy_created = "2026-06-18T09:26:41.278522000", n.ontolocy_merged = "2026-06-18T09:26:41.278522000", n.ref_url = "https://attack.mitre.org/software/S0526", n.stix_created = "2020-11-06T18:58:35.456000000+00:00", n.stix_id = "malware--8bdfe255-e658-4ddd-a11c-b854762e451d", n.stix_modified = "2024-04-11T01:45:40.875000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

