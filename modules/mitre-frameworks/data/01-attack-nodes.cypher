SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[Forfiles](https://attack.mitre.org/software/S0193) is a Windows utility commonly used in batch jobs to execute commands on one or more selected files or directories (ex: list all directories in a drive, read the first line of all files created yesterday, etc.). Forfiles can be executed from either the command line, Run window, or batch files/scripts. (Citation: Microsoft Forfiles Aug 2016)", n.name = "Forfiles", n.ontolocy_created = "2026-06-18T09:26:41.504586000", n.ontolocy_merged = "2026-06-18T09:26:41.504586000", n.ref_url = "https://attack.mitre.org/software/S0193", n.stix_created = "2018-04-18T17:59:24.739000000+00:00", n.stix_id = "tool--90ec2b22-7061-4469-b539-0989ec4f96c2", n.stix_modified = "2025-04-25T14:45:23.318000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "tool";

