ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.2", n.description = "[GreyEnergy](https://attack.mitre.org/software/S0342) is a backdoor written in C and compiled in Visual Studio. [GreyEnergy](https://attack.mitre.org/software/S0342) shares similarities with the [BlackEnergy](https://attack.mitre.org/software/S0089) malware and is thought to be the successor of it.(Citation: ESET GreyEnergy Oct 2018)", n.name = "GreyEnergy", n.ontolocy_created = "2026-06-18T09:26:41.098741000", n.ontolocy_merged = "2026-06-18T09:26:41.098741000", n.ref_url = "https://attack.mitre.org/software/S0342", n.stix_created = "2019-01-30T13:53:14.264000000+00:00", n.stix_id = "malware--308b3d68-a084-4dfb-885a-3125e1a9c1e8", n.stix_modified = "2024-04-11T02:24:46.255000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

