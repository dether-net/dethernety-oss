SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[Heyoka Backdoor](https://attack.mitre.org/software/S1027) is a custom backdoor--based on the Heyoka open source exfiltration tool--that  has been used by [Aoqin Dragon](https://attack.mitre.org/groups/G1007) since at least 2013.(Citation: SentinelOne Aoqin Dragon June 2022)(Citation: Sourceforge Heyoka 2022) ", n.name = "Heyoka Backdoor", n.ontolocy_created = "2026-06-18T09:26:41.419755000", n.ontolocy_merged = "2026-06-18T09:26:41.419755000", n.ref_url = "https://attack.mitre.org/software/S1027", n.stix_created = "2022-07-25T18:18:32.811000000+00:00", n.stix_id = "malware--dff90475-9f72-41a6-84ed-1fbefd3874c0", n.stix_modified = "2024-04-11T02:20:55.694000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

