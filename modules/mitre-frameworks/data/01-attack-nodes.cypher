ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.3.0", n.attack_version = "1.0", n.description = "[SplatCloak](https://attack.mitre.org/software/S1234) is a malware that disables EDR-related routines used by Windows Defender and Kaspersky to aid in evading detection.  [SplatCloak](https://attack.mitre.org/software/S1234) has been deployed by [SplatDropper](https://attack.mitre.org/software/S1232) and is known to be leveraged by [Mustang Panda](https://attack.mitre.org/groups/G0129) since 2025.(Citation: Zscaler PAKLOG CorkLog SplatCloak Splatdropper April 2025)", n.name = "SplatCloak", n.ontolocy_created = "2026-06-18T09:26:41.452078000", n.ontolocy_merged = "2026-06-18T09:26:41.452078000", n.ref_url = "https://attack.mitre.org/software/S1234", n.stix_created = "2025-09-12T15:26:05.778000000+00:00", n.stix_id = "malware--f39c6d39-0165-46db-a7ae-43341c428d22", n.stix_modified = "2025-10-21T16:55:42.594000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

