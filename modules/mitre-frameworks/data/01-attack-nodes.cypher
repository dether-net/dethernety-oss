MERGE (n:MitreAttackSoftware {attack_id: "S0578"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[SUPERNOVA](https://attack.mitre.org/software/S0578) is an in-memory web shell written in .NET C#. It was discovered in November 2020 during the investigation of [APT29](https://attack.mitre.org/groups/G0016)'s SolarWinds cyber operation but determined to be unrelated. Subsequent analysis suggests [SUPERNOVA](https://attack.mitre.org/software/S0578) may have been used by the China-based threat group SPIRAL.(Citation: Guidepoint SUPERNOVA Dec 2020)(Citation: Unit42 SUPERNOVA Dec 2020)(Citation: SolarWinds Advisory Dec 2020)(Citation: CISA Supernova Jan 2021)(Citation: Microsoft Analyzing Solorigate Dec 2020)", n.name = "SUPERNOVA", n.ontolocy_created = "2026-06-18T09:26:41.347456000", n.ontolocy_merged = "2026-06-18T09:26:41.347456000", n.ref_url = "https://attack.mitre.org/software/S0578", n.stix_created = "2021-02-18T17:35:13.361000000+00:00", n.stix_id = "malware--b2b0b946-be0a-4a7f-9c32-a2e5211d1cd9", n.stix_modified = "2024-04-10T23:45:34.261000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

