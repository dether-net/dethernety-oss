SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[InnaputRAT](https://attack.mitre.org/software/S0259) is a remote access tool that can exfiltrate files from a victim's machine. [InnaputRAT](https://attack.mitre.org/software/S0259) has been seen out in the wild since 2016. (Citation: ASERT InnaputRAT April 2018)", n.name = "InnaputRAT", n.ontolocy_created = "2026-06-18T09:26:41.382383000", n.ontolocy_merged = "2026-06-18T09:26:41.382383000", n.ref_url = "https://attack.mitre.org/software/S0259", n.stix_created = "2018-10-17T00:14:20.652000000+00:00", n.stix_id = "malware--c8b6cc43-ce61-42ae-87f3-a5f10526f952", n.stix_modified = "2025-04-25T14:44:39.436000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S1115"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[WIREFIRE](https://attack.mitre.org/software/S1115) is a web shell written in Python that exists as trojanized logic to the visits.py component of Ivanti Connect Secure VPN appliances. [WIREFIRE](https://attack.mitre.org/software/S1115) was used during [Cutting Edge](https://attack.mitre.org/campaigns/C0029) for downloading files and command execution.(Citation: Mandiant Cutting Edge January 2024)", n.name = "WIREFIRE", n.ontolocy_created = "2026-06-18T09:26:41.382952000", n.ontolocy_merged = "2026-06-18T09:26:41.382952000", n.ref_url = "https://attack.mitre.org/software/S1115", n.stix_created = "2024-03-04T21:40:28.083000000+00:00", n.stix_id = "malware--c93e3079-43fb-4d8d-9e99-db63d07eadc9", n.stix_modified = "2025-04-15T19:46:35.314000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0487"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[Kessel](https://attack.mitre.org/software/S0487) is an advanced version of OpenSSH which acts as a custom backdoor, mainly acting to steal credentials and function as a bot. [Kessel](https://attack.mitre.org/software/S0487) has been active since its C2 domain began resolving in August 2018.(Citation: ESET ForSSHe December 2018)", n.name = "Kessel", n.ontolocy_created = "2026-06-18T09:26:41.383516000", n.ontolocy_merged = "2026-06-18T09:26:41.383516000", n.ref_url = "https://attack.mitre.org/software/S0487", n.stix_created = "2020-07-16T15:14:25.631000000+00:00", n.stix_id = "malware--c984b414-b766-44c5-814a-2fe96c913c12", n.stix_modified = "2024-04-11T01:48:38.105000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0632"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[GrimAgent](https://attack.mitre.org/software/S0632) is a backdoor that has been used before the deployment of [Ryuk](https://attack.mitre.org/software/S0446) ransomware since at least 2020; it is likely used by [FIN6](https://attack.mitre.org/groups/G0037) and [Wizard Spider](https://attack.mitre.org/groups/G0102).(Citation: Group IB GrimAgent July 2021)", n.name = "GrimAgent", n.ontolocy_created = "2026-06-18T09:26:41.384084000", n.ontolocy_merged = "2026-06-18T09:26:41.384084000", n.ref_url = "https://attack.mitre.org/software/S0632", n.stix_created = "2021-07-16T18:19:25.986000000+00:00", n.stix_id = "malware--c9b99d03-ff11-4a48-95f0-82660d582c25", n.stix_modified = "2024-09-19T14:32:39.426000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0582"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[LookBack](https://attack.mitre.org/software/S0582) is a remote access trojan written in C++ that was used against at least three US utility companies in July 2019. The TALONITE activity group has been observed using [LookBack](https://attack.mitre.org/software/S0582).(Citation: Proofpoint LookBack Malware Aug 2019)(Citation: Dragos TALONITE)(Citation: Dragos Threat Report 2020)", n.name = "LookBack", n.ontolocy_created = "2026-06-18T09:26:41.384654000", n.ontolocy_merged = "2026-06-18T09:26:41.384654000", n.ref_url = "https://attack.mitre.org/software/S0582", n.stix_created = "2021-03-01T14:07:36.692000000+00:00", n.stix_id = "malware--c9ccc4df-1f56-49e7-ad57-b383e1451688", n.stix_modified = "2025-04-25T14:44:40.541000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

