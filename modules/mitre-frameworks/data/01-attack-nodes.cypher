ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[Lumma Stealer](https://attack.mitre.org/software/S1213) is an information stealer malware family in use since at least 2022. [Lumma Stealer](https://attack.mitre.org/software/S1213) is a Malware as a Service (MaaS) where captured data has been sold in criminal markets to Initial Access Brokers.(Citation: Cybereason LumaStealer Undated)(Citation: Netskope LummaStealer 2025)(Citation: Qualys LummaStealer 2024)(Citation: Fortinet LummaStealer 2024)(Citation: TrendMicro LummaStealer 2025)", n.name = "Lumma Stealer", n.ontolocy_created = "2026-06-18T09:26:41.223991000", n.ontolocy_merged = "2026-06-18T09:26:41.223991000", n.ref_url = "https://attack.mitre.org/software/S1213", n.stix_created = "2025-03-22T15:05:50.305000000+00:00", n.stix_id = "malware--674c514f-e485-47a8-9d49-1aaa70de155b", n.stix_modified = "2025-03-22T16:02:03.819000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

