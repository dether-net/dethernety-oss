SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[RDAT](https://attack.mitre.org/software/S0495) is a backdoor used by the suspected Iranian threat group [OilRig](https://attack.mitre.org/groups/G0049). [RDAT](https://attack.mitre.org/software/S0495) was originally identified in 2017 and targeted companies in the telecommunications sector.(Citation: Unit42 RDAT July 2020)", n.name = "RDAT", n.ontolocy_created = "2026-06-18T09:26:41.156898000", n.ontolocy_merged = "2026-06-18T09:26:41.156898000", n.ref_url = "https://attack.mitre.org/software/S0495", n.stix_created = "2020-07-28T17:26:36.168000000+00:00", n.stix_id = "malware--4b346d12-7f91-48d2-8f06-b26ffa0d825b", n.stix_modified = "2025-04-25T14:43:13.198000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

