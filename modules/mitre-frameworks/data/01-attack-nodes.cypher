ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.4", n.description = "[dsquery](https://attack.mitre.org/software/S0105) is a command-line utility that can be used to query Active Directory for information from a system within a domain. (Citation: TechNet Dsquery) It is typically installed only on Windows Server versions but can be installed on non-server variants through the Microsoft-provided Remote Server Administration Tools bundle.", n.name = "dsquery", n.ontolocy_created = "2026-06-18T09:26:41.488585000", n.ontolocy_merged = "2026-06-18T09:26:41.488585000", n.ref_url = "https://attack.mitre.org/software/S0105", n.stix_created = "2017-05-31T21:33:04.937000000+00:00", n.stix_id = "tool--38952eac-cb1b-4a71-bad2-ee8223a1c8fe", n.stix_modified = "2025-04-16T20:38:51.407000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "tool";

