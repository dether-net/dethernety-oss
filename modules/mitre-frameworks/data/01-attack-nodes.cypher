ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[cipher.exe](https://attack.mitre.org/software/S1205) is a native Microsoft utility that manages encryption of directories and files on NTFS (New Technology File System) partitions by using the Encrypting File System (EFS).(Citation: cipher.exe)", n.name = "cipher.exe", n.ontolocy_created = "2026-06-18T09:26:41.525432000", n.ontolocy_merged = "2026-06-18T09:26:41.525432000", n.ref_url = "https://attack.mitre.org/software/S1205", n.stix_created = "2025-02-25T17:31:00.202000000+00:00", n.stix_id = "tool--da66959d-9875-4fde-bfed-11111a55895e", n.stix_modified = "2025-03-10T19:48:40.412000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "tool";

