SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.3", n.description = "[BISCUIT](https://attack.mitre.org/software/S0017) is a backdoor that has been used by [APT1](https://attack.mitre.org/groups/G0006) since as early as 2007. (Citation: Mandiant APT1)", n.name = "BISCUIT", n.ontolocy_created = "2026-06-18T09:26:41.358871000", n.ontolocy_merged = "2026-06-18T09:26:41.358871000", n.ref_url = "https://attack.mitre.org/software/S0017", n.stix_created = "2017-05-31T21:32:17.147000000+00:00", n.stix_id = "malware--b8eb28e4-48a6-40ae-951a-328714f75eda", n.stix_modified = "2023-12-26T19:55:54.853000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

