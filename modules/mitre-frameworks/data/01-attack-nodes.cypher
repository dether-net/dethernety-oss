SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[CloudDuke](https://attack.mitre.org/software/S0054) is malware that was used by [APT29](https://attack.mitre.org/groups/G0016) in 2015. (Citation: F-Secure The Dukes) (Citation: Securelist Minidionis July 2015)", n.name = "CloudDuke", n.ontolocy_created = "2026-06-18T09:26:41.389390000", n.ontolocy_merged = "2026-06-18T09:26:41.389390000", n.ref_url = "https://attack.mitre.org/software/S0054", n.stix_created = "2017-05-31T21:32:38.128000000+00:00", n.stix_id = "malware--cbf646f1-7db5-4dc6-808b-0094313949df", n.stix_modified = "2025-04-25T14:44:42.958000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0554"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[Egregor](https://attack.mitre.org/software/S0554) is a Ransomware-as-a-Service (RaaS) tool that was first observed in September 2020. Researchers have noted code similarities between [Egregor](https://attack.mitre.org/software/S0554) and Sekhmet ransomware, as well as [Maze](https://attack.mitre.org/software/S0449) ransomware.(Citation: NHS Digital Egregor Nov 2020)(Citation: Cyble Egregor Oct 2020)(Citation: Security Boulevard Egregor Oct 2020)", n.name = "Egregor", n.ontolocy_created = "2026-06-18T09:26:41.389954000", n.ontolocy_merged = "2026-06-18T09:26:41.389954000", n.ref_url = "https://attack.mitre.org/software/S0554", n.stix_created = "2020-12-29T21:32:27.939000000+00:00", n.stix_id = "malware--cc4c1287-9c86-4447-810c-744f3880ec37", n.stix_modified = "2025-04-25T14:44:43.318000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0428"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "2.3", n.description = "[PoetRAT](https://attack.mitre.org/software/S0428) is a remote access trojan (RAT) that was first identified in April 2020. [PoetRAT](https://attack.mitre.org/software/S0428) has been used in multiple campaigns against the private and public sectors in Azerbaijan, including ICS and SCADA systems in the energy sector. The STIBNITE activity group has been observed using the malware. [PoetRAT](https://attack.mitre.org/software/S0428) derived its name from references in the code to poet William Shakespeare. (Citation: Talos PoetRAT April 2020)(Citation: Talos PoetRAT October 2020)(Citation: Dragos Threat Report 2020)", n.name = "PoetRAT", n.ontolocy_created = "2026-06-18T09:26:41.390959000", n.ontolocy_merged = "2026-06-18T09:26:41.390959000", n.ref_url = "https://attack.mitre.org/software/S0428", n.stix_created = "2020-04-27T20:21:16.487000000+00:00", n.stix_id = "malware--cc5497f7-a9e8-436f-94da-b2b4a9b9ad3c", n.stix_modified = "2024-08-05T18:24:31.652000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S0023"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "2.3", n.description = "[CHOPSTICK](https://attack.mitre.org/software/S0023) is a malware family of modular backdoors used by [APT28](https://attack.mitre.org/groups/G0007). It has been used since at least 2012 and is usually dropped on victims as second-stage malware, though it has been used as first-stage malware in several cases. It has both Windows and Linux variants. (Citation: FireEye APT28) (Citation: ESET Sednit Part 2) (Citation: FireEye APT28 January 2017) (Citation: DOJ GRU Indictment Jul 2018) It is tracked separately from the [X-Agent for Android](https://attack.mitre.org/software/S0314).", n.name = "CHOPSTICK", n.ontolocy_created = "2026-06-18T09:26:41.391551000", n.ontolocy_merged = "2026-06-18T09:26:41.391551000", n.ref_url = "https://attack.mitre.org/software/S0023", n.stix_created = "2017-05-31T21:32:19.389000000+00:00", n.stix_id = "malware--ccd61dfc-b03f-4689-8c18-7c97eab08472", n.stix_modified = "2024-11-17T14:43:38.592000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

MERGE (n:MitreAttackSoftware {attack_id: "S1200"})
ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[StealBit](https://attack.mitre.org/software/S1200) is a data exfiltration tool that is developed and maintained by the operators of the the LockBit Ransomware-as-a-Service (RaaS) and offered to affiliates to exfiltrate data from compromised systems for double extortion purposes.(Citation: Cybereason StealBit Exfiltration Tool)(Citation: FBI Lockbit 2.0 FEB 2022)", n.name = "StealBit", n.ontolocy_created = "2026-06-18T09:26:41.392149000", n.ontolocy_merged = "2026-06-18T09:26:41.392149000", n.ref_url = "https://attack.mitre.org/software/S1200", n.stix_created = "2025-01-29T20:13:25.762000000+00:00", n.stix_id = "malware--cf8b27df-c494-4a0c-b093-556a80ad2bcf", n.stix_modified = "2025-01-29T20:17:12.643000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "malware";

