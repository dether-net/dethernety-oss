ON CREATE SET n.id = randomUUID()
SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[SILENTTRINITY](https://attack.mitre.org/software/S0692) is an open source remote administration and post-exploitation framework primarily written in Python that includes stagers written in Powershell, C, and Boo. [SILENTTRINITY](https://attack.mitre.org/software/S0692) was used in a 2019 campaign against Croatian government agencies by unidentified cyber actors.(Citation: GitHub SILENTTRINITY March 2022)(Citation: Security Affairs SILENTTRINITY July 2019)", n.name = "SILENTTRINITY", n.ontolocy_created = "2026-06-18T09:26:41.478683000", n.ontolocy_merged = "2026-06-18T09:26:41.478683000", n.ref_url = "https://attack.mitre.org/software/S0692", n.stix_created = "2022-03-23T19:34:30.486000000+00:00", n.stix_id = "tool--1244e058-fa10-48cb-b484-0bcf671107ae", n.stix_modified = "2025-04-30T13:26:45.728000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "tool";

