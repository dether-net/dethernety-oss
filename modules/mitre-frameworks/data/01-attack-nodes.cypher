SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "2.0", n.description = "[SEASHARPEE](https://attack.mitre.org/software/S0185) is a Web shell that has been used by [OilRig](https://attack.mitre.org/groups/G0049). (Citation: FireEye APT34 Webinar Dec 2017)", n.name = "SEASHARPEE", n.ontolocy_created = "2026-06-18T09:26:41.040255000", n.ontolocy_merged = "2026-06-18T09:26:41.040255000", n.ref_url = "https://attack.mitre.org/software/S0185", n.stix_created = "2018-01-16T16:13:52.465000000+00:00", n.stix_id = "malware--0998045d-f96e-4284-95ce-3c8219707486", n.stix_modified = "2025-04-25T14:42:37.580000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

