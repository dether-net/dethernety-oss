SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.0", n.description = "[Kivars](https://attack.mitre.org/software/S0437) is a modular remote access tool (RAT), derived from the Bifrost RAT, that was used by [BlackTech](https://attack.mitre.org/groups/G0098) in a 2010 campaign.(Citation: TrendMicro BlackTech June 2017)", n.name = "Kivars", n.ontolocy_created = "2026-06-18T09:26:41.348639000", n.ontolocy_merged = "2026-06-18T09:26:41.348639000", n.ref_url = "https://attack.mitre.org/software/S0437", n.stix_created = "2020-05-06T18:10:59.143000000+00:00", n.stix_id = "malware--b2d134a1-7bd5-4293-94d4-8fc978cb1cd7", n.stix_modified = "2025-04-25T14:44:27.009000000+00:00", n.stix_spec_version = "2.1", n.stix_type = "malware";

