SET n.attack_deprecated = false, n.attack_spec_version = "3.2.0", n.attack_version = "1.1", n.description = "[Imminent Monitor](https://attack.mitre.org/software/S0434) was a commodity remote access tool (RAT) offered for sale from 2012 until 2019, when an operation was conducted to take down the Imminent Monitor infrastructure. Various cracked versions and variations of this RAT are still in circulation.(Citation: Imminent Unit42 Dec2019)", n.name = "Imminent Monitor", n.ontolocy_created = "2026-06-18T09:26:41.503429000", n.ontolocy_merged = "2026-06-18T09:26:41.503429000", n.ref_url = "https://attack.mitre.org/software/S0434", n.stix_created = "2020-05-05T18:45:36.358000000+00:00", n.stix_id = "tool--8f8cd191-902c-4e83-bf20-b57c8c4640e9", n.stix_modified = "2023-10-03T19:35:03.646000000+00:00", n.stix_revoked = false, n.stix_spec_version = "2.1", n.stix_type = "tool";

