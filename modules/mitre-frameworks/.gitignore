# Generated data files
#
# The graph export (01/02/03, ATLAS 06/07/08) and the Memgraph embeddings (05,
# ATLAS 09; manifest.json's embeddingProfile, 768 dimensions) ARE committed so a
# fresh checkout needn't regenerate the corpus on every build. Regenerate with
# `pnpm build:data` (needs Docker, and the profile's embedder: see
# scripts/build-data.sh) only when the MITRE source or the embedding profile changes.
#
# NOT committed:
#   - data/.embedding-cache/      build-time idempotency cache, not a deliverable
#   - data/04-mitre-vectors.sql   32 MB OpenAI pgvector dump; rebuilt on demand
#                                 with OPENAI_API_KEY (separate model + consumer)
data/.embedding-cache/
data/04-mitre-vectors.sql

# Build output
dist/

# Python environment
.venv/
__pycache__/
*.pyc
