{
  "name": "@dether.net/dethereal",
  "version": "0.6.0-dev.0",
  "description": "Dethereal - AI-guided threat modeling with Dethernety: an MCP server with skills and agents for AI coding assistants",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "dethereal": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "tsx src/generator/cli.ts --package-root && pnpm --filter @dethernety/dt-core build && tsup",
    "build:types": "tsc --emitDeclarationOnly",
    "dev": "tsc -w",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "test": "vitest run",
    "golden:update": "tsx src/generator/cli.ts --update-goldens"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    ".claude-plugin",
    "bundles/claude",
    "bundles/codex",
    "bundles/opencode",
    "src/utils/source-globs.v1.json"
  ],
  "devDependencies": {
    "@apollo/client": "4.3.8",
    "@dethernety/dt-core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "^25.9.9",
    "graphql": "16.15.0",
    "graphql-tag": "2.12.7",
    "jsonc-parser": "3.3.1",
    "rxjs": "7.8.2",
    "smol-toml": "1.8.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1",
    "zod": "4.6.7"
  },
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20.11.1"
  }
}
