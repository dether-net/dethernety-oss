// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderModelDiagram > draws nested boundaries, and a flow across them 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" class="rk-diagram rk-dg-N" viewBox="-24 -24 828 448" width="100%" preserveAspectRatio="xMidYMid meet" role="img"><style>.rk-dg-N .b{fill:none;stroke:#666666;stroke-width:1.5;stroke-dasharray:6 4}.rk-dg-N .b.hl{stroke:#1565c0;stroke-width:3;stroke-dasharray:none}.rk-dg-N .bl{fill:#222222;font:600 12px sans-serif}.rk-dg-N .n{fill:#f4f4f4;stroke:#222222;stroke-width:1.5}.rk-dg-N .n.hl{stroke:#1565c0;stroke-width:3.5}.rk-dg-N .nf{fill:#f4f4f4;stroke:none}.rk-dg-N .s{stroke:#222222;stroke-width:2}.rk-dg-N .s.hl{stroke:#1565c0;stroke-width:3.5}.rk-dg-N .nl{fill:#222222;font:12px sans-serif;text-anchor:middle}.rk-dg-N .f{fill:none;stroke:#555555;stroke-width:1.5}.rk-dg-N .ah{fill:#555555}.rk-dg-N .mk{fill:#1565c0;font:bold 16px sans-serif;text-anchor:middle}</style><defs><marker id="rk-dg-N-arrow" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path class="ah" d="M0,0 L10,5 L0,10 z"/></marker></defs><rect class="b" x="0" y="0" width="600" height="400" rx="6"/><text class="bl" x="8" y="18">Cloud</text><rect class="b" x="50" y="60" width="300" height="200" rx="6"/><text class="bl" x="58" y="78">VPC</text><line class="f" x1="700" y1="140" x2="160" y2="140" marker-end="url(#rk-dg-N-arrow)"/><rect class="n" x="700" y="100" width="80" height="80"/><text class="nl" x="740" y="196">User</text><circle class="n" cx="120" cy="140" r="40"/><text class="nl" x="120" y="196">API</text></svg>"`;

exports[`renderModelDiagram > draws one boundary with its components and a flow 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" class="rk-diagram rk-dg-N" viewBox="76 26 448 348" width="100%" preserveAspectRatio="xMidYMid meet" role="img"><style>.rk-dg-N .b{fill:none;stroke:#666666;stroke-width:1.5;stroke-dasharray:6 4}.rk-dg-N .b.hl{stroke:#1565c0;stroke-width:3;stroke-dasharray:none}.rk-dg-N .bl{fill:#222222;font:600 12px sans-serif}.rk-dg-N .n{fill:#f4f4f4;stroke:#222222;stroke-width:1.5}.rk-dg-N .n.hl{stroke:#1565c0;stroke-width:3.5}.rk-dg-N .nf{fill:#f4f4f4;stroke:none}.rk-dg-N .s{stroke:#222222;stroke-width:2}.rk-dg-N .s.hl{stroke:#1565c0;stroke-width:3.5}.rk-dg-N .nl{fill:#222222;font:12px sans-serif;text-anchor:middle}.rk-dg-N .f{fill:none;stroke:#555555;stroke-width:1.5}.rk-dg-N .ah{fill:#555555}.rk-dg-N .mk{fill:#1565c0;font:bold 16px sans-serif;text-anchor:middle}</style><defs><marker id="rk-dg-N-arrow" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path class="ah" d="M0,0 L10,5 L0,10 z"/></marker></defs><rect class="b" x="100" y="50" width="400" height="300" rx="6"/><text class="bl" x="108" y="68">DMZ</text><line class="f" x1="216.5" y1="166.3" x2="320" y2="212.6" marker-end="url(#rk-dg-N-arrow)"/><circle class="n" cx="180" cy="150" r="40"/><text class="nl" x="180" y="206">Web</text><rect class="nf" x="320" y="210" width="100" height="50"/><line class="s" x1="320" y1="210" x2="420" y2="210"/><line class="s" x1="320" y1="260" x2="420" y2="260"/><text class="nl" x="370" y="276">DB</text></svg>"`;

exports[`renderModelDiagram > sizes a boundary without stored dimensions from its children, keeping children at negative positions inside 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" class="rk-diagram rk-dg-N" viewBox="92 100 356 346" width="100%" preserveAspectRatio="xMidYMid meet" role="img"><style>.rk-dg-N .b{fill:none;stroke:#666666;stroke-width:1.5;stroke-dasharray:6 4}.rk-dg-N .b.hl{stroke:#1565c0;stroke-width:3;stroke-dasharray:none}.rk-dg-N .bl{fill:#222222;font:600 12px sans-serif}.rk-dg-N .n{fill:#f4f4f4;stroke:#222222;stroke-width:1.5}.rk-dg-N .n.hl{stroke:#1565c0;stroke-width:3.5}.rk-dg-N .nf{fill:#f4f4f4;stroke:none}.rk-dg-N .s{stroke:#222222;stroke-width:2}.rk-dg-N .s.hl{stroke:#1565c0;stroke-width:3.5}.rk-dg-N .nl{fill:#222222;font:12px sans-serif;text-anchor:middle}.rk-dg-N .f{fill:none;stroke:#555555;stroke-width:1.5}.rk-dg-N .ah{fill:#555555}.rk-dg-N .mk{fill:#1565c0;font:bold 16px sans-serif;text-anchor:middle}</style><defs><marker id="rk-dg-N-arrow" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path class="ah" d="M0,0 L10,5 L0,10 z"/></marker></defs><rect class="b" x="116" y="124" width="308" height="298" rx="6"/><text class="bl" x="124" y="142">Auto</text><circle class="n" cx="180" cy="200" r="40"/><text class="nl" x="180" y="256">A</text><circle class="n" cx="360" cy="330" r="40"/><text class="nl" x="360" y="386">Z</text></svg>"`;
