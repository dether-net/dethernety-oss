# Dethernety Frontend Environment Configuration (development)
#
# Copy this file to .env.local for the development server (`pnpm dev`), which reads only
# VITE_-prefixed keys. A production build reads its configuration only from the backend's
# GET /config at run time, so production settings belong in the backend's environment (see
# docs/CONFIGURATION_GUIDE.md). When that cannot be read, the UI stops on the
# configuration-unavailable screen. VITE_BASE_PATH is not part of that configuration: the Vite
# config reads it from the build's shell environment (see Application below).

# =============================================================================
# Authentication
# =============================================================================
# Single-user development without authentication: uncomment VITE_ENABLE_NOAUTH=true and
# comment out VITE_OIDC_ISSUER below (the backend must run without authentication too).
# VITE_ENABLE_NOAUTH=true

# OIDC: these must be coordinated with the backend's OIDC_JWKS_URI setting.
VITE_OIDC_ISSUER=http://localhost:8080
VITE_OIDC_CLIENT_ID=your-development-client-id
VITE_OIDC_REDIRECT_URI=http://localhost:3005/auth/callback

# OIDC provider (optional; detected from the issuer URL when unset)
# Options: cognito, zitadel, auth0, keycloak, generic
# VITE_OIDC_PROVIDER=cognito

# Scope requested at sign-in (optional; default: openid profile email)
# VITE_OIDC_SCOPE=openid profile email

# Hosted sign-in domain, when it differs from the issuer (optional; for example Cognito)
# VITE_OIDC_DOMAIN=https://your-domain.auth.eu-central-1.amazoncognito.com

# =============================================================================
# API
# =============================================================================
VITE_API_BASE_URL=http://localhost:3003
VITE_GRAPHQL_URL=http://localhost:3003/graphql

# Subscription transport: 'sse' (default) or 'ws' (WebSocket)
# SSE is simpler (works through proxies, no sticky sessions needed);
# WebSocket provides lower latency but needs more infrastructure.
VITE_SUBSCRIPTION_TRANSPORT=sse

# WebSocket URL (only used when VITE_SUBSCRIPTION_TRANSPORT=ws)
VITE_GRAPHQL_WS_URL=ws://localhost:3003/graphql

# =============================================================================
# Application
# =============================================================================
# Read into the configuration but not used by the application yet. To serve the UI under a
# subdirectory, set VITE_BASE_PATH in the shell environment of the build: the Vite config reads
# it from there, not from this file.
# The UI still requests /config at the root of the origin, so it must be served there.
VITE_APP_BASE_URL=/

# Application URL (used for OIDC redirects)
VITE_APP_URL=http://localhost:3005

# Optional external links. Left empty, the item is hidden. An http(s) URL or a same-origin path.
VITE_SETTINGS_URL=
# VITE_USER_PROFILE_URL=

# =============================================================================
# Debug
# =============================================================================
# Read into the configuration but not used by the application yet.
VITE_DEBUG_AUTH=true
VITE_ENABLE_DEV_TOOLS=true
