# Dethernety deployment configuration.
#
#   ./byodt up                first run sets this file up and starts the stack
#   (edit this file, then `./byodt up` again to apply)
#
# This file is also the release manifest: the five image/version keys below name
# the tested set that ship together. Their NAMES are a contract — the console
# writes these exact keys and nothing else in this layer, so renaming one is a
# breaking change. Keep boolean values spelled exactly `true` / `false`.

# --- The tested set (image/version keys) -----------------------------------
# All artifacts of a release move together under one version. The platform image
# is pinned by version; the other three are full references so they can be
# repointed at a mirror the operator's runtime can reach.
#
# DB_IMAGE, OLLAMA_IMAGE and PROXY_IMAGE name third-party images that your
# container runtime pulls directly from their publishers — referenced here, not
# redistributed by this bundle. See NOTICE for their licenses and provenance.
PLATFORM_VERSION=0.5.0
# Memgraph is licensed BSL 1.1 — keep this default on Memgraph's own namespace so
# the bundle only references it, never redistributes it. You may repoint to a
# mirror you operate; BSL's production-use terms are then yours to satisfy.
DB_IMAGE=memgraph/memgraph:3.8.1
OLLAMA_IMAGE=ollama/ollama:0.32.6
PROXY_IMAGE=nginx:1.27-alpine
# The console image — same release, one version, published on the release path
# alongside the platform image (see the Docker workflow).
CONSOLE_IMAGE=ghcr.io/dether-net/byodt-console:0.5.0

# --- Container engine -------------------------------------------------------
# Which engine runs the stack. Unset (the default) auto-detects on the first
# `./byodt up` — Docker first, then Podman — and records the choice below so every
# later command uses the same one. Set it to force the engine (here, or export it):
#   CONTAINER_ENGINE=docker
#   CONTAINER_ENGINE=podman
# The wrapper invokes "<engine> compose", so it needs Docker with the Compose plugin,
# or Podman 4.1+ with a Compose provider (it brokers to Docker Compose v2 if present,
# else podman-compose). On macOS, Podman also needs its machine running first:
# `podman machine start`.
# CONTAINER_ENGINE=

# --- Front door -------------------------------------------------------------
# 3000 is a pre-registered loopback callback, so a laptop deployment needs no
# identity-provider callback registration. Do not renumber it to 80 without
# understanding that trade-off. This is the only published port; the operator
# console is served through it at /console/, on the same origin.
FRONT_DOOR_PORT=3000
# Bind to loopback: single-tenant, unauthenticated at the edge. Set 0.0.0.0 only
# behind your own authenticated front door.
FRONT_DOOR_BIND=127.0.0.1

# --- Authentication ---------------------------------------------------------
# The platform's authentication posture is NOT set here — it is owned by the mode
# layer the console writes (mode/mode.env, seeded on the first `./byodt up`). Pure
# open-source, no-auth is the local-evaluation default; connect the deployment to the
# cloud in the console to enable authentication. Either way it is applied on `./byodt up`.

# --- Database ---------------------------------------------------------------
# The password is NOT stored here — `byodt bootstrap` (run for you by `byodt up`)
# generates it into .env.secrets (mode 0600). Username and database name are not secret.
NEO4J_USERNAME=dethernety
NEO4J_DATABASE=memgraph
# Where the database keeps its data:
#   ./data/memgraph  (default) a host bind mount — visible on disk, easy to inspect and copy;
#                    ideal on native-Linux Docker.
#   memgraph-data    the named volume declared in compose.yaml — lives in the container engine's
#                    own storage, which avoids the file-sharing corruption a host bind mount can
#                    suffer on VM-backed runtimes (Podman machine / Docker Desktop on macOS/Windows).
#                    Trade-off: you can't browse it from the host, and `byodt backup` copies through
#                    the container. Switching is a fresh database — the two are separate stores.
# Applied on `byodt restart db`.
DB_DATA=./data/memgraph

# --- Embedding --------------------------------------------------------------
# The model Ollama serves and the platform queries. The similarity threshold is
# model-dependent; the default is tuned for the default model.
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_SIMILARITY_THRESHOLD=0.40

# --- Snapshots --------------------------------------------------------------
# How often (seconds) the database writes an automatic in-place snapshot, for crash recovery.
# 0 disables them. These snapshots live in the data dir and are pruned by retention — they are
# NOT a substitute for `byodt backup`, which captures one and copies it out to backups/.
# Applied on `byodt restart db`.
SNAPSHOT_INTERVAL_SEC=300

# --- Module source ----------------------------------------------------------
# Where console-init fetches the signed code-module payloads from. The console
# resolves the release by PLATFORM_VERSION; it never picks a version of its own.
CONSOLE_RELEASE_BASE_URL=https://github.com/dether-net/dethernety-oss

# --- Platform "Settings" link -----------------------------------------------
# The platform sidebar shows a "Settings" item linking here; it defaults to the
# operator console on this same origin. Uncomment to override (e.g. front the
# console on another host), or set empty to hide the link.
# SETTINGS_URL=/console/
