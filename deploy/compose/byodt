#!/usr/bin/env bash
# byodt — manage this Dethernety deployment.
#
# A thin, verb-driven wrapper over Docker or Podman Compose for the compose bundle: it carries the two env
# files every command needs (.env + .env.secrets), folds in first-run setup, and gives the common
# operations plain names. Run it from anywhere — it operates on the bundle it lives in.
#
#   ./byodt up        # bootstrap (first run) + start
#   ./byodt help      # all commands
set -euo pipefail
# An inherited `allexport` would hand every variable byodt sets, the proxy login among them, to each child.
set +a

# The proxy login an installer hands to `setup`. It is read once and taken out of the environment before anything else
# runs, so no process byodt starts inherits it.
SETUP_PROXY_LOGIN="${BYODT_SETUP_PROXY_USERINFO-}"
unset BYODT_SETUP_PROXY_USERINFO
# The directory byodt was run from, for a path an operator gives relative to it (setup's --proxy-ca).
readonly CALLER_DIR="$PWD"

cd "$(dirname "$0")"

readonly BYODT_VERSION="1.4.0"
readonly ENV_FILE=".env"
readonly SECRETS_FILE=".env.secrets"
readonly MODE_FILE="mode/mode.env"
# The database image this bundle was tested with. DB_IMAGE in .env is copied once from .env.example and
# kept across upgrades, so a deployment can run another database than the bundle was tested with.
readonly TESTED_DB_IMAGE="docker.io/memgraph/memgraph:3.13.2"
# The Neo4j image this bundle was tested with, used when DB_ENGINE=neo4j. NEO4J_IMAGE in .env overrides it.
readonly TESTED_NEO4J_IMAGE="docker.io/library/neo4j:5.26.32-community"
# The shortest Memgraph password byodt treats as a long random value: Memgraph stores it with a fast hash (see
# compose.memgraph.yaml). byodt generates 48 characters.
readonly MIN_DB_PASSWORD_LENGTH=32
# The embedding model the platform downloads on its first start: its Hugging Face repository and revision, as the
# platform's default profile pins them (the release checks they agree).
readonly TESTED_MODEL="onnx-community/embeddinggemma-300m-ONNX@5090578d9565bb06545b4552f76e6bc2c93e4a66"
# The third-party notice (its versioned text, shipped in the bundle) and the record of its confirmations.
# Not readonly: a staged upgrade reads the new release's copy.
ACK_FILE="THIRD-PARTY-ACKNOWLEDGEMENT"
readonly ACK_LOG="third-party-acknowledgement.log"
readonly ACK_MAX_BYTES=16384
# --yes, for the commands that take it: ask nothing, take the defaults, and count the third-party notice as confirmed.
YES=""
# How the operator ran byodt, so the commands its messages suggest work from where they ran it. Every byodt this one
# runs gets it in BYODT_SELF. A name with no slash is byodt run by name from its own folder.
SELF="${BYODT_SELF:-$0}"
case "$SELF" in */*) ;; *) SELF="./$SELF" ;; esac
export BYODT_SELF="$SELF"

# --- output -------------------------------------------------------------------
if [ -t 1 ]; then
  BOLD=$(printf '\033[1m'); RED=$(printf '\033[31m'); GRN=$(printf '\033[32m'); YEL=$(printf '\033[33m'); RST=$(printf '\033[0m')
else
  BOLD=""; RED=""; GRN=""; YEL=""; RST=""
fi
info() { printf '%s==>%s %s\n' "$GRN" "$RST" "$*"; }
warn() { printf '%swarning:%s %s\n' "$YEL" "$RST" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$RED" "$RST" "$*" >&2; exit 1; }

# --- helpers ------------------------------------------------------------------

# compose — the single chokepoint every compose invocation goes through.
#
# ONE --env-file, never two. Docker Compose v2 merges repeated --env-file flags; podman-compose
# honours only the LAST, which silently dropped .env and left every interpolated value empty —
# images, the published port, the database user, all of it. What made that read as an image
# problem rather than a total one is that the values carrying a `:-default` in compose.yaml fell
# back and looked healthy, so only the defaulted-less ones showed as blank.
#
# So .env is the one file passed, and the two values compose needs that are not in it are exported
# into the environment instead — process environment outranks --env-file in both providers:
#
#   NEO4J_PASSWORD  lives in .env.secrets (mode 0600). Exporting it keeps it out of any file
#                   sitting beside the readable config, which merging the two would have created.
#   CONSOLE_IMAGE   is derived here because compose.yaml cannot derive it: podman-compose does not
#                   expand a nested ${VAR} inside a `:-default`, so a self-referencing default
#                   reached the engine as a literal. Deriving it host-side keeps PLATFORM_VERSION
#                   the single version knob without depending on nested interpolation.
#   NEO4J_IMAGE     the same way, for the Neo4j database service.
#   BYODT_*_PROXY   the outbound proxy, settled by resolve_proxy from .env and .env.secrets: the URL
#                   can carry the proxy's login, and NO_PROXY is the operator's hosts plus the stack's
#                   own names, which compose.yaml cannot append without nesting.
#   BYODT_NODE_USE_ENV_PROXY  1 when there is a proxy, empty otherwise: the platform's Node reads the
#                   proxy variables only when it is 1.
#
# The files are named, never discovered: compose.yaml, then the database service of the engine
# DB_ENGINE names (compose.memgraph.yaml or compose.neo4j.yaml), then compose.override.yaml when the
# operator keeps local changes there. Naming any file stops compose from loading compose.override.yaml
# by itself, so it is passed explicitly, last, which is the order compose would have used (compose_files).
compose() {
  resolve_engine
  local pw img dbu
  local -a files
  compose_files "" yes
  files=("${COMPOSE_FILES[@]}")
  pw="$(secret_value NEO4J_PASSWORD "")"
  img="$(console_image)"
  # The verb is passed to db_user because it decides whether the probe may PULL, not whether it runs.
  # Deriving only for `up` was tried and was wrong: `compose config` is the verb an operator reaches for
  # to see what will actually run, and reporting an empty user there — while `up` quietly used a real
  # one — makes the introspection command lie about the thing it exists to show. CI asserts a non-empty
  # user precisely to catch the derivation silently stopping.
  dbu="$(db_user "${1:-}")"
  NEO4J_PASSWORD="$pw" CONSOLE_IMAGE="$img" NEO4J_IMAGE="$(neo4j_image)" DB_USER="$dbu" \
    BYODT_HTTPS_PROXY="$PROXY_URL" BYODT_NO_PROXY="$PROXY_NO" BYODT_NODE_EXTRA_CA_CERTS="$PROXY_CA" BYODT_SSL_CERT_DIR="$PROXY_CA_DIR" \
    BYODT_NODE_USE_ENV_PROXY="${PROXY_URL:+1}" \
    "$ENGINE" compose --env-file "$ENV_FILE" "${files[@]}" "$@"
}

# compose_files PREFIX WITH-OVERRIDE settles COMPOSE_FILES, the -f arguments for the bundle's files at PREFIX ("" for
# this folder, or a directory with a trailing /): compose.yaml, then the database service of the engine DB_ENGINE names,
# then compose.override.yaml when WITH-OVERRIDE is yes and there is one.
#
# A deployment of a release before 0.13.0 has no engine file: its compose.yaml defines the database itself, and that
# was always Memgraph. An upgrade from one runs this byodt there before the new files are moved in (the database check
# before the graph backup, the notice's reading of compose.override.yaml), and so does a resume before the move has
# brought compose.memgraph.yaml. That layout (pre_engine_layout) gets compose.yaml alone. Any other missing file is
# still named, so compose stops and says which.
COMPOSE_FILES=()
compose_files() {
  COMPOSE_FILES=(-f "${1}compose.yaml")
  pre_engine_layout "$1" || COMPOSE_FILES+=(-f "${1}compose.${DBE}.yaml")
  if [ "$2" = yes ] && [ -f "${1}compose.override.yaml" ]; then COMPOSE_FILES+=(-f "${1}compose.override.yaml"); fi
}

# pre_engine_layout PREFIX: the files at PREFIX are in the layout of a release before 0.13.0. The engine is Memgraph,
# there is nothing at compose.memgraph.yaml, and compose.yaml declares the db service itself: a `db:` key, indented two
# spaces, under the top-level `services:`. Those releases' compose.yaml all do; this bundle's declares no db service,
# so it never matches.
pre_engine_layout() {
  [ "$DBE" = memgraph ] && [ ! -e "${1}compose.memgraph.yaml" ] && [ ! -L "${1}compose.memgraph.yaml" ] \
    && [ -f "${1}compose.yaml" ] || return 1
  awk '/^[^ \t\r#]/ { top = $0 }
       top ~ /^services:[ \t\r]*(#.*)?$/ && /^  db:[ \t\r]*(#.*)?$/ { found = 1; exit }
       END { exit !found }' "${1}compose.yaml"
}

# compose_file_missing prints the first file compose() names here that is not there (a link to nothing counts), and
# nothing when every one is. The callers that hide compose's own message name it instead.
compose_file_missing() {
  local f
  compose_files "" yes
  for f in "${COMPOSE_FILES[@]}"; do
    [ "$f" = -f ] || [ -f "$f" ] || { printf '%s' "$f"; return 0; }
  done
}

# The graph database the stack runs ("memgraph" or "neo4j"), settled once by resolve_db_engine.
DBE=""

# resolve_db_engine settles DBE, before any command runs. Precedence as for the container engine: an exported
# DB_ENGINE (one-off override) > the value recorded in .env > memgraph. It runs in the main shell on purpose: a refusal
# inside $(…) only ends that subshell, so a value checked there would be refused and then used anyway.
resolve_db_engine() {
  local choice="${DB_ENGINE:-}" src="your shell's environment"
  if [ -z "$choice" ]; then choice="$(env_setting DB_ENGINE)"; src="$ENV_FILE"; fi
  case "${choice:-memgraph}" in
    memgraph|neo4j) DBE="${choice:-memgraph}" ;;
    *) die "DB_ENGINE=$choice in $src is not a database this bundle runs — set memgraph or neo4j." ;;
  esac
}

# neo4j_image — the Neo4j image reference: an exported NEO4J_IMAGE, else the one in .env, else the tested one.
neo4j_image() {
  local pin="${NEO4J_IMAGE:-$(env_value NEO4J_IMAGE "")}"
  printf '%s' "${pin:-$TESTED_NEO4J_IMAGE}"
}

# db_data_of ENGINE — where ENGINE keeps its graph: DB_DATA for Memgraph, NEO4J_DATA for Neo4j. A path is a host bind
# mount; anything else names a volume.
db_data_of() {
  case "$1" in
    neo4j) env_value NEO4J_DATA ./data/neo4j ;;
    *)     env_value DB_DATA ./data/memgraph ;;
  esac
}

# db_data_setting — where the chosen engine keeps its graph.
db_data_setting() { db_data_of "$DBE"; }

# db_image — the image of the chosen engine's database.
db_image() {
  case "$DBE" in
    neo4j) neo4j_image ;;
    *)     env_value DB_IMAGE '' ;;
  esac
}

# db_user — the uid:gid the database container runs as. Memgraph refuses to start unless its data
# directory is owned by the uid it runs as; that is an OWNERSHIP check, so no chmod satisfies it, and
# the owner it compares against is whoever the directory appears to belong to INSIDE the container.
#
#   named volume   the engine creates it owned by the image's own user, which already matches.
#                  Empty here, so the image default stands.
#   bind mount     depends on the engine, and it cannot be inferred from the engine's NAME. So this
#                  asks the engine directly, with a throwaway container that stats the directory.
#
# WHY IT IS A PROBE RATHER THAN A RULE. This function used to answer from the engine name: root under
# Podman (rootless maps the operator to root inside), the operator's own uid under Docker. The second
# half is true of Docker Engine on Linux, where uids pass through — and FALSE on Docker Desktop, whose
# VM file-sharing layer presents every bind mount as root-owned no matter who owns it on the host. So
# on macOS and Windows the database was handed a uid that could not match, and refused to start on a
# default deployment. Running as root there is also harmless, because the same sharing layer maps new
# files back to the host user; on native Linux it would litter the host with root-owned data, which is
# why "just use root" is not the fix and the answer has to be per-environment.
#
# THE FAILURE IT PRODUCED IS WORTH KNOWING, because it names the wrong file. As a non-root uid the
# container also cannot write /var/log/memgraph (mode 0750, owned by the image's own user), so the
# database died reporting a log-file permission error — while the actual fault was the data directory's
# ownership, which it could not tell anyone about. Fixing the uid fixes both; a log-directory mount
# fixes neither.
#
# COST, AND THE ONE THING THE VERB DECIDES. The probe is a short-lived container, so it needs the image
# — and on a deployment that has not pulled anything yet, a bare `status` must not become an image
# download. So the verb is consulted for exactly one purpose: `up` is about to pull that image anyway
# and may block on it; every other verb probes only if the image is ALREADY local, and otherwise falls
# back. The value is therefore always derived and never empty, which is what `compose config` shows and
# what CI asserts.
db_user() {
  db_is_bind || { printf ''; return 0; }
  local verb="${1:-}" dir image owner
  dir="$(db_data_setting)"
  image="$(db_image)"
  owner=""
  if [ -n "$image" ] && { [ "$verb" = "up" ] || "$ENGINE" image inspect "$image" >/dev/null 2>&1; }; then
    owner="$("$ENGINE" run --rm -v "$dir:/probe" --entrypoint sh "$image" \
               -c 'stat -c "%u:%g" /probe' 2>/dev/null | tr -d '\r\n')"
  fi
  case "$owner" in
    # Anything else — no image pulled yet, an engine that refuses the mount, a stat that printed
    # nothing — falls back to the old rule rather than failing the command. It is right on Linux and
    # right under Podman, which is where a probe is least likely to be the thing that broke.
    [0-9]*:[0-9]*) printf '%s' "$owner" ;;
    *) case "$ENGINE" in
         podman) printf '0:0' ;;
         *)      printf '%s:%s' "$(id -u)" "$(id -g)" ;;
       esac ;;
  esac
}

# console_image — the console image reference compose is given. An operator's own CONSOLE_IMAGE
# wins (exported, or set in .env) so a mirror stays repointable; otherwise it is the release image
# at PLATFORM_VERSION. The platform image interpolates ${PLATFORM_VERSION} directly in compose.yaml,
# so both images follow the one knob and cannot drift apart.
console_image() {
  local pin
  pin="${CONSOLE_IMAGE:-$(env_value CONSOLE_IMAGE "")}"
  if [ -n "$pin" ]; then
    printf '%s' "$pin"
    return 0
  fi
  printf 'ghcr.io/dether-net/byodt-console:%s' "$(env_value PLATFORM_VERSION "")"
}

# The container engine ("docker" or "podman"), settled once by resolve_engine.
ENGINE=""

# engine_ok NAME — true when NAME is on PATH and its `compose` subcommand runs. The compose
# probe is the point: it rejects a bare engine with no Compose provider, and it is the same
# check used both to auto-detect and to validate an explicit choice.
engine_ok() { command -v "$1" >/dev/null 2>&1 && "$1" compose version >/dev/null 2>&1; }

# resolve_engine settles which engine runs the stack, once, into ENGINE. Precedence: an
# exported CONTAINER_ENGINE (one-off override) > the value persisted in .env > auto-detection,
# Docker first then Podman. Whatever it lands on, it validates that engine's compose is usable,
# so a wrong choice fails here with a clear message instead of deep inside a compose call.
# Persisting a detected value into .env is ensure_engine's job, not this function's.
resolve_engine() {
  [ -n "$ENGINE" ] && return 0
  local choice="${CONTAINER_ENGINE:-}"
  if [ -z "$choice" ] && [ -f "$ENV_FILE" ]; then
    choice="$(env_value CONTAINER_ENGINE "")"
  fi
  if [ -z "$choice" ]; then
    if engine_ok docker; then choice="docker"
    elif engine_ok podman; then choice="podman"
    else die "No usable container engine — install Docker (with the Compose plugin) or Podman 4.1+ (a Compose provider, plus a running machine on macOS), or set CONTAINER_ENGINE in $ENV_FILE."
    fi
  elif ! engine_ok "$choice"; then
    die "CONTAINER_ENGINE=$choice, but '$choice compose' failed — check that $choice and its Compose provider are installed, and (macOS/Podman) that its machine is running ('podman machine start'); or set a different CONTAINER_ENGINE in $ENV_FILE."
  fi
  ENGINE="$choice"
}

require_engine() { resolve_engine; }

# ready reports whether the bundle is in a startable state: the env files, a database password, and the
# mode layer compose mounts as an env_file. Anything missing means `up` still has setup to do. The installer's
# get-byodt.sh.in makes the same test, to point a folder never started to `up`: keep the two in step.
ready() {
  [ -f "$ENV_FILE" ] || return 1
  [ -f "$SECRETS_FILE" ] || return 1
  grep -Eq '^NEO4J_PASSWORD=.+' "$SECRETS_FILE" || return 1
  [ -f "$MODE_FILE" ]
}

ensure_ready() {
  ready || die "Not set up yet — run '$SELF bootstrap' (or just '$SELF up', which does it for you)."
}

# env_value KEY DEFAULT — read a key from .env, falling back to DEFAULT.
env_value() {
  local key="$1" def="$2" val=""
  if [ -f "$ENV_FILE" ]; then
    val="$(grep -E "^$key=" "$ENV_FILE" 2>/dev/null | tail -1 | cut -d= -f2- || true)"
  fi
  printf '%s' "${val:-$def}"
}

# secret_value KEY DEFAULT — read a key from .env.secrets (mode 0600), falling back to DEFAULT.
# Host-side only: the wrapper reads the secret to pass DB credentials to the database's shell; it never
# exposes .env.secrets to a container (the console is deliberately walled off from it).
secret_value() {
  local key="$1" def="$2" val=""
  if [ -f "$SECRETS_FILE" ]; then
    val="$(grep -E "^$key=" "$SECRETS_FILE" 2>/dev/null | tail -1 | cut -d= -f2- || true)"
  fi
  printf '%s' "${val:-$def}"
}

# db_is_bind — true when the database stores data in a host bind mount (DB_DATA, or NEO4J_DATA, is a path), false
# when it uses a named volume. Governs whether ensure_layout makes the host dir and how destroy wipes.
db_is_bind() {
  case "$(db_data_setting)" in
    .*|/*) return 0 ;;
    *)     return 1 ;;
  esac
}

front_door_url() {
  # Follow the certificate: with one installed the proxy serves HTTPS only, and an http:// URL
  # earns nginx's "plain HTTP request was sent to an HTTPS port" — which `console` would hand
  # straight to the browser.
  local scheme=http
  [ -f tls/cert.pem ] && [ -f tls/key.pem ] && scheme=https
  printf '%s://%s:%s/console/' "$scheme" "$(env_value FRONT_DOOR_BIND 127.0.0.1)" "$(env_value FRONT_DOOR_PORT 3000)"
}

gen_secret() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex 24
  else
    dd if=/dev/urandom bs=24 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n'
  fi
}

# ensure_engine records the resolved engine in .env on first run, so every later command uses the
# same one (fresh auto-detection could pick differently if the host later gains a second engine)
# and the operator can see and change it. No-op once an active CONTAINER_ENGINE line exists.
ensure_engine() {
  resolve_engine
  [ -f "$ENV_FILE" ] || return 0
  if grep -Eq '^CONTAINER_ENGINE=' "$ENV_FILE"; then return 0; fi
  env_append "$ENV_FILE" CONTAINER_ENGINE "$ENGINE" '# Container engine, recorded by byodt on first run — edit to change.'
  info "Container engine: ${BOLD}$ENGINE${RST} (recorded CONTAINER_ENGINE in $ENV_FILE)."
}

# ensure_db_engine records the database engine in .env on first run, as ensure_engine does for the container
# engine: a deployment started with `DB_ENGINE=neo4j ./byodt up` must still be a Neo4j deployment on the next
# command run without the export. On Neo4j it records the image too, as .env.example does DB_IMAGE for Memgraph: the
# image then stays what this deployment started on, and a later bundle that tests a newer one warns (check_db_image)
# instead of moving the store forward on an update, which cannot be undone. No-op once the lines exist. Callers run
# check_engine_switch first, so an export that would be refused is never recorded.
ensure_db_engine() {
  [ -f "$ENV_FILE" ] || return 0
  local recorded=""
  if [ -z "$(env_setting DB_ENGINE)" ]; then
    recorded=1
    env_append "$ENV_FILE" DB_ENGINE "$DBE" "# Graph database engine, recorded by byodt on first run. Each engine keeps its own data; changing it
# starts an empty graph, and byodt refuses while the other engine's data is still in place."
    info "Database engine: ${BOLD}$DBE${RST} (recorded DB_ENGINE in $ENV_FILE)."
  fi
  if [ "$DBE" = neo4j ] && [ -z "$(env_setting NEO4J_IMAGE)" ]; then
    env_append "$ENV_FILE" NEO4J_IMAGE "$(neo4j_image)" "# The Neo4j image this deployment runs, recorded by byodt on first run. Back up before you change it:
# a store moved to a newer Neo4j cannot be moved back."
    info "Neo4j image: ${BOLD}$(neo4j_image)${RST} (recorded NEO4J_IMAGE in $ENV_FILE)."
    recorded=1
  fi
  if [ -n "$recorded" ]; then check_engine_settings; fi
}

# store_holds_data DIR: DIR exists and has an entry other than a desktop's .DS_Store. Any database file counts, even
# empty directories an engine made on a short first start: that store was this deployment's.
store_holds_data() {
  [ -n "$(find "$1" -mindepth 1 ! -name .DS_Store -print 2>/dev/null | head -1)" ]
}

# check_engine_switch refuses to start an engine on an empty store while the other engine's store, in its own bind
# directory, holds data: that is a deployment whose DB_ENGINE changed (or was exported for one command), and starting
# would bring up an empty graph and ingest into it while the real one sits unused. Nothing converts one engine's data
# into the other's, so a backup taken on one cannot be restored on the other. A store in a named volume cannot be
# looked into from the host, so it is not checked.
check_engine_switch() {
  local other mine theirs
  case "$DBE" in neo4j) other=memgraph ;; *) other=neo4j ;; esac
  mine="$(db_data_of "$DBE")"
  theirs="$(db_data_of "$other")"
  case "$mine" in .*|/*) ;; *) return 0 ;; esac
  case "$theirs" in .*|/*) ;; *) return 0 ;; esac
  store_holds_data "$mine" && return 0
  store_holds_data "$theirs" || return 0
  die "DB_ENGINE is $DBE, but its data directory ($mine) is empty while $other's ($theirs) holds a graph. Starting would bring up an empty graph. To keep using $other, set DB_ENGINE=$other in $ENV_FILE (and unset an exported DB_ENGINE). To move to $DBE, move $theirs aside: the $DBE graph starts empty, and a backup taken on $other cannot be loaded into it."
}

# check_engine_settings says which .env values Neo4j does not use: the platform logs in to Neo4j as `neo4j`, its
# administrator, to the one database Community serves, `neo4j` (compose.neo4j.yaml sets both, whatever .env says).
# It speaks once, on the first run on Neo4j (the one that records DB_ENGINE or NEO4J_IMAGE), not on every start: the
# template carries the Memgraph values.
check_engine_settings() {
  [ "$DBE" = neo4j ] || return 0
  local k v
  for k in NEO4J_USERNAME NEO4J_DATABASE; do
    v="$(env_setting "$k")"
    if [ -n "$v" ] && [ "$v" != neo4j ]; then
      info "$k=$v in $ENV_FILE is not used on Neo4j: the platform connects with $k=neo4j. You can remove the line."
    fi
  done
}

# check_override_names: byodt names compose.override.yaml, and only that one. Compose reads the other override names
# only when it picks the files itself; byodt names them, so those are not loaded.
check_override_names() {
  local f
  for f in compose.override.yml docker-compose.override.yaml docker-compose.override.yml; do
    [ -e "$f" ] && warn "$f is not loaded: byodt reads local changes from compose.override.yaml only. Rename it to use it."
  done
  return 0
}

# ensure_layout brings the on-disk bundle to a startable state: the .env file, the runtime directories
# (world-writable, since the console one-shot and daemon write into them under an unprivileged uid that
# need not match the operator's), and the pure open-source mode layer. It is idempotent and silent when
# nothing is missing, so `up` runs it every time — a deployment that lost any of this (a fresh copy, a
# removed dir) self-heals here rather than failing inside compose on a missing env_file or bind mount.
# path_owner PATH prints the uid owning PATH itself (a symlink is not followed): GNU stat, else BSD stat.
path_owner() {
  stat_field %u %u "$1"
}
# owned_by_operator PATH: PATH belongs to the user running byodt, to the user who ran it through sudo, or to root.
owned_by_operator() {
  local owner; owner="$(path_owner "$1")" || return 1
  [ "$owner" = "$(id -u)" ] || [ "$owner" = "${SUDO_UID:-}" ] || [ "$owner" = 0 ]
}
# refuse_foreign_entry PATH stops when PATH exists but another local account made it (see ensure_layout): chmod would
# widen whatever a link points at, and the owner of a directory under the sticky data/ can still swap it for a link,
# or rename what is in it, after any check.
refuse_foreign_entry() {
  { [ -e "$1" ] || [ -L "$1" ]; } || return 0
  owned_by_operator "$1" && return 0
  if [ -L "$1" ]; then
    die "$1 is a symbolic link owned by uid $(path_owner "$1"), not by you: byodt will not follow it. Check where it points (ls -l $1), remove the link, and run the command again."
  fi
  die "$1 is owned by uid $(path_owner "$1"), not by you: another account could replace it, or what is in it. Check what it holds (ls -la $1). If it is this deployment's own (the bundle moved to your account), give it to you: sudo chown -R \"\$(id -u):\$(id -g)\" $1. Otherwise move it aside. Then run the command again."
}

ensure_layout() {
  if [ ! -f "$ENV_FILE" ]; then
    cp .env.example "$ENV_FILE"
    info "Created $ENV_FILE from .env.example — review it before starting."
    # The engine was settled before .env existed; settle it again from the file just made.
    resolve_db_engine
  fi
  ensure_engine
  # The switch guard runs before anything is recorded or created for the engine, so a refused start leaves .env and
  # data/ as they were.
  check_engine_switch
  ensure_db_engine

  # Pre-create the runtime dirs a rootless engine (Podman) container must write as world-writable, so
  # the container uid — which need not match the operator — can still write them. The database's data
  # directory (data/memgraph, or data/neo4j) is a bind-mount dir only when DB_DATA (NEO4J_DATA) is a path;
  # a named volume needs no host dir, so make it only in bind mode. tls/ is deliberately NOT in this list: the proxy mounts it read-only and only the
  # operator writes it (via `tls generate`), so a 0777 dir there would just let any local user replace
  # the private key and force the plaintext fallback. Keep it 0700, and don't re-widen it each `up`.
  # The database's log directory is in this list for the reason the comment beside its mount in
  # compose.memgraph.yaml gives: the database image's log directory is writable only by the image's own
  # user, and in bind mode the container runs as the operator instead. Neo4j's image is the same. World-writable here covers both, and covers them
  # without this script having to know which mode is in play.
  #
  # data/ carries the STICKY BIT, and of its children only data/models does (below); the others do not, and
  # the asymmetry is the point. Every path widened below is chmod'ed by name, and chmod follows a symlink —
  # so an entry replaced by a link before this runs gets the link's TARGET widened instead, under the
  # operator's identity. Only the children of data/ are replaceable that way: every other widened dir is an
  # entry in the bundle root, which is 0755 and the operator's. Sticky on data/ stops a non-owner unlinking
  # those entries at all, and costs nothing, because this function creates them and no container renames
  # them. It is deliberately NOT applied to modules/, schema/ or mode/, whose entries ARE created and
  # replaced by containers: sticky there would refuse a replacement written under a different uid than the
  # one that installed it, which is what a module install becomes after the engine changes. The bit is set
  # before anything below is widened, so the ordering opens no window of its own.
  #
  # An entry planted BEFORE the run that creates it (the first run, or the upgrade that adds a runtime dir
  # such as data/models) would still be followed, so every widened child of data/ must be the operator's own
  # (refuse_foreign_entry), a link or not: the link an operator uses to move a multi-gigabyte cache onto
  # another disk passes, while a link or a directory another local account planted is refused before anything
  # follows or widens it. Its owner could swap a directory of its own for a link after any check. The end
  # state is not a wider guard here but narrower permissions: give each service a uid that matches its
  # directory's owner and none of this has to be world-writable at all.
  #
  # The check runs again after the entries exist and before anything is widened: an entry planted between the first
  # check and the mkdir (the run that creates it) is caught there, and once the operator's entry of the sticky data/
  # exists no other account can replace it, so the second check still holds when the chmod runs.
  #
  # data/models gets the sticky bit too: the platform loads what is in it as a model, after checking it by path, so
  # no account but an entry's owner may rename or delete one there. The platform refuses an entry below it that
  # another account owns or every account can write.
  #
  # The database's own directories depend on the engine: its log directory, and its data directory in bind mode —
  # data/memgraph-log and data/memgraph for Memgraph, data/neo4j-logs and data/neo4j for Neo4j. A Neo4j backup's dump
  # never passes through data/: it is written into a private directory of its own (see neo4j_backup).
  mkdir -p data && chmod 1777 data
  local d db_dir db_log
  case "$DBE" in
    neo4j) db_dir=data/neo4j; db_log=data/neo4j-logs ;;
    *)     db_dir=data/memgraph; db_log=data/memgraph-log ;;
  esac
  for d in data/content-cache data/models "$db_log" "$db_dir"; do refuse_foreign_entry "$d"; done
  mkdir -p modules schema data/content-cache data/models mode "$db_log"
  if db_is_bind; then mkdir -p "$db_dir"; fi
  for d in data/content-cache data/models "$db_log" "$db_dir"; do refuse_foreign_entry "$d"; done
  chmod 0777 modules schema data/content-cache mode "$db_log"
  chmod 1777 data/models
  mkdir -p tls && chmod 0700 tls
  # The CA of a TLS-inspecting proxy, mounted read-only into the services that call out. Its own directory, not tls/:
  # Go loads every certificate in SSL_CERT_DIR as a root, and tls/ holds the front door's own. It always exists, so the
  # engine never creates it root-owned for the mount. Created with its mode, never chmod'ed: an existing one is the
  # operator's, and check_proxy_ca has checked it.
  { [ -e proxy-ca ] || [ -L proxy-ca ]; } || mkdir -m 0755 proxy-ca
  if db_is_bind; then chmod 0777 "$db_dir"; fi

  # compose.yaml bind-mounts this as a FILE. A container engine handed a bind source that does not
  # exist invents a DIRECTORY there — and then console-init, whose whole job is to write the file,
  # fails with "is a directory" and the deployment is wedged until someone removes it by hand. The
  # ordering that should prevent it (the platform waits for console-init to complete) is honoured by
  # Docker Compose but not reliably by podman-compose, so the file is created here instead of
  # depending on it. Empty is correct: console-init overwrites it with the real schema.
  # The symlink test comes FIRST, and refuses rather than repairs. schema/ is world-writable — it
  # has to be, because the one-shot's uid is not the operator's — so a symlink planted at this path
  # would otherwise be followed by everything below, and this function would create and widen
  # whatever it points at (.env.secrets, say) under the operator's identity. Every other test here
  # dereferences; only -L sees the link. For the same reason the file is created with its mode
  # rather than chmod'ed afterwards: a chmod on a path in a world-writable directory is a primitive
  # worth not having at all, and an existing regular file needs no mode change — the one-shot wrote
  # through it last time.
  if [ -L schema/schema-noauth.graphql ]; then
    die "schema/schema-noauth.graphql is a symlink — refusing to write through it. Remove it, then run '$SELF up' again."
  fi
  if [ -d schema/schema-noauth.graphql ]; then
    rmdir schema/schema-noauth.graphql 2>/dev/null ||
      die "schema/schema-noauth.graphql is a non-empty directory — an engine created it in place of the file. Remove it and run '$SELF up' again."
  fi
  if [ ! -e schema/schema-noauth.graphql ]; then
    # 0666 at creation: the one-shot writes this file and its uid is not the operator's.
    ( umask 0111; : > schema/schema-noauth.graphql )
  elif [ ! -f schema/schema-noauth.graphql ]; then
    die "schema/schema-noauth.graphql is not a regular file — remove it, then run '$SELF up' again."
  fi

  # The console rewrites this file (never deletes it) when the deployment is connected to the cloud.
  # The symlink test comes first for the same reason it does above schema-noauth.graphql, and what it
  # refuses here is worse. [ -f ] dereferences, so a DANGLING link at this path is not "already
  # present" — the redirection below then CREATES the operator's file wherever the link points,
  # holding a mode layer that turns authentication off. mode/ is world-writable, so planting the link
  # needs no privilege, and `set -e` does not catch it: the redirection succeeds.
  if [ -L "$MODE_FILE" ]; then
    die "$MODE_FILE is a symlink — refusing to write through it. Remove it, then run '$SELF up' again."
  fi
  if [ ! -f "$MODE_FILE" ]; then
    printf 'ENABLE_NOAUTH=true\nNODE_ENV=development\n' > "$MODE_FILE"
    info "Seeded $MODE_FILE with the pure open-source defaults."
  fi
}

# ensure_password generates the database password once, into .env.secrets (mode 0600). A no-op once a
# password exists, so it is safe to call on every `up`.
ensure_password() {
  if [ -f "$SECRETS_FILE" ] && grep -Eq '^NEO4J_PASSWORD=.+' "$SECRETS_FILE"; then
    return 0
  fi
  local password
  password="$(gen_secret)"
  [ -n "$password" ] || die "Failed to generate a password (no openssl and no readable /dev/urandom)."
  umask 077
  {
    if [ -f "$SECRETS_FILE" ]; then grep -v '^NEO4J_PASSWORD=' "$SECRETS_FILE" || true; fi
    echo "NEO4J_PASSWORD=$password"
  } > "$SECRETS_FILE.tmp"
  mv "$SECRETS_FILE.tmp" "$SECRETS_FILE"
  chmod 0600 "$SECRETS_FILE"
  info "Wrote a new database password to $SECRETS_FILE (mode 0600)."
  # A deployment's first run: record the files its release shipped, for the first upgrade's check of local edits.
  release_record_initial
}

# check_password_length warns when the Memgraph password is shorter than MIN_DB_PASSWORD_LENGTH. Memgraph stores it
# with a fast salted hash, which is safe for a long random value and not for a short one.
check_password_length() {
  [ "$DBE" = memgraph ] || return 0
  local pass
  pass="$(secret_value NEO4J_PASSWORD "")"
  [ -n "$pass" ] || return 0
  [ "${#pass}" -lt "$MIN_DB_PASSWORD_LENGTH" ] || return 0
  warn "NEO4J_PASSWORD in $SECRETS_FILE is shorter than $MIN_DB_PASSWORD_LENGTH characters. Memgraph stores it with a fast hash, which is safe only for a long random value, such as the 48 characters byodt generates. On an existing database, set a new password in the database before you change $SECRETS_FILE, or the platform is locked out."
}

# reapply_db_password sets the Memgraph user's password to the value it already has. Memgraph keeps each stored hash
# in the algorithm it was made with, so a user created under the old default, bcrypt, moves to the hash
# compose.memgraph.yaml names only when its password is set again. Setting a password to its own value changes
# nothing, so this runs on every up and update and needs no marker. The statement is built inside the db container
# from the container's own environment and reaches mgconsole on stdin, and mgconsole reads its login password from
# the environment (gflags' --fromenv), so the password is on no command line. The user name and the password go into
# the statement unescaped: the shape checks, on the values compose interpolates from the shell and .env (a hex
# password, a user name of letters, digits and underscores that does not start with a digit), are what make that
# safe. The length check keeps a short password on its old, slow hash. It needs a healthy database, which a full
# start and a start of any service that depends on the database wait for; a start of only the console or the
# database does not, so it skips those. Non-fatal: if it fails, logins keep working on the old hash.
reapply_db_password() {
  [ "$DBE" = memgraph ] || return 0
  local s named="" waits="" pass user script
  for s in "$@"; do
    case "$s" in
      -*) ;;
      console|db) named=1 ;;
      *) named=1; waits=1 ;;
    esac
  done
  # Only the console or the database named: nothing waits for a healthy database.
  if [ -n "$named" ] && [ -z "$waits" ]; then return 0; fi
  pass="$(secret_value NEO4J_PASSWORD "")"
  # Compose takes a variable from the shell's environment before .env, so an exported one is what the container gets.
  if [ -n "${NEO4J_USERNAME+set}" ]; then user="$NEO4J_USERNAME"; else user="$(env_setting NEO4J_USERNAME)"; fi
  case "$pass" in ''|*[!0-9a-f]*) return 0 ;; esac
  [ "${#pass}" -ge "$MIN_DB_PASSWORD_LENGTH" ] || return 0
  case "$user" in ''|[0-9]*|*[!A-Za-z0-9_]*) return 0 ;; esac
  # Single-quoted, so every expansion is the container shell's; \047 is printf's single quote. The exec reads from
  # /dev/null: compose would otherwise forward this command's stdin, and take input meant for what runs after it.
  script='printf "SET PASSWORD FOR %s TO \047%s\047;\n" "$MEMGRAPH_USER" "$MEMGRAPH_PASSWORD" | FLAGS_password="$MEMGRAPH_PASSWORD" mgconsole --username "$MEMGRAPH_USER" --fromenv=password'
  if compose exec -T db sh -c "$script" </dev/null >/dev/null 2>&1; then
    return 0
  fi
  warn "Could not re-apply the database password, so Memgraph keeps its older, slower hash; logins still work. The next '$SELF up' or '$SELF update' tries again."
}

# do_bootstrap is full first-run setup: the explicit `bootstrap` command, and what `up` folds in.
do_bootstrap() { ensure_layout; ensure_password; }

# --- reading and writing .env --------------------------------------------------

# env_setting KEY prints KEY's value in .env as compose reads it ('' when unset). env_value is left as it is for its
# other callers; this one decides a refusal, so it reads what the platform gets.
env_setting() {
  env_setting_in "$ENV_FILE" "$1"
}

# env_setting_in FILE KEY prints KEY's value in FILE (.env, or a release's .env.example) as compose reads it: the last
# assignment wins, an `export ` prefix and spaces around the name are allowed, an unquoted value ends at ' #', and one
# pair of surrounding quotes goes.
env_setting_in() {
  local file="$1" key="$2" line val
  [ -f "$file" ] || return 0
  line="$(grep -E "^[[:space:]]*(export[[:space:]]+)?${key}[[:space:]]*=" "$file" 2>/dev/null | tail -1 || true)"
  [ -n "$line" ] || return 0
  val="$(printf '%s' "${line#*=}" | sed -E 's/^[[:space:]]+//')"
  case "$val" in
    \"*) val="$(printf '%s' "$val" | sed -E 's/^"([^"]*)".*$/\1/')" ;;
    \'*) val="$(printf '%s' "$val" | sed -E "s/^'([^']*)'.*\$/\\1/")" ;;
    *)   val="${val%%[[:space:]]#*}"; val="$(printf '%s' "$val" | sed -E 's/[[:space:]]+$//')" ;;
  esac
  printf '%s' "$val"
}

#
# Every change byodt makes to .env, and to .env.secrets apart from the database password ensure_password generates,
# goes through the functions below, so a value is checked in one place and lands where a hand edit would put it. Each
# writes a sibling FILE.tmp and renames it over FILE, so a failure leaves FILE as it was.

# A value byodt writes: letters, digits and . _ : / @ % + , = ~ ! & ' ( ) * ; -, or nothing. Every value it writes is a
# version, an image, an address, a port, a URL, a host list or a percent-encoded login, so none needs quoting; anything
# else (a space, a double quote, #, $, a backslash, a control character) would be read differently by compose, or reach
# a terminal raw.
readonly ENV_VALUE_RE="^[A-Za-z0-9._:/@%+,=~!&'()*;-]*\$"

# env_value_ok VALUE: VALUE is one line of allowed characters.
env_value_ok() {
  case "$1" in '') return 0 ;; *$'\n'*) return 1 ;; esac
  printf '%s' "$1" | LC_ALL=C grep -Eq "$ENV_VALUE_RE"
}

# env_key_ok KEY: KEY is an upper-case variable name.
env_key_ok() {
  case "$1" in ''|[!A-Z_]*|*[!A-Z0-9_]*) return 1 ;; esac
}

# env_file_mode FILE prints FILE's permission bits in octal.
env_file_mode() { stat_field %a %Lp "$1"; }

# env_rewrite FILE COMMAND [ARGS…] replaces FILE with what COMMAND prints. Everything is checked, and the rename
# done, in the calling shell, so a refusal stops the command: FILE and FILE.tmp may not be links, and FILE.tmp may not
# exist (a leftover one is the operator's to look at). The new file keeps FILE's mode; .env.secrets, and any file
# that does not exist yet, gets 0600 until the caller says otherwise.
env_rewrite() {
  local file="$1" tmp="$1.tmp" mode=600
  shift
  if [ -L "$file" ]; then die "$file is a symbolic link: byodt does not write through it. Replace it with the file itself."; fi
  if [ -e "$tmp" ] || [ -L "$tmp" ]; then die "$tmp exists, left by an earlier run. Check it, remove it, and run the command again."; fi
  if [ -f "$file" ] && [ "$file" != "$SECRETS_FILE" ]; then mode="$(env_file_mode "$file")"; fi
  ( set -C; umask 077; "$@" > "$tmp" ) || die "Could not write $tmp. Remove it and run the command again."
  chmod "$mode" "$tmp" || die "Could not set the mode of $tmp. Remove it and run the command again."
  # Run through sudo, the new file would be root's; an existing file keeps its owner, as an append would have.
  if [ "$(id -u)" = 0 ] && [ -f "$file" ]; then
    chown "$(stat_field %u %u "$file"):$(stat_field %g %g "$file")" "$tmp" || die "Could not give $tmp the owner of $file."
  fi
  mv -f "$tmp" "$file" || die "Could not replace $file with $tmp."
}

# env_print_appended FILE TEXT prints FILE, if it exists, then a blank line and TEXT.
env_print_appended() {
  if [ -f "$1" ]; then cat -- "$1"; fi
  printf '\n%s\n' "$2"
}

# env_check KEY VALUE FILE stops unless KEY is a variable name and VALUE an allowed value.
env_check() {
  env_key_ok "$1" || die "byodt tried to write the key '$1', which is not a variable name."
  # The value is not repeated: it may be a login.
  env_value_ok "$2" || die "$1 cannot be written to $3: a value may hold only letters, digits and . _ : / @ % + , = ~ ! & ' ( ) * ; -"
}

# env_append FILE KEY VALUE COMMENT appends a blank line, the COMMENT lines as given (each starting with '#'), and
# KEY=VALUE: the form byodt has always recorded settings in. It does not look for an existing line; callers decide.
env_append() {
  env_check "$2" "$3" "$1"
  env_rewrite "$1" env_print_appended "$1" "$4
$2=$3"
}

# env_print_set FILE KEY VALUE prints FILE with KEY set to VALUE (env_write's first two cases). The key and the value
# reach awk through its environment, never as program text or with -v, which reads backslash escapes.
env_print_set() {
  ENVW_KEY="$2" ENVW_VALUE="$3" awk '
    BEGIN { k = ENVIRON["ENVW_KEY"]; v = ENVIRON["ENVW_VALUE"]
            act = "^[ \t]*(export[ \t]+)?" k "[ \t]*="; tpl = "# " k "=" }
    { line[NR] = $0
      if ($0 ~ act) last = NR
      else if (!first && index($0, tpl) == 1) first = NR }
    END {
      if (last) { p = index(line[last], "="); line[last] = substr(line[last], 1, p) v }
      else if (first) line[first] = k "=" v
      for (i = 1; i <= NR; i++) print line[i] }' "$1"
}

# env_write FILE KEY VALUE [COMMENT] sets KEY to VALUE as a hand edit would:
#   - an active assignment exists (env_setting's forms: an optional `export `, spaces around the name): the value of
#     the LAST one is replaced, since the last one wins for compose, keeping the line's prefix and dropping any inline
#     comment after the old value;
#   - else a template line `# KEY=…` exists, as .env.example ships the keys it leaves unset: the FIRST one is
#     uncommented in place, under its documentation. Only that exact form counts: `#   KEY=…` is documentation;
#   - else KEY=VALUE is appended, after the line `# COMMENT` when one is given.
env_write() {
  local file="$1" key="$2" value="$3" comment="${4:-}"
  env_check "$key" "$value" "$file"
  if [ -f "$file" ] && grep -Eq "^[[:space:]]*(export[[:space:]]+)?${key}[[:space:]]*=|^# ${key}=" "$file"; then
    env_rewrite "$file" env_print_set "$file" "$key" "$value"
  elif [ -n "$comment" ]; then
    env_rewrite "$file" env_print_appended "$file" "# $comment
$key=$value"
  else
    env_rewrite "$file" env_print_appended "$file" "$key=$value"
  fi
}

# env_print_commented FILE KEY NOTE prints FILE with every active assignment of KEY turned into a comment.
env_print_commented() {
  ENVW_KEY="$2" ENVW_NOTE="$3" awk '
    BEGIN { act = "^[ \t]*(export[ \t]+)?" ENVIRON["ENVW_KEY"] "[ \t]*=" }
    { if ($0 ~ act) print "# " $0 "  # " ENVIRON["ENVW_NOTE"]; else print }' "$1"
}

# env_comment_out FILE KEY NOTE turns every active assignment of KEY into a comment, with NOTE after it.
env_comment_out() {
  env_key_ok "$2" || die "byodt tried to comment out the key '$2', which is not a variable name."
  [ -f "$1" ] || return 0
  grep -Eq "^[[:space:]]*(export[[:space:]]+)?${2}[[:space:]]*=" "$1" || return 0
  env_rewrite "$1" env_print_commented "$1" "$2" "$3"
}

# env_insert_block FILE BLOCK appends BLOCK, a key's template line with the comment lines above it, taken verbatim
# from a release's .env.example. It is shipped text, not a value, so it is held to its own rule: no control character
# but the line breaks, and exactly one line that sets a key (`KEY=…`, or `# KEY=…` for a key the template leaves unset).
env_insert_block() {
  env_insert_block_check "$2" || die "A setting from .env.example holds a control character, or sets no key or more than one; byodt does not copy it into $1."
  env_rewrite "$1" env_print_appended "$1" "$2"
}

# --- the compose project -------------------------------------------------------

# same_dir LABEL HERE HERE_P: the directory a container label names is this one, spelled as it is (HERE), resolved
# (HERE_P), or resolving to it (a path through a link, such as /var for /private/var on macOS).
same_dir() {
  [ -n "$1" ] || return 1
  [ "$1" = "$2" ] || [ "$1" = "$3" ] && return 0
  [ -d "$1" ] && [ "$(cd "$1" 2>/dev/null && pwd -P)" = "$3" ]
}

# project_workdirs prints, one per line, every directory a container of this bundle's compose project was started
# from, running or stopped. The directory is the one compose records on each container
# (com.docker.compose.project.working_dir; podman-compose records the same label). Containers are found by the project
# label in both providers' namespaces, as project_containers does. The caller has resolved the engine.
project_workdirs() {
  local ns id dir
  for ns in com.docker.compose io.podman.compose; do
    "$ENGINE" ps -aq --filter "label=$ns.project=dethernety" 2>/dev/null </dev/null || true
  done | sort -u | while IFS= read -r id; do
    [ -n "$id" ] || continue
    dir="$("$ENGINE" inspect -f '{{index .Config.Labels "com.docker.compose.project.working_dir"}}' "$id" 2>/dev/null </dev/null || true)"
    case "$dir" in ''|'<no value>') continue ;; esac
    printf '%s\n' "$dir"
  done | sort -u
}

# project_dirs prints, one per line, every directory other than this one in project_workdirs. compose.yaml fixes the
# project name (`name: dethernety`), so a second bundle directory that starts takes over the first one's containers,
# and with a named volume its database too.
project_dirs() {
  local dir here here_p
  resolve_engine
  here="$PWD"; here_p="$(pwd -P)"
  project_workdirs | while IFS= read -r dir; do
    same_dir "$dir" "$here" "$here_p" || printf '%s\n' "$dir"
  done
}

# check_project [fresh] stops a command that acts on the project's containers (a start, down, stop, destroy, backup,
# restore) when another directory runs, or ran, this bundle's compose project (project_dirs). With "fresh" (a folder
# whose database has no password yet), it also stops when the named volume the database would mount already exists: it
# holds a graph from an earlier deployment, whose users were made with another password, and the platform would be
# locked out of it.
check_project() {
  local others
  others="$(project_dirs)"
  if [ -n "$others" ]; then
    printf '%serror:%s this bundle'"'"'s compose project is already used by another directory:\n' "$RED" "$RST" >&2
    # The directories come from container labels: only printable characters reach the terminal.
    printf '%s\n' "$others" | LC_ALL=C tr -cd '[:print:]\n' | sed 's/^/    /' >&2
    printf 'Running this here would act on its containers. Upgrade that deployment instead ('"'"'./byodt upgrade'"'"' in it), or\n' >&2
    printf 'stop it there ('"'"'./byodt down'"'"'). If this deployment was moved here from that directory, run '"'"'%s down --take-over'"'"'\n' "$SELF" >&2
    printf 'here once to remove the old containers, then start it here.\n' >&2
    exit 1
  fi
  [ "${1:-}" = fresh ] || return 0
  db_is_bind && return 0
  check_project_volume "$(db_data_setting)"
}

# db_folder_setting VOLUME prints the .env setting that keeps the database of VOLUME's engine in a folder instead.
db_folder_setting() {
  case "$1" in neo4j-data) echo NEO4J_DATA=./data/neo4j ;; *) echo DB_DATA=./data/memgraph ;; esac
}

# check_project_volume NAME [setup] stops when the project's named volume NAME already exists (check_project, fresh).
# From setup, nothing is written yet, so the way to a folder is setup's own flag rather than a .env setting.
check_project_volume() {
  local vol="$1" way
  way="Set $(db_folder_setting "$vol") in $ENV_FILE"
  [ "${2:-}" != setup ] || way="Run setup with --db-data bind"
  if "$ENGINE" volume inspect "dethernety_$vol" >/dev/null 2>&1 </dev/null; then
    die "The volume dethernety_$vol remains from an earlier deployment of this bundle, and this one would mount it: that graph's database users were made with another password, so the platform would be locked out. $way to keep the database in a folder instead (less robust on a VM-backed engine), or upgrade the deployment it belongs to; if you no longer need that graph, remove it with '$ENGINE volume rm dethernety_$vol' (this deletes it for good), and run the command again."
  fi
}

# warn_old_volumes DATA VOLUME warns about each database volume an earlier deployment of this bundle left. Setup runs it
# before anything is written, started or not; it never refuses, since a deployment that keeps its database in a folder
# can sit next to an old volume. VOLUME, when DATA is volume, is the one this deployment would mount: its first start
# would be refused (check_project_volume), so it is named with the setting that avoids that.
warn_old_volumes() {
  local v
  for v in memgraph-data neo4j-data; do
    "$ENGINE" volume inspect "dethernety_$v" >/dev/null 2>&1 </dev/null || continue
    if [ "$1" = volume ] && [ "$v" = "$2" ]; then
      warn "The volume dethernety_$v remains from an earlier deployment of this bundle, and this one would mount it: that graph's database users were made with another password, so its first start would be refused. Before it, set $(db_folder_setting "$v") in $ENV_FILE to keep the database in a folder instead (less robust on a VM-backed engine); if you no longer need that graph, remove it with '$ENGINE volume rm dethernety_$v' (this deletes it for good)."
    else
      warn "The volume dethernety_$v remains from an earlier deployment of this bundle; its graph may still be in it. This one does not use it. To use that graph, stop this one and start the deployment it belongs to ('./byodt up' in its folder); if you no longer need it, remove it with '$ENGINE volume rm dethernety_$v' (this deletes it for good)."
    fi
  done
}

# --- third-party notice ---------------------------------------------------------
#
# Before this machine downloads third-party software (the database image, the front door's nginx image, the embedding
# model), byodt shows a short factual notice from ACK_FILE, a versioned text shipped in the bundle, and records the
# operator's confirmation in ACK_LOG. The text holds no image reference itself: {IMAGE} and {MODEL} are filled with
# what this deployment will actually run, so a new tag changes no wording and asks nobody again. Only a change of the
# text, of the database image or of the model does.

# sha256_of FILE prints FILE's SHA-256: sha256sum, else shasum.
sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum -- "$1" | cut -d' ' -f1
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 -- "$1" | cut -d' ' -f1
  else die "Neither sha256sum nor shasum is installed; files cannot be checked."; fi
}

# sha256_tool: sha256sum or shasum is installed. sha256_of runs inside $(…), where its die only ends the substitution,
# so what acts on a hash checks this first, through sha256_ready.
sha256_tool() { command -v sha256sum >/dev/null 2>&1 || command -v shasum >/dev/null 2>&1; }
sha256_ready() { sha256_tool || die "Neither sha256sum nor shasum is installed; files cannot be checked."; }

# stat_field GNU-FORMAT BSD-FORMAT PATH prints one field of PATH's stat: GNU stat, else BSD stat.
stat_field() {
  stat -c "$1" "$3" 2>/dev/null || stat -f "$2" "$3"
}

# dir_private_enough DIR: DIR is not a link, belongs to the operator, and no other account can write to it. A group
# that may write counts as another account, unless it is the operator's own private group (a group named after the
# operator, which on many Linux hosts makes every new directory group-writable).
dir_private_enough() {
  local d="$1"
  [ ! -L "$d" ] && owned_by_operator "$d" || return 1
  [ -z "$(find "$d" -maxdepth 0 -perm -002 2>/dev/null)" ] || return 1
  [ -n "$(find "$d" -maxdepth 0 -perm -020 2>/dev/null)" ] || return 0
  [ "$(stat_field %g %g "$d")" = "$(id -g)" ] && [ "$(id -gn)" = "$(id -un)" ]
}

# ack_file_check stops unless ACK_FILE is the bundle's own regular file: the operator's, at most ACK_MAX_BYTES,
# printable ASCII and line feeds only, starting with its Text-Version line.
ack_file_check() {
  if [ -L "$ACK_FILE" ] || [ ! -f "$ACK_FILE" ]; then
    die "$ACK_FILE is missing or not a regular file. It ships with the bundle: unpack the bundle again."
  fi
  owned_by_operator "$ACK_FILE" || die "$ACK_FILE is owned by uid $(path_owner "$ACK_FILE"), not by you: byodt does not show a text another account can change."
  [ "$(wc -c < "$ACK_FILE" | tr -d ' ')" -le "$ACK_MAX_BYTES" ] || die "$ACK_FILE is larger than $ACK_MAX_BYTES bytes: it is not the text the bundle ships."
  if LC_ALL=C grep -q '[^ -~]' "$ACK_FILE"; then
    die "$ACK_FILE holds a character other than printable ASCII: it is not the text the bundle ships."
  fi
  head -1 "$ACK_FILE" | grep -Eq '^Text-Version: [1-9][0-9]*$' || die "$ACK_FILE does not start with its Text-Version line."
}

ack_version() { head -1 "$ACK_FILE" | sed 's/^Text-Version: //'; }

# ack_section NAME prints the lines of ACK_FILE's section [NAME], without its trailing blank lines.
ack_section() {
  ACK_NAME="[$1]" awk '
    /^\[[a-z0-9]+\]$/ { on = ($0 == ENVIRON["ACK_NAME"]); next }
    on { line[++n] = $0 }
    END { while (n > 0 && line[n] == "") n--; for (i = 1; i <= n; i++) print line[i] }' "$ACK_FILE"
}

# ack_fill fills {IMAGE}, {MODEL} and {KEY} on stdin with ACK_IMAGE, ACK_MODEL and ACK_KEY from the environment. Plain
# string replacement: awk's sub() would read an & in a value as the matched text.
ack_fill() {
  awk '
    function rep(s, ph, v,   out, i) {
      out = ""
      while ((i = index(s, ph)) > 0) { out = out substr(s, 1, i - 1) v; s = substr(s, i + length(ph)) }
      return out s }
    { print rep(rep(rep($0, "{IMAGE}", ENVIRON["ACK_IMAGE"]), "{MODEL}", ENVIRON["ACK_MODEL"]), "{KEY}", ENVIRON["ACK_KEY"]) }'
}

# image_identity REF prints REF's repository without its tag or digest, in the full form an engine resolves a short
# name to: docker.io/library/nginx for nginx, docker.io/memgraph/memgraph for memgraph/memgraph.
image_identity() {
  local ref="${1%%@*}" first
  case "${ref##*/}" in *:*) ref="${ref%:*}" ;; esac
  first="${ref%%/*}"
  if [ "$first" = "$ref" ]; then
    ref="docker.io/library/$ref"
  else
    case "$first" in
      index.docker.io|registry-1.docker.io) ref="docker.io/${ref#*/}" ;;
      *.*|*:*|localhost) ;;
      *) ref="docker.io/$ref" ;;
    esac
  fi
  case "$ref" in docker.io/*/*) ;; docker.io/*) ref="docker.io/library/${ref#docker.io/}" ;; esac
  printf '%s' "$ref"
}

# config_image SERVICE WITH-OVERRIDE prints the image compose gives SERVICE, from `compose config`, whose output is
# normalised, so any YAML form of compose.override.yaml (anchors, merge keys, other indentation) is read right. It runs
# here, so the override's own relative paths resolve; on a folder that has not started yet, which has no mode layer for
# compose's env_file, it runs on a scratch copy with an empty one. WITH-OVERRIDE is yes or no. Fails when compose
# cannot read the files.
config_image() {
  local envf="$ENV_FILE" tmp="" out rc=0 f
  local -a files
  [ -f "$envf" ] || envf=.env.example
  compose_files "" "$2"
  files=("${COMPOSE_FILES[@]}")
  if [ ! -f mode/mode.env ]; then
    tmp="$(mktemp -d)" || return 1
    mkdir -p "$tmp/mode" && : > "$tmp/mode/mode.env"
    for f in "${files[@]}"; do
      [ "$f" = -f ] || cp "$f" "$tmp/" || { rm -rf "${tmp:?}"; return 1; }
    done
    compose_files "$tmp/" "$2"
    files=("${COMPOSE_FILES[@]}")
  fi
  # The project directory is the first file's (podman-compose has no --project-directory).
  out="$(CONSOLE_IMAGE="$(console_image)" NEO4J_IMAGE="$(neo4j_image)" "$ENGINE" compose --env-file "$envf" \
         "${files[@]}" config 2>/dev/null </dev/null)" || rc=$?
  [ -z "$tmp" ] || rm -rf "${tmp:?}"
  [ "$rc" = 0 ] || return 1
  printf '%s\n' "$out" | ACK_SVC="$1" awk '
    /^[^ #]/ { top = $0 }
    top ~ /^services:/ && /^  [^ #]/ { svc = $0; sub(/^  /, "", svc); sub(/:.*$/, "", svc) }
    top ~ /^services:/ && svc == ENVIRON["ACK_SVC"] && /^    image:/ {
      v = $0; sub(/^    image:[ \t]*/, "", v); gsub(/^["\047]|["\047]$/, "", v); print v; exit }'
}

# override_image SERVICE prints the image compose.override.yaml sets for SERVICE: what compose gives SERVICE with the
# override, when that differs from what it gives without it. Prints nothing when there is no override or it changes
# no image there; fails when compose cannot read the files.
override_image() {
  local with without
  [ -f compose.override.yaml ] || return 0
  resolve_engine
  with="$(config_image "$1" yes)" && without="$(config_image "$1" no)" || return 1
  [ "$with" = "$without" ] || printf '%s' "$with"
}

# ack_tested KEY prints the image this bundle was tested with for KEY (DB_IMAGE, NEO4J_IMAGE or PROXY_IMAGE).
ack_tested() {
  case "$1" in
    DB_IMAGE)    printf '%s' "$TESTED_DB_IMAGE" ;;
    NEO4J_IMAGE) printf '%s' "$TESTED_NEO4J_IMAGE" ;;
    *)           env_setting_in .env.example "$1" ;;
  esac
}

# ack_image KEY prints the image compose will run for KEY: compose.override.yaml's for its service, else an exported
# value, else .env's (read as the rest of byodt reads it; before .env exists, .env.example's), else the tested one. A
# value byodt would not write is refused when read: a hand-edited .env never went through the writer. An override
# compose cannot read is refused before the first setup, and only warned about (once per service, when this runs in
# the calling shell) for a deployment that is already set up, whose commands it does not stop.
ACK_WARNED=""
ack_image() {
  local key="$1" svc=db val src=compose.override.yaml missing why
  [ "$key" = PROXY_IMAGE ] && svc=proxy
  if ! val="$(override_image "$svc")"; then
    # A missing compose file stops compose too: named as itself, not as a fault of the override.
    missing="$(compose_file_missing)"
    if [ -n "$missing" ]; then
      [ -f "$ENV_FILE" ] || die "$missing is missing here, so byodt cannot show which image compose.override.yaml sets for $svc. Put the file back, and run the command again."
      why="$missing is missing here, so the notice shows .env's image for $svc, not what compose.override.yaml sets; compose stops without it too."
    else
      [ -f "$ENV_FILE" ] || die "'$ENGINE compose config' could not read compose.override.yaml, so byodt cannot show which image it sets for $svc. Fix the file, and run the command again."
      why="'$ENGINE compose config' could not read compose.override.yaml, so the notice shows .env's image for $svc; check what the override sets."
    fi
    case " $ACK_WARNED " in
      *" $svc "*) ;;
      *) warn "$why"
         ACK_WARNED="$ACK_WARNED $svc" ;;
    esac
    val=""
  fi
  if [ -z "$val" ]; then
    if [ -n "${!key:-}" ]; then val="${!key}"; src="your shell's environment"
    elif [ -f "$ENV_FILE" ]; then val="$(env_value "$key" '')"; src="$ENV_FILE"
    else val="$(env_setting_in .env.example "$key")"; src=.env.example; fi
  fi
  [ -n "$val" ] || val="$(ack_tested "$key")"
  case "$val" in
    *'${'*) die "$key in $src is written with a variable (\${…}); byodt cannot show which image that is. Write the image reference in full." ;;
  esac
  env_value_ok "$val" || die "$key in $src holds a character byodt does not print. Write the image reference with letters, digits and . _ : / @ % + , = ~ ! & ' ( ) * ; - only."
  printf '%s' "$val"
}

# ack_image_source KEY prints where KEY's image is set, for the [mirror] paragraph: compose.override.yaml, or KEY.
ack_image_source() {
  local svc=db
  [ "$1" = PROXY_IMAGE ] && svc=proxy
  if [ -n "$(override_image "$svc" 2>/dev/null || true)" ]; then printf 'compose.override.yaml'; else printf '%s' "$1"; fi
}

ack_db_key() { if [ "$1" = neo4j ]; then printf NEO4J_IMAGE; else printf DB_IMAGE; fi; }

# ack_check_images ENGINE checks, in the calling shell, every image the notice for ENGINE names, so a value byodt
# refuses stops the command before anything is shown or written (inside $(…) a refusal would end only that subshell).
ack_check_images() {
  local e
  for e in memgraph neo4j; do
    [ "$1" = both ] || [ "$1" = "$e" ] || continue
    ack_image "$(ack_db_key "$e")" >/dev/null
  done
  ack_image PROXY_IMAGE >/dev/null
}

# ack_mirror_keys ENGINE prints the keys whose image names another repository than the tested one.
ack_mirror_keys() {
  local key e keys="PROXY_IMAGE"
  for e in memgraph neo4j; do
    [ "$1" = both ] || [ "$1" = "$e" ] || continue
    keys="$(ack_db_key "$e") $keys"
  done
  for key in $keys; do
    if [ "$(image_identity "$(ack_image "$key")")" != "$(image_identity "$(ack_tested "$key")")" ]; then printf '%s\n' "$key"; fi
  done
}

# ack_render ENGINE prints the notice for ENGINE (memgraph or neo4j), or for both ("both", before the choice is made),
# filled with what the deployment will run. [mirror] follows for an image that names another repository than the
# tested one; a different tag of the same repository shows in the image line alone.
ack_render() {
  local engine="$1" e key
  ack_check_images "$engine"
  ack_section intro
  for e in memgraph neo4j; do
    [ "$engine" = both ] || [ "$engine" = "$e" ] || continue
    printf '\n'; ack_section "$e" | ACK_IMAGE="$(ack_image "$(ack_db_key "$e")")" ack_fill
  done
  printf '\n'; ack_section model | ACK_MODEL="$TESTED_MODEL" ack_fill
  printf '\n'; ack_section nginx | ACK_IMAGE="$(ack_image PROXY_IMAGE)" ack_fill
  for key in $(ack_mirror_keys "$engine"); do
    printf '\n'; ack_section mirror | ACK_KEY="$(ack_image_source "$key")" ACK_IMAGE="$(ack_image "$key")" ack_fill
  done
  printf '\n'; ack_section confirm
}

# ack_log_trusted: ACK_LOG exists, is the operator's own file with no other name, in a directory no other account can
# write to. A record that fails this counts as no record: another account could have planted it.
ack_log_trusted() {
  [ -f "$ACK_LOG" ] && [ ! -L "$ACK_LOG" ] && owned_by_operator "$ACK_LOG" \
    && [ "$(stat_field %h %l "$ACK_LOG")" = 1 ] && dir_private_enough .
}

# ack_last FIELD prints FIELD of the last record; fields are split at their first '='.
ack_last() {
  tail -n 1 "$ACK_LOG" | ACK_FIELD="$1" awk -F '\t' '
    { for (i = 2; i <= NF; i++) { p = index($i, "="); if (substr($i, 1, p - 1) == ENVIRON["ACK_FIELD"]) print substr($i, p + 1) } }'
}

# ack_due: the notice has not been confirmed for this text, and for the database image and the model this deployment
# runs. The front door's image is shown but does not count: its licence does not change with its tag.
ack_due() {
  ack_log_trusted || return 0
  # Without a hash tool the text cannot be shown unchanged: due again (recording a confirmation then stops).
  sha256_tool || return 0
  [ "$(ack_last text-version)" = "$(ack_version)" ] || return 0
  [ "$(ack_last text-sha256)" = "$(sha256_of "$ACK_FILE")" ] || return 0
  [ "$(ack_last db)" = "$(ack_image "$(ack_db_key "$DBE")")" ] || return 0
  [ "$(ack_last model)" = "$TESTED_MODEL" ] || return 0
  return 1
}

# ack_record VIA appends one record: the time, the text's version and hash, the images and the model, how it was
# confirmed (tty, yes, handover-tty, handover-yes: an installer showed the text) and the release. The line is written
# with one append, so concurrent runs cannot interleave inside it. What it proves: this tooling showed this text and a
# confirmation was given; not who gave it.
ack_record() {
  local via="$1" line v release db door
  case "$via" in tty|yes|handover-tty|handover-yes) ;; *) die "ack_record: unknown confirmation '$via'." ;; esac
  sha256_ready
  dir_private_enough . || die "Other accounts can change this directory ($(pwd)), so byodt does not record the notice here. Make it yours and not writable by others (chmod go-w .), and run the command again."
  if [ -L "$ACK_LOG" ]; then die "$ACK_LOG is a symbolic link: byodt does not write through it. Remove it and run the command again."; fi
  if [ -e "$ACK_LOG" ]; then
    owned_by_operator "$ACK_LOG" || die "$ACK_LOG is owned by uid $(path_owner "$ACK_LOG"), not by you. Move it aside and run the command again."
    [ "$(stat_field %h %l "$ACK_LOG")" = 1 ] || die "$ACK_LOG has another name (a hard link). Move it aside and run the command again."
  fi
  release="$(env_setting PLATFORM_VERSION)"
  [ -n "$release" ] || release="$(env_setting_in .env.example PLATFORM_VERSION)"
  db="$(ack_image "$(ack_db_key "$DBE")")"; door="$(ack_image PROXY_IMAGE)"
  for v in "$release" "$db" "$door" "$TESTED_MODEL"; do
    env_value_ok "$v" || die "byodt would record a value it does not write; nothing was recorded."
  done
  line="$(date -u +%Y-%m-%dT%H:%M:%SZ)	text-version=$(ack_version)	text-sha256=$(sha256_of "$ACK_FILE")	db=$db	model=$TESTED_MODEL	front-door=$door	via=$via	release=$release"
  ( umask 022; printf '%s\n' "$line" >> "$ACK_LOG" ) || die "Could not write $ACK_LOG."
}

# ack_confirm ENGINE CONTEXT shows the notice and asks, then prints how it was confirmed. --yes (YES) asks nothing and
# counts as the confirmation; otherwise a terminal must answer an explicit y; without one the command stops. CONTEXT
# ("Nothing has been downloaded yet.") follows the text, and is not part of it.
ack_confirm() {
  local reply=""
  ack_file_check
  ack_render "$1" >&2
  printf '\n%s\n' "$2" >&2
  if [ -n "$YES" ]; then
    info "--yes: counted as the confirmation of the notice above." >&2
    printf yes
    return 0
  fi
  [ -t 0 ] || die "There is no terminal to confirm the notice above on. Run the command at a terminal, or add --yes. $2"
  printf 'Continue? [y/N] ' >&2
  read -r reply || true
  case "$reply" in y|Y|yes|YES) printf tty ;; *) die "Not confirmed. $2" ;; esac
}

# deployment_started: this folder's deployment has run: a container of the project was started from this directory,
# or its database store holds data.
deployment_started() {
  local dir here_p
  here_p="$(pwd -P)"
  while IFS= read -r dir; do
    if [ -n "$dir" ] && same_dir "$dir" "$PWD" "$here_p"; then return 0; fi
  done <<< "$(project_workdirs)"
  if db_is_bind; then store_holds_data "$(db_data_setting)"
  else "$ENGINE" volume inspect "dethernety_$(db_data_setting)" >/dev/null 2>&1 </dev/null; fi
}

# ack_gate runs before a command that pulls images or downloads the model. A deployment that has not run yet confirms
# like setup. One that has, with nobody to ask (no terminal, no --yes), is never stopped: the notice is shown when it
# is due, with a warning, and a notice that cannot be shown is only warned about.
ack_gate() {
  local via context="Nothing has been downloaded yet."
  if deployment_started; then
    context="Nothing has changed yet."
    if [ -z "$YES" ] && [ ! -t 0 ]; then
      if ! ( ack_file_check && ack_check_images "$DBE" ) >/dev/null 2>&1; then
        warn "The third-party notice could not be shown ('$SELF acknowledge' says why); going on."
        return 0
      fi
      # Checked again here, so a warning about compose.override.yaml shows once, not in every subshell below.
      ack_check_images "$DBE" >/dev/null
      ack_due || return 0
      ack_render "$DBE" >&2
      warn "The notice above has not been confirmed for this deployment. Run '$SELF acknowledge' at a terminal, or with --yes, to record it."
      return 0
    fi
  fi
  ack_file_check
  ack_check_images "$DBE"
  ack_due || return 0
  # A confirmation that could not be recorded here would be asked for on every command.
  if ! dir_private_enough .; then
    [ "$context" = "Nothing has been downloaded yet." ] || { warn "Other accounts can change this directory ($(pwd)), so the third-party notice is not recorded here; going on."; return 0; }
    die "Other accounts can change this directory ($(pwd)), so byodt does not record the third-party notice here. Make it yours and not writable by others (chmod go-w .), and run the command again."
  fi
  via="$(ack_confirm "$DBE" "$context")" || exit 1
  ack_record "$via"
}

# cmd_notice [--all] prints the third-party notice for this deployment without asking; with --all, for both database
# engines, as the release's installer shows it before anything is chosen or downloaded.
cmd_notice() {
  local engine="$DBE"
  [ "$#" -le 1 ] || die "Usage: $SELF notice [--all]"
  case "${1:-}" in
    '') ;;
    --all) engine=both ;;
    *) die "Usage: $SELF notice [--all]" ;;
  esac
  ack_file_check
  ack_render "$engine"
}

cmd_acknowledge() {
  local via
  [ "$#" = 0 ] || die "acknowledge takes no arguments but --yes."
  ack_file_check
  ack_check_images "$DBE"
  via="$(ack_confirm "$DBE" "Nothing has changed.")" || exit 1
  ack_record "$via"
  info "Recorded in $ACK_LOG."
}

# --- setup: the interactive first run --------------------------------------------
#
# setup asks the few questions a first install needs, at a terminal and only for what no flag answered, and writes
# .env from .env.example through the .env writer. It writes .env.secrets only for a proxy login, and generates no
# password: the first `up` does that. With --yes it asks nothing: every question no flag answered takes its default.
# Without a terminal and without --yes it refuses at once, so it never waits for input it cannot get. A refusal leaves
# the folder as it was.

# ask PROMPT DEFAULT prints the line read from the terminal, or DEFAULT for an empty one. The end of input stops the
# command rather than taking a default nobody chose.
ask() {
  local a=""
  printf '%s ' "$1" >&2
  IFS= read -r a || die "No answer was read; nothing was changed."
  printf '%s' "${a:-$2}"
}

# ask_yes PROMPT DEFAULT (y or n): true for a yes. Anything else asks again.
ask_yes() {
  local a
  while :; do
    a="$(ask "$1" "$2")" || exit 1
    case "$a" in y|Y|yes|YES) return 0 ;; n|N|no|NO) return 1 ;; esac
  done
}

# port_ok PORT: a port number, 1 to 65535, written without a leading zero.
port_ok() {
  case "$1" in [1-9]|[1-9][0-9]|[1-9][0-9][0-9]|[1-9][0-9][0-9][0-9]|[1-9][0-9][0-9][0-9][0-9]) [ "$1" -le 65535 ] ;; *) return 1 ;; esac
}

# default_volume ENGINE prints the named volume ENGINE's compose file declares for its data.
default_volume() { if [ "$1" = neo4j ]; then printf neo4j-data; else printf memgraph-data; fi; }

# proxy_login_ok LOGIN: user:password with one colon, a user, and only the characters a value may hold. resolve_proxy
# checks the rest of the proxy's grammar once the files are written.
proxy_login_ok() {
  env_value_ok "$1" || return 1
  case "$1" in ?*:*) ;; *) return 1 ;; esac
  case "${1#*:}" in *:*) return 1 ;; esac
}

# vm_backed_runtime: the engine runs its containers in a virtual machine (Docker Desktop, or a Podman machine), where a
# bind-mounted database directory crosses the machine's file sharing.
vm_backed_runtime() {
  case "$ENGINE" in
    docker) docker info --format '{{.OperatingSystem}}' 2>/dev/null </dev/null | grep -qi 'docker desktop' ;;
    podman) case "$(uname -s)" in Darwin|MINGW*|MSYS*|CYGWIN*) return 0 ;; esac; return 1 ;;
    *) return 1 ;;
  esac
}

setup_usage() {
  cat <<EOT
${BOLD}$SELF setup${RST} — the first run: choose the settings, write .env, and optionally start

  --db memgraph|neo4j        the graph database (default memgraph)
  --db-data bind|volume      where the database keeps its data; asked on Docker Desktop or a Podman machine
                             (default there: volume; elsewhere: bind, ./data/<engine>)
  --bind 127.0.0.1|0.0.0.0   who can reach the console and the platform (default 127.0.0.1, this machine only)
  --port N                   the published port (default 3000)
  --https-proxy URL          the outbound HTTPS proxy, http://host:port, with no login in it (default: none)
  --no-proxy LIST            more hosts to reach directly, comma-separated
  --proxy-ca FILE            the CA certificate of a TLS-inspecting proxy (PEM)
  --proxy-login-from-env     take the proxy login from BYODT_SETUP_PROXY_USERINFO, as an installer passes it; a login
                             is never a flag, so that it does not show in the process list
  --start | --no-start       start the stack when done (default: no)
  --yes                      ask nothing: every question no flag answered takes its default, and the third-party
                             notice counts as confirmed (it is printed either way)
  --third-party-acknowledged SHA256
                             an installer showed the third-party notice with this hash; setup does not show it again
EOT
}

# The answers, settled before anything is written.
S_DB="" S_DATA="" S_BIND="" S_PORT="" S_URL="" S_NO="" S_CA="" S_LOGIN="" S_START="" S_LOGIN_ENV="" S_HANDOVER=""
# What setup created, for a refusal to remove again.
S_MADE_SECRETS="" S_MADE_CA_DIR="" S_MADE_CA="" S_MADE_RELEASE=""

# setup_flags ARGS… reads and checks the flags, before anything is asked or written.
setup_flags() {
  local opt val
  while [ "$#" -gt 0 ]; do
    opt="$1"; shift
    case "$opt" in
      --proxy-login-from-env=*|--start=*|--no-start=*|--yes=*|--help=*) die "${opt%%=*} takes no value." ;;
      --*=*) val="${opt#*=}"; opt="${opt%%=*}" ;;
      --db|--db-data|--bind|--port|--https-proxy|--no-proxy|--proxy-ca|--third-party-acknowledged)
        [ "$#" -gt 0 ] || die "$opt needs a value."; val="$1"; shift ;;
      *) val="" ;;
    esac
    case "$opt" in
      --db) S_DB="$val" ;;
      --db-data) S_DATA="$val" ;;
      --bind) S_BIND="$val" ;;
      --port) S_PORT="$val" ;;
      --https-proxy) S_URL="$val" ;;
      --no-proxy) S_NO="$val" ;;
      --proxy-ca) S_CA="$(caller_path "$val")" ;;
      --proxy-login-from-env) S_LOGIN_ENV=1 ;;
      --third-party-acknowledged) S_HANDOVER="$val" ;;
      --start) S_START=yes ;;
      --no-start) S_START=no ;;
      --yes) YES=1 ;;
      -h|--help) setup_usage; exit 0 ;;
      *) die "Unknown option for setup: $opt (see '$SELF setup --help')." ;;
    esac
  done
  case "$S_DB" in ''|memgraph|neo4j) ;; *) die "--db is memgraph or neo4j." ;; esac
  case "$S_DATA" in ''|bind|volume) ;; *) die "--db-data is bind or volume." ;; esac
  case "$S_BIND" in ''|127.0.0.1|0.0.0.0) ;; *) die "--bind is 127.0.0.1 or 0.0.0.0. For another address, edit FRONT_DOOR_BIND in $ENV_FILE after setup." ;; esac
  [ -z "$S_PORT" ] || port_ok "$S_PORT" || die "--port is a number from 1 to 65535."
  setup_check_url "$S_URL" || exit 1
  env_value_ok "$S_NO" || die "--no-proxy holds a character a host list cannot: separate the hosts with commas only."
  [ -z "$S_CA" ] || setup_check_ca "$S_CA" || exit 1
  case "$S_HANDOVER" in
    '') ;;
    *[!0-9a-f]*) die "--third-party-acknowledged is a SHA-256: 64 lowercase hexadecimal characters." ;;
    *) [ "${#S_HANDOVER}" = 64 ] || die "--third-party-acknowledged is a SHA-256: 64 lowercase hexadecimal characters." ;;
  esac
}

# caller_path PATH prints PATH as given from the directory byodt was run in: byodt itself runs in the bundle.
caller_path() {
  case "$1" in ''|/*) printf '%s' "$1" ;; *) printf '%s/%s' "$CALLER_DIR" "$1" ;; esac
}

# setup_check_url URL: empty, or a value with no login in it (a login in .env would be readable by every account, and
# in a flag it shows in the process list). resolve_proxy checks the rest once the files are written.
setup_check_url() {
  env_value_ok "$1" || { warn "That proxy URL holds a character a URL cannot: write it as http://host:port."; return 1; }
  case "$1" in
    *@*) warn "Give the proxy URL without its login (http://host:port). The login goes in at setup's prompt, or through BYODT_SETUP_PROXY_USERINFO with --proxy-login-from-env."; return 1 ;;
  esac
}

# setup_check_ca FILE: a readable PEM certificate with no private key in it, since it becomes a root the stack trusts.
setup_check_ca() {
  if [ ! -f "$1" ] || [ ! -r "$1" ]; then warn "$1 is not a readable file."; return 1; fi
  grep -q -- '-----BEGIN CERTIFICATE-----' "$1" || { warn "$1 holds no PEM certificate (-----BEGIN CERTIFICATE-----)."; return 1; }
  if grep -q -- 'PRIVATE KEY' "$1"; then warn "$1 holds a private key. Give the CA certificate alone."; return 1; fi
}

# setup_proxy_questions asks the proxy's questions at a terminal: the URL (when no flag gave one), the extra direct
# hosts, the login and the CA, asking again for an answer that cannot be used. The installer's login is offered only
# when it is well formed, and is saved only with --proxy-login-from-env or a yes: a shell's proxy login is often a
# domain credential.
setup_proxy_questions() {
  local installer_login="$SETUP_PROXY_LOGIN"
  if [ -n "$installer_login" ] && ! proxy_login_ok "$installer_login"; then
    warn "The proxy login the installer passed is not user:password with the password percent-encoded; it is not used."
    installer_login=""
  fi
  if [ -z "$TTY" ]; then
    if [ -n "$S_LOGIN_ENV" ]; then
      [ -n "$installer_login" ] || die "--proxy-login-from-env, but BYODT_SETUP_PROXY_USERINFO holds no usable login. Nothing was changed."
      S_LOGIN="$installer_login"
    elif [ -n "$installer_login" ]; then
      warn "The proxy login the installer was given is not saved: add --proxy-login-from-env to save it, or put HTTPS_PROXY_USERINFO in $SECRETS_FILE yourself."
    fi
    return 0
  fi
  if [ -z "$S_URL" ]; then
    ask_yes "Does this machine reach the internet only through an HTTPS proxy? [y/N]" n || return 0
    while :; do
      S_URL="$(ask "The proxy, as http://host:port:" "")" || exit 1
      [ -n "$S_URL" ] && setup_check_url "$S_URL" && break
    done
  fi
  if [ -z "$S_NO" ]; then
    while :; do
      S_NO="$(ask "More hosts to reach directly, comma-separated (empty for none):" "")" || exit 1
      env_value_ok "$S_NO" && break
      warn "Separate the hosts with commas only."
    done
  fi
  if [ -n "$installer_login" ] && { [ -n "$S_LOGIN_ENV" ] || ask_yes "Save the proxy login for user '${installer_login%%:*}' that the installer was given? [y/N]" n; }; then
    S_LOGIN="$installer_login"
  elif [ -z "$installer_login" ]; then
    while :; do
      printf 'The proxy login as user:password, the password percent-encoded (empty for none): ' >&2
      IFS= read -r -s S_LOGIN || die "No answer was read; nothing was changed."
      printf '\n' >&2
      [ -z "$S_LOGIN" ] || proxy_login_ok "$S_LOGIN" && break
      warn "Give the login as user:password with one colon, and percent-encode the password (a # as %23, / as %2F, @ as %40, \$ as %24, a space as %20)."
    done
  fi
  if [ -z "$S_CA" ]; then
    while :; do
      S_CA="$(ask "The CA certificate file of a TLS-inspecting proxy (empty for none):" "")" || exit 1
      S_CA="$(caller_path "$S_CA")"
      [ -z "$S_CA" ] || setup_check_ca "$S_CA" && break
    done
  fi
}

# setup_questions settles every answer no flag gave: at a terminal by asking, with --yes by the defaults.
setup_questions() {
  if [ -z "$S_DB" ]; then
    if [ -n "$TTY" ]; then
      while :; do
        S_DB="$(ask "Graph database, memgraph or neo4j [memgraph]:" memgraph)" || exit 1
        case "$S_DB" in memgraph|neo4j) break ;; esac
      done
    else S_DB=memgraph; fi
  fi
  DBE="$S_DB"
  ack_file_check
  ack_check_images "$DBE"
  # The installer showed the same text, at a terminal or under --yes, and nothing here needs the [mirror] paragraph.
  if [ -n "$S_HANDOVER" ] && [ "$S_HANDOVER" = "$(sha256_of "$ACK_FILE")" ] && [ -z "$(ack_mirror_keys "$DBE")" ]; then
    if [ -n "$TTY" ]; then S_VIA=handover-tty; else S_VIA=handover-yes; fi
  else
    S_VIA="$(ack_confirm "$DBE" "Nothing has been downloaded yet.")" || exit 1
  fi
  if [ -z "$S_DATA" ] && vm_backed_runtime; then
    if [ -n "$TTY" ]; then
      info "This engine runs containers in a virtual machine. A database bind-mounted across its file sharing can be corrupted; the named volume avoids that."
      if ask_yes "Keep the database in the engine's named volume? [Y/n]" y; then S_DATA=volume; else S_DATA=bind; fi
    else S_DATA=volume; fi
  fi
  if [ -z "$S_BIND" ]; then
    S_BIND=127.0.0.1
    if [ -n "$TTY" ] && ask_yes "Reach the console and the platform from other machines too (binds 0.0.0.0)? [y/N]" n; then S_BIND=0.0.0.0; fi
  fi
  if [ -z "$S_PORT" ]; then
    S_PORT=3000
    if [ -n "$TTY" ]; then
      while :; do
        S_PORT="$(ask "Port [3000]:" 3000)" || exit 1
        port_ok "$S_PORT" && break
      done
    fi
  fi
  setup_proxy_questions
  if [ -n "$S_LOGIN" ] && [ -z "$S_URL" ]; then die "A proxy login without a proxy URL: give --https-proxy too. Nothing was changed."; fi
  if [ -z "$S_START" ]; then
    S_START=no
    if [ -n "$TTY" ] && ask_yes "Start the stack now? [y/N]" n; then S_START=yes; fi
  fi
}

# setup_undo removes what setup wrote, after a refusal.
setup_undo() {
  rm -f "$ENV_FILE"
  if [ -n "$S_MADE_SECRETS" ]; then rm -f "$SECRETS_FILE"; fi
  if [ -n "$S_MADE_CA" ]; then rm -f proxy-ca/proxy-ca.pem; fi
  if [ -n "$S_MADE_CA_DIR" ]; then rmdir proxy-ca 2>/dev/null || true; fi
  if [ -n "$S_MADE_RELEASE" ]; then rm -f "$RELEASE_FILE"; fi
  S_MADE_SECRETS="" S_MADE_CA_DIR="" S_MADE_CA="" S_MADE_RELEASE=""
}

# setup_write writes the answers: .env from .env.example, the login into a new .env.secrets, the CA into proxy-ca/.
setup_write() {
  [ -e "$RELEASE_FILE" ] || S_MADE_RELEASE=1
  release_record_initial
  cp .env.example "$ENV_FILE"
  env_write "$ENV_FILE" DB_ENGINE "$S_DB"
  if [ "$S_DATA" = volume ]; then
    if [ "$S_DB" = neo4j ]; then env_write "$ENV_FILE" NEO4J_DATA "$(default_volume neo4j)"; else env_write "$ENV_FILE" DB_DATA "$(default_volume memgraph)"; fi
  fi
  env_write "$ENV_FILE" FRONT_DOOR_BIND "$S_BIND"
  env_write "$ENV_FILE" FRONT_DOOR_PORT "$S_PORT"
  if [ -n "$S_URL" ]; then
    env_write "$ENV_FILE" HTTPS_PROXY "$S_URL"
    [ -z "$S_NO" ] || env_write "$ENV_FILE" NO_PROXY "$S_NO"
  fi
  if [ -n "$S_LOGIN" ]; then
    S_MADE_SECRETS=1
    env_write "$SECRETS_FILE" HTTPS_PROXY_USERINFO "$S_LOGIN"
  fi
  if [ -n "$S_CA" ]; then
    if [ ! -e proxy-ca ] && [ ! -L proxy-ca ]; then mkdir -m 0755 proxy-ca; S_MADE_CA_DIR=1; fi
    # The directory passes the same checks every later command makes before anything is put in it.
    check_proxy_ca
    if [ -e proxy-ca/proxy-ca.pem ] || [ -L proxy-ca/proxy-ca.pem ]; then die "proxy-ca/proxy-ca.pem already exists; move it aside to give another one."; fi
    if [ -e proxy-ca/.proxy-ca.pem.tmp ] || [ -L proxy-ca/.proxy-ca.pem.tmp ]; then die "proxy-ca/.proxy-ca.pem.tmp exists, left by an earlier run. Remove it and run the command again."; fi
    ( set -C; umask 022; cat -- "$S_CA" > proxy-ca/.proxy-ca.pem.tmp ) || die "Could not copy $S_CA into proxy-ca/."
    chmod 0644 proxy-ca/.proxy-ca.pem.tmp && mv -f proxy-ca/.proxy-ca.pem.tmp proxy-ca/proxy-ca.pem || die "Could not put the CA certificate in place."
    S_MADE_CA=1
  fi
}

# setup_report says what was written and what to watch for, once the folder is set up.
setup_report() {
  info "Wrote $ENV_FILE: DB_ENGINE=$S_DB, FRONT_DOOR_BIND=$S_BIND, FRONT_DOOR_PORT=$S_PORT${S_URL:+, HTTPS_PROXY=$S_URL}${S_DATA:+ (database storage: $S_DATA)}."
  [ -z "$S_MADE_SECRETS" ] || info "Wrote the proxy login to $SECRETS_FILE (mode 0600)."
  [ -z "$S_MADE_CA" ] || info "Copied the proxy's CA certificate to proxy-ca/proxy-ca.pem."
  [ "$S_PORT" = 3000 ] || info "Port $S_PORT: 3000 is a pre-registered loopback address for cloud sign-in; another port may need the identity provider to know it."
  if (exec 3<>"/dev/tcp/127.0.0.1/$S_PORT") 2>/dev/null; then warn "Something already answers on 127.0.0.1:$S_PORT; the start may fail until it is free."; fi
  if [ "$S_BIND" = 0.0.0.0 ]; then
    warn "Bound to 0.0.0.0: with the standalone defaults, anyone who can reach port $S_PORT has full access. Put it behind your own authenticated front door, and use TLS."
    if [ -n "$TTY" ] && ask_yes "Generate a self-signed TLS certificate now ('$SELF tls generate')? [y/N]" n; then tls_generate; else info "TLS: '$SELF tls generate', then '$SELF restart proxy'."; fi
  fi
}

TTY="" S_VIA=""

cmd_setup() {
  local img missing="" try=0
  setup_flags "$@"
  if [ -e "$ENV_FILE" ] || [ -L "$ENV_FILE" ]; then
    die "$ENV_FILE exists: this folder is already set up. Edit $ENV_FILE, or move it aside to run setup again."
  fi
  if [ -e "$SECRETS_FILE" ] || [ -L "$SECRETS_FILE" ]; then
    die "$SECRETS_FILE exists: this folder has run before. Restore its $ENV_FILE instead of running setup, or move $SECRETS_FILE aside."
  fi
  [ -f .env.example ] || die ".env.example is missing: unpack the bundle again."
  if [ -z "$YES" ]; then
    [ -t 0 ] || die "setup asks its questions at a terminal. Without one, add --yes, with flags for anything other than the defaults ('$SELF setup --help'). Nothing was changed."
    TTY=1
  fi
  resolve_engine
  setup_questions

  # A start is checked before anything is written, so a refused one leaves the folder as it was.
  if [ "$S_START" = yes ]; then
    check_project
    [ "$S_DATA" != volume ] || check_project_volume "$(default_volume "$S_DB")" setup
  fi
  warn_old_volumes "$S_DATA" "$(default_volume "$S_DB")"

  # Write, then check the proxy with the checks every later command makes (resolve_proxy, from the files just
  # written). Anything that stops the command before the record is written removes what was written; at a terminal,
  # a refused proxy is asked for again.
  trap setup_undo EXIT
  while :; do
    setup_write
    if [ -z "$S_URL" ] && [ -z "$S_CA" ]; then break; fi
    if ( resolve_proxy ) >&2; then break; fi
    setup_undo
    try=$((try + 1))
    if [ -z "$TTY" ] || [ "$try" -ge 3 ]; then die "The proxy settings were refused (see above). Nothing was changed."; fi
    warn "The proxy settings were refused (see above); asking again."
    S_URL="" S_NO="" S_CA="" S_LOGIN=""
    setup_proxy_questions
    if [ -n "$S_LOGIN" ] && [ -z "$S_URL" ]; then die "A proxy login without a proxy URL: give --https-proxy too. Nothing was changed."; fi
  done
  ack_record "$S_VIA"
  trap - EXIT
  SETUP_PROXY_LOGIN="" S_LOGIN=""

  setup_report
  if [ "$S_START" != yes ]; then
    info "Ready. Start with: ${BOLD}$SELF up${RST}"
    return 0
  fi
  for img in "$(ack_image "$(ack_db_key "$DBE")")" "$(ack_image PROXY_IMAGE)"; do
    "$ENGINE" image inspect "$img" >/dev/null 2>&1 </dev/null || missing="$missing $img"
  done
  info "Starting. It downloads the platform and console images${missing:+, and$missing}, then the embedding model (about 1.26 GB) on the first start."
  exec ./byodt up
}

# --- upgrade: move this deployment to a newer release -------------------------------------------------------------------
#
# `upgrade [VERSION]` runs in three phases, and the target release's own code runs the last two:
#   1. here (or in a release's installer): find the target, download its bundle into a private staging directory
#      inside this deployment, verify it (the SHA-256 the release wrote into its get-byodt.sh; with cosign, the release
#      workflow's signature), unpack it, and hand over to the staged byodt with `upgrade --staged`;
#   2. the staged byodt: check everything first (local edits, the .env changes, CONSOLE_IMAGE, the project, disk, the
#      database), ask every question at once, back up (the graph with this deployment's own byodt, .env, and the shipped
#      files as they are), then move the new files in by rename, journalled, and hand over to `upgrade --finish`;
#   3. the moved-in byodt: .env, `update`, the health check, and the exact rollback steps.
# Each phase is recorded in UPGRADE_STATE, so an interruption can be resumed or undone (`upgrade` again, or
# `upgrade --abandon`). One lock covers all three phases: each hands over to the next by exec, which keeps the process.
# Files are only ever renamed into place, never written over: a running byodt keeps reading the file it started from.

readonly BYODT_RELEASE_REPO="dether-net/dethernety-oss"
readonly RELEASE_FILE=".byodt-release"
readonly UPGRADE_STATE=".byodt-upgrade.state"
readonly UPGRADE_LOCK=".byodt-upgrade.lock"
# The least free space, in KiB, an upgrade starts with: the new images and the backups need room.
readonly UPGRADE_MIN_FREE_KB=2097152
# The largest bundle, signature bundle and installer an upgrade downloads.
readonly UPGRADE_MAX_BUNDLE_BYTES=52428800
readonly UPGRADE_MAX_SMALL_BYTES=1048576

# known_manifest VERSION prints the SHA-256 and path of every file VERSION's bundle shipped, for a release older than
# the RELEASE_FILE a deployment now keeps. It is the base the upgrade checks local edits against.
known_manifest() {
  case "$1" in
    0.13.0) cat <<'MANIFEST'
