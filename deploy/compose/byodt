#!/usr/bin/env bash
# byodt — manage this Dethernety deployment.
#
# A thin, verb-driven wrapper over Docker or Podman Compose for the compose bundle: it carries the two env
# files every command needs (.env + .env.secrets), folds in first-run setup, and gives the common
# operations plain names. Run it from anywhere — it operates on the bundle it lives in.
#
#   ./byodt up        # bootstrap (first run) + start
#   ./byodt help      # all commands
set -euo pipefail

cd "$(dirname "$0")"

readonly BYODT_VERSION="1.2.0"
readonly ENV_FILE=".env"
readonly SECRETS_FILE=".env.secrets"
readonly MODE_FILE="mode/mode.env"
# The database image this bundle was tested with. DB_IMAGE in .env is copied once from .env.example and
# kept across upgrades, so a deployment can run another database than the bundle was tested with.
readonly TESTED_DB_IMAGE="docker.io/memgraph/memgraph:3.13.2"
SELF="$(basename "$0")"

# --- output -------------------------------------------------------------------
if [ -t 1 ]; then
  BOLD=$(printf '\033[1m'); RED=$(printf '\033[31m'); GRN=$(printf '\033[32m'); YEL=$(printf '\033[33m'); RST=$(printf '\033[0m')
else
  BOLD=""; RED=""; GRN=""; YEL=""; RST=""
fi
info() { printf '%s==>%s %s\n' "$GRN" "$RST" "$*"; }
warn() { printf '%swarning:%s %s\n' "$YEL" "$RST" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$RED" "$RST" "$*" >&2; exit 1; }

# --- helpers ------------------------------------------------------------------

# compose — the single chokepoint every compose invocation goes through.
#
# ONE --env-file, never two. Docker Compose v2 merges repeated --env-file flags; podman-compose
# honours only the LAST, which silently dropped .env and left every interpolated value empty —
# images, the published port, the database user, all of it. What made that read as an image
# problem rather than a total one is that the values carrying a `:-default` in compose.yaml fell
# back and looked healthy, so only the defaulted-less ones showed as blank.
#
# So .env is the one file passed, and the two values compose needs that are not in it are exported
# into the environment instead — process environment outranks --env-file in both providers:
#
#   NEO4J_PASSWORD  lives in .env.secrets (mode 0600). Exporting it keeps it out of any file
#                   sitting beside the readable config, which merging the two would have created.
#   CONSOLE_IMAGE   is derived here because compose.yaml cannot derive it: podman-compose does not
#                   expand a nested ${VAR} inside a `:-default`, so a self-referencing default
#                   reached the engine as a literal. Deriving it host-side keeps PLATFORM_VERSION
#                   the single version knob without depending on nested interpolation.
compose() {
  resolve_engine
  local pw img dbu
  pw="$(secret_value NEO4J_PASSWORD "")"
  img="$(console_image)"
  # The verb is passed to db_user because it decides whether the probe may PULL, not whether it runs.
  # Deriving only for `up` was tried and was wrong: `compose config` is the verb an operator reaches for
  # to see what will actually run, and reporting an empty user there — while `up` quietly used a real
  # one — makes the introspection command lie about the thing it exists to show. CI asserts a non-empty
  # user precisely to catch the derivation silently stopping.
  dbu="$(db_user "${1:-}")"
  NEO4J_PASSWORD="$pw" CONSOLE_IMAGE="$img" DB_USER="$dbu" \
    "$ENGINE" compose --env-file "$ENV_FILE" "$@"
}

# db_user — the uid:gid the database container runs as. Memgraph refuses to start unless its data
# directory is owned by the uid it runs as; that is an OWNERSHIP check, so no chmod satisfies it, and
# the owner it compares against is whoever the directory appears to belong to INSIDE the container.
#
#   named volume   the engine creates it owned by the image's own user, which already matches.
#                  Empty here, so the image default stands.
#   bind mount     depends on the engine, and it cannot be inferred from the engine's NAME. So this
#                  asks the engine directly, with a throwaway container that stats the directory.
#
# WHY IT IS A PROBE RATHER THAN A RULE. This function used to answer from the engine name: root under
# Podman (rootless maps the operator to root inside), the operator's own uid under Docker. The second
# half is true of Docker Engine on Linux, where uids pass through — and FALSE on Docker Desktop, whose
# VM file-sharing layer presents every bind mount as root-owned no matter who owns it on the host. So
# on macOS and Windows the database was handed a uid that could not match, and refused to start on a
# default deployment. Running as root there is also harmless, because the same sharing layer maps new
# files back to the host user; on native Linux it would litter the host with root-owned data, which is
# why "just use root" is not the fix and the answer has to be per-environment.
#
# THE FAILURE IT PRODUCED IS WORTH KNOWING, because it names the wrong file. As a non-root uid the
# container also cannot write /var/log/memgraph (mode 0750, owned by the image's own user), so the
# database died reporting a log-file permission error — while the actual fault was the data directory's
# ownership, which it could not tell anyone about. Fixing the uid fixes both; a log-directory mount
# fixes neither.
#
# COST, AND THE ONE THING THE VERB DECIDES. The probe is a short-lived container, so it needs the image
# — and on a deployment that has not pulled anything yet, a bare `status` must not become an image
# download. So the verb is consulted for exactly one purpose: `up` is about to pull that image anyway
# and may block on it; every other verb probes only if the image is ALREADY local, and otherwise falls
# back. The value is therefore always derived and never empty, which is what `compose config` shows and
# what CI asserts.
db_user() {
  db_is_bind || { printf ''; return 0; }
  local verb="${1:-}" dir image owner
  dir="$(env_value DB_DATA ./data/memgraph)"
  image="$(env_value DB_IMAGE '')"
  owner=""
  if [ -n "$image" ] && { [ "$verb" = "up" ] || "$ENGINE" image inspect "$image" >/dev/null 2>&1; }; then
    owner="$("$ENGINE" run --rm -v "$dir:/probe" --entrypoint sh "$image" \
               -c 'stat -c "%u:%g" /probe' 2>/dev/null | tr -d '\r\n')"
  fi
  case "$owner" in
    # Anything else — no image pulled yet, an engine that refuses the mount, a stat that printed
    # nothing — falls back to the old rule rather than failing the command. It is right on Linux and
    # right under Podman, which is where a probe is least likely to be the thing that broke.
    [0-9]*:[0-9]*) printf '%s' "$owner" ;;
    *) case "$ENGINE" in
         podman) printf '0:0' ;;
         *)      printf '%s:%s' "$(id -u)" "$(id -g)" ;;
       esac ;;
  esac
}

# console_image — the console image reference compose is given. An operator's own CONSOLE_IMAGE
# wins (exported, or set in .env) so a mirror stays repointable; otherwise it is the release image
# at PLATFORM_VERSION. The platform image interpolates ${PLATFORM_VERSION} directly in compose.yaml,
# so both images follow the one knob and cannot drift apart.
console_image() {
  local pin
  pin="${CONSOLE_IMAGE:-$(env_value CONSOLE_IMAGE "")}"
  if [ -n "$pin" ]; then
    printf '%s' "$pin"
    return 0
  fi
  printf 'ghcr.io/dether-net/byodt-console:%s' "$(env_value PLATFORM_VERSION "")"
}

# The container engine ("docker" or "podman"), settled once by resolve_engine.
ENGINE=""

# engine_ok NAME — true when NAME is on PATH and its `compose` subcommand runs. The compose
# probe is the point: it rejects a bare engine with no Compose provider, and it is the same
# check used both to auto-detect and to validate an explicit choice.
engine_ok() { command -v "$1" >/dev/null 2>&1 && "$1" compose version >/dev/null 2>&1; }

# resolve_engine settles which engine runs the stack, once, into ENGINE. Precedence: an
# exported CONTAINER_ENGINE (one-off override) > the value persisted in .env > auto-detection,
# Docker first then Podman. Whatever it lands on, it validates that engine's compose is usable,
# so a wrong choice fails here with a clear message instead of deep inside a compose call.
# Persisting a detected value into .env is ensure_engine's job, not this function's.
resolve_engine() {
  [ -n "$ENGINE" ] && return 0
  local choice="${CONTAINER_ENGINE:-}"
  if [ -z "$choice" ] && [ -f "$ENV_FILE" ]; then
    choice="$(env_value CONTAINER_ENGINE "")"
  fi
  if [ -z "$choice" ]; then
    if engine_ok docker; then choice="docker"
    elif engine_ok podman; then choice="podman"
    else die "No usable container engine — install Docker (with the Compose plugin) or Podman 4.1+ (a Compose provider, plus a running machine on macOS), or set CONTAINER_ENGINE in $ENV_FILE."
    fi
  elif ! engine_ok "$choice"; then
    die "CONTAINER_ENGINE=$choice, but '$choice compose' failed — check that $choice and its Compose provider are installed, and (macOS/Podman) that its machine is running ('podman machine start'); or set a different CONTAINER_ENGINE in $ENV_FILE."
  fi
  ENGINE="$choice"
}

require_engine() { resolve_engine; }

# ready reports whether the bundle is in a startable state: the env files, a database password, and the
# mode layer compose mounts as an env_file. Anything missing means `up` still has setup to do.
ready() {
  [ -f "$ENV_FILE" ] || return 1
  [ -f "$SECRETS_FILE" ] || return 1
  grep -Eq '^NEO4J_PASSWORD=.+' "$SECRETS_FILE" || return 1
  [ -f "$MODE_FILE" ]
}

ensure_ready() {
  ready || die "Not set up yet — run '$SELF bootstrap' (or just '$SELF up', which does it for you)."
}

# env_value KEY DEFAULT — read a key from .env, falling back to DEFAULT.
env_value() {
  local key="$1" def="$2" val=""
  if [ -f "$ENV_FILE" ]; then
    val="$(grep -E "^$key=" "$ENV_FILE" 2>/dev/null | tail -1 | cut -d= -f2- || true)"
  fi
  printf '%s' "${val:-$def}"
}

# secret_value KEY DEFAULT — read a key from .env.secrets (mode 0600), falling back to DEFAULT.
# Host-side only: the wrapper reads the secret to pass DB credentials to mgconsole; it never
# exposes .env.secrets to a container (the console is deliberately walled off from it).
secret_value() {
  local key="$1" def="$2" val=""
  if [ -f "$SECRETS_FILE" ]; then
    val="$(grep -E "^$key=" "$SECRETS_FILE" 2>/dev/null | tail -1 | cut -d= -f2- || true)"
  fi
  printf '%s' "${val:-$def}"
}

# db_is_bind — true when the database stores data in a host bind mount (DB_DATA is a path), false
# when it uses a named volume. Governs whether ensure_layout makes the host dir and how destroy wipes.
db_is_bind() {
  case "$(env_value DB_DATA ./data/memgraph)" in
    .*|/*) return 0 ;;
    *)     return 1 ;;
  esac
}

front_door_url() {
  # Follow the certificate: with one installed the proxy serves HTTPS only, and an http:// URL
  # earns nginx's "plain HTTP request was sent to an HTTPS port" — which `console` would hand
  # straight to the browser.
  local scheme=http
  [ -f tls/cert.pem ] && [ -f tls/key.pem ] && scheme=https
  printf '%s://%s:%s/console/' "$scheme" "$(env_value FRONT_DOOR_BIND 127.0.0.1)" "$(env_value FRONT_DOOR_PORT 3000)"
}

gen_secret() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex 24
  else
    dd if=/dev/urandom bs=24 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n'
  fi
}

# ensure_engine records the resolved engine in .env on first run, so every later command uses the
# same one (fresh auto-detection could pick differently if the host later gains a second engine)
# and the operator can see and change it. No-op once an active CONTAINER_ENGINE line exists.
ensure_engine() {
  resolve_engine
  [ -f "$ENV_FILE" ] || return 0
  if grep -Eq '^CONTAINER_ENGINE=' "$ENV_FILE"; then return 0; fi
  printf '\n# Container engine, recorded by byodt on first run — edit to change.\nCONTAINER_ENGINE=%s\n' "$ENGINE" >> "$ENV_FILE"
  info "Container engine: ${BOLD}$ENGINE${RST} (recorded CONTAINER_ENGINE in $ENV_FILE)."
}

# ensure_layout brings the on-disk bundle to a startable state: the .env file, the runtime directories
# (world-writable, since the console one-shot and daemon write into them under an unprivileged uid that
# need not match the operator's), and the pure open-source mode layer. It is idempotent and silent when
# nothing is missing, so `up` runs it every time — a deployment that lost any of this (a fresh copy, a
# removed dir) self-heals here rather than failing inside compose on a missing env_file or bind mount.
# path_owner PATH prints the uid owning PATH itself (a symlink is not followed): GNU stat, else BSD stat.
path_owner() {
  stat -c %u "$1" 2>/dev/null || stat -f %u "$1"
}
# owned_by_operator PATH: PATH belongs to the user running byodt, to the user who ran it through sudo, or to root.
owned_by_operator() {
  local owner; owner="$(path_owner "$1")" || return 1
  [ "$owner" = "$(id -u)" ] || [ "$owner" = "${SUDO_UID:-}" ] || [ "$owner" = 0 ]
}
# refuse_foreign_entry PATH stops when PATH exists but another local account made it (see ensure_layout): chmod would
# widen whatever a link points at, and the owner of a directory under the sticky data/ can still swap it for a link,
# or rename what is in it, after any check.
refuse_foreign_entry() {
  { [ -e "$1" ] || [ -L "$1" ]; } || return 0
  owned_by_operator "$1" && return 0
  if [ -L "$1" ]; then
    die "$1 is a symbolic link owned by uid $(path_owner "$1"), not by you: byodt will not follow it. Check where it points (ls -l $1), remove the link, and run the command again."
  fi
  die "$1 is owned by uid $(path_owner "$1"), not by you: another account could replace it, or what is in it. Check what it holds (ls -la $1). If it is this deployment's own (the bundle moved to your account), give it to you: sudo chown -R \"\$(id -u):\$(id -g)\" $1. Otherwise move it aside. Then run the command again."
}

ensure_layout() {
  if [ ! -f "$ENV_FILE" ]; then
    cp .env.example "$ENV_FILE"
    info "Created $ENV_FILE from .env.example — review it before starting."
  fi
  ensure_engine

  # Pre-create the runtime dirs a rootless engine (Podman) container must write as world-writable, so
  # the container uid — which need not match the operator — can still write them. data/memgraph is a
  # bind-mount dir only when DB_DATA is a path; a named volume needs no host dir, so make it only in
  # bind mode. tls/ is deliberately NOT in this list: the proxy mounts it read-only and only the
  # operator writes it (via `tls generate`), so a 0777 dir there would just let any local user replace
  # the private key and force the plaintext fallback. Keep it 0700, and don't re-widen it each `up`.
  # data/memgraph-log is in this list for the reason the comment beside its mount in compose.yaml
  # gives: the database image's log directory is writable only by the image's own user, and in bind
  # mode the container runs as the operator instead. World-writable here covers both, and covers them
  # without this script having to know which mode is in play.
  #
  # data/ carries the STICKY BIT, and of its children only data/models does (below); the others do not, and
  # the asymmetry is the point. Every path widened below is chmod'ed by name, and chmod follows a symlink —
  # so an entry replaced by a link before this runs gets the link's TARGET widened instead, under the
  # operator's identity. Only the children of data/ are replaceable that way: every other widened dir is an
  # entry in the bundle root, which is 0755 and the operator's. Sticky on data/ stops a non-owner unlinking
  # those entries at all, and costs nothing, because this function creates them and no container renames
  # them. It is deliberately NOT applied to modules/, schema/ or mode/, whose entries ARE created and
  # replaced by containers: sticky there would refuse a replacement written under a different uid than the
  # one that installed it, which is what a module install becomes after the engine changes. The bit is set
  # before anything below is widened, so the ordering opens no window of its own.
  #
  # An entry planted BEFORE the run that creates it (the first run, or the upgrade that adds a runtime dir
  # such as data/models) would still be followed, so every widened child of data/ must be the operator's own
  # (refuse_foreign_entry), a link or not: the link an operator uses to move a multi-gigabyte cache onto
  # another disk passes, while a link or a directory another local account planted is refused before anything
  # follows or widens it. Its owner could swap a directory of its own for a link after any check. The end
  # state is not a wider guard here but narrower permissions: give each service a uid that matches its
  # directory's owner and none of this has to be world-writable at all.
  #
  # The check runs again after the entries exist and before anything is widened: an entry planted between the first
  # check and the mkdir (the run that creates it) is caught there, and once the operator's entry of the sticky data/
  # exists no other account can replace it, so the second check still holds when the chmod runs.
  #
  # data/models gets the sticky bit too: the platform loads what is in it as a model, after checking it by path, so
  # no account but an entry's owner may rename or delete one there. The platform refuses an entry below it that
  # another account owns or every account can write.
  mkdir -p data && chmod 1777 data
  local d
  for d in data/content-cache data/memgraph-log data/models data/memgraph; do refuse_foreign_entry "$d"; done
  mkdir -p modules schema data/content-cache data/memgraph-log data/models mode
  if db_is_bind; then mkdir -p data/memgraph; fi
  for d in data/content-cache data/memgraph-log data/models data/memgraph; do refuse_foreign_entry "$d"; done
  chmod 0777 modules schema data/content-cache data/memgraph-log mode
  chmod 1777 data/models
  mkdir -p tls && chmod 0700 tls
  if db_is_bind; then chmod 0777 data/memgraph; fi

  # compose.yaml bind-mounts this as a FILE. A container engine handed a bind source that does not
  # exist invents a DIRECTORY there — and then console-init, whose whole job is to write the file,
  # fails with "is a directory" and the deployment is wedged until someone removes it by hand. The
  # ordering that should prevent it (the platform waits for console-init to complete) is honoured by
  # Docker Compose but not reliably by podman-compose, so the file is created here instead of
  # depending on it. Empty is correct: console-init overwrites it with the real schema.
  # The symlink test comes FIRST, and refuses rather than repairs. schema/ is world-writable — it
  # has to be, because the one-shot's uid is not the operator's — so a symlink planted at this path
  # would otherwise be followed by everything below, and this function would create and widen
  # whatever it points at (.env.secrets, say) under the operator's identity. Every other test here
  # dereferences; only -L sees the link. For the same reason the file is created with its mode
  # rather than chmod'ed afterwards: a chmod on a path in a world-writable directory is a primitive
  # worth not having at all, and an existing regular file needs no mode change — the one-shot wrote
  # through it last time.
  if [ -L schema/schema-noauth.graphql ]; then
    die "schema/schema-noauth.graphql is a symlink — refusing to write through it. Remove it, then run '$SELF up' again."
  fi
  if [ -d schema/schema-noauth.graphql ]; then
    rmdir schema/schema-noauth.graphql 2>/dev/null ||
      die "schema/schema-noauth.graphql is a non-empty directory — an engine created it in place of the file. Remove it and run '$SELF up' again."
  fi
  if [ ! -e schema/schema-noauth.graphql ]; then
    # 0666 at creation: the one-shot writes this file and its uid is not the operator's.
    ( umask 0111; : > schema/schema-noauth.graphql )
  elif [ ! -f schema/schema-noauth.graphql ]; then
    die "schema/schema-noauth.graphql is not a regular file — remove it, then run '$SELF up' again."
  fi

  # The console rewrites this file (never deletes it) when the deployment is connected to the cloud.
  # The symlink test comes first for the same reason it does above schema-noauth.graphql, and what it
  # refuses here is worse. [ -f ] dereferences, so a DANGLING link at this path is not "already
  # present" — the redirection below then CREATES the operator's file wherever the link points,
  # holding a mode layer that turns authentication off. mode/ is world-writable, so planting the link
  # needs no privilege, and `set -e` does not catch it: the redirection succeeds.
  if [ -L "$MODE_FILE" ]; then
    die "$MODE_FILE is a symlink — refusing to write through it. Remove it, then run '$SELF up' again."
  fi
  if [ ! -f "$MODE_FILE" ]; then
    printf 'ENABLE_NOAUTH=true\nNODE_ENV=development\n' > "$MODE_FILE"
    info "Seeded $MODE_FILE with the pure open-source defaults."
  fi
}

# ensure_password generates the database password once, into .env.secrets (mode 0600). A no-op once a
# password exists, so it is safe to call on every `up`.
ensure_password() {
  if [ -f "$SECRETS_FILE" ] && grep -Eq '^NEO4J_PASSWORD=.+' "$SECRETS_FILE"; then
    return 0
  fi
  local password
  password="$(gen_secret)"
  [ -n "$password" ] || die "Failed to generate a password (no openssl and no readable /dev/urandom)."
  umask 077
  {
    if [ -f "$SECRETS_FILE" ]; then grep -v '^NEO4J_PASSWORD=' "$SECRETS_FILE" || true; fi
    echo "NEO4J_PASSWORD=$password"
  } > "$SECRETS_FILE.tmp"
  mv "$SECRETS_FILE.tmp" "$SECRETS_FILE"
  chmod 0600 "$SECRETS_FILE"
  info "Wrote a new database password to $SECRETS_FILE (mode 0600)."
}

# do_bootstrap is full first-run setup: the explicit `bootstrap` command, and what `up` folds in.
do_bootstrap() { ensure_layout; ensure_password; }

# --- commands -----------------------------------------------------------------
cmd_bootstrap() { do_bootstrap; info "Ready. Start with: ${BOLD}$SELF up${RST}"; }

# The console image follows PLATFORM_VERSION unless .env pins CONSOLE_IMAGE. A pin left on an older
# tag makes console-init abort the start — say so here, before the stack comes up, rather than letting
# the operator discover it from a failed container. Bundles before the default existed shipped a pin,
# so an .env carried across an upgrade is exactly how this happens.
check_console_pin() {
  local pin ver
  pin="$(env_value CONSOLE_IMAGE '')"
  [ -n "$pin" ] || return 0
  ver="$(env_value PLATFORM_VERSION '')"
  [ -n "$ver" ] || return 0
  if [ "${pin##*:}" != "$ver" ]; then
    warn "CONSOLE_IMAGE in .env is pinned to ${BOLD}${pin}${RST}, but PLATFORM_VERSION is ${BOLD}${ver}${RST}."
    warn "The console refuses to serve a version it was not built for, so the start will abort."
    warn "Comment CONSOLE_IMAGE out to let it follow PLATFORM_VERSION, or set its tag to ${ver}."
  fi
}

# DB_IMAGE stays whatever .env says across upgrades. Say when it differs from the tested image — a warning,
# never a block: moving the database forward is the operator's decision, and a newer database cannot be
# downgraded, so it must not happen as a side effect of an update. Only the name:tag part is compared, so
# the same image pulled through a mirror does not warn.
check_db_image() {
  local img
  img="$(env_value DB_IMAGE '')"
  [ -n "$img" ] || return 0
  if [ "${img##*/}" != "${TESTED_DB_IMAGE##*/}" ]; then
    warn "DB_IMAGE in .env is ${BOLD}${img}${RST}; this bundle was tested with ${BOLD}${TESTED_DB_IMAGE}${RST}."
    warn "To move to it: back up data/memgraph first (there is no downgrade), set DB_IMAGE, then run ${BOLD}$SELF update${RST}."
  fi
}

# env_setting KEY prints KEY's value in .env as compose reads it ('' when unset): the last assignment wins, an `export `
# prefix and spaces around the name are allowed, an unquoted value ends at ' #', and one pair of surrounding quotes
# goes. env_value is left as it is for its other callers; this one decides a refusal, so it reads what the platform gets.
env_setting() {
  local key="$1" line val
  [ -f "$ENV_FILE" ] || return 0
  line="$(grep -E "^[[:space:]]*(export[[:space:]]+)?${key}[[:space:]]*=" "$ENV_FILE" 2>/dev/null | tail -1 || true)"
  [ -n "$line" ] || return 0
  val="$(printf '%s' "${line#*=}" | sed -E 's/^[[:space:]]+//')"
  case "$val" in
    \"*) val="$(printf '%s' "$val" | sed -E 's/^"([^"]*)".*$/\1/')" ;;
    \'*) val="$(printf '%s' "$val" | sed -E "s/^'([^']*)'.*\$/\\1/")" ;;
    *)   val="${val%%[[:space:]]#*}"; val="$(printf '%s' "$val" | sed -E 's/[[:space:]]+$//')" ;;
  esac
  printf '%s' "$val"
}

# The platform embeds in process now: this bundle has no ollama service, and the model is the one the release's MITRE
# data was made with. An .env carried across the upgrade can still name the old server's model — refuse that here,
# before anything starts, rather than after images are pulled and console-init refuses it. Everything else is a notice.
# data/ollama is never removed: it is the operator's, and it can hold gigabytes.
check_embedding_env() {
  local model k size src="$ENV_FILE" fix="Remove the EMBEDDING_MODEL line from $ENV_FILE"
  # Compose takes a variable from the shell's environment before .env, so an exported one is what the platform gets.
  if [ -n "${EMBEDDING_MODEL+set}" ]; then
    model="$EMBEDDING_MODEL"; src="your shell's environment (it overrides $ENV_FILE)"; fix="Unset EMBEDDING_MODEL in your shell"
  else
    model="$(env_setting EMBEDDING_MODEL)"
  fi
  if [ "$model" = embeddinggemma ]; then
    die "EMBEDDING_MODEL=embeddinggemma in $src names the old embedding server's model, which this release no longer runs. $fix: the platform embeds in process with its default model."
  elif [ -n "$model" ]; then
    info "EMBEDDING_MODEL in $src is ${BOLD}${model}${RST}; console-init checks it against this release's MITRE data before the start (removing it selects the default)."
  fi
  for k in EMBEDDING_URL EMBEDDING_SIMILARITY_THRESHOLD; do
    [ -z "$(env_setting "$k")" ] || info "$k in $ENV_FILE is no longer used (the platform embeds in process); you can remove the line."
  done
  if [ -f "$ENV_FILE" ]; then
    for k in $(grep -oE '^[[:space:]]*(export[[:space:]]+)?OLLAMA_[A-Z0-9_]+[[:space:]]*=' "$ENV_FILE" 2>/dev/null \
               | sed -E 's/^[[:space:]]*(export[[:space:]]+)?//; s/[[:space:]]*=$//' | sort -u); do
      info "$k in $ENV_FILE is no longer used (this bundle has no Ollama service); you can remove the line."
    done
  fi
  if [ -L data/ollama ]; then
    # Not followed and not named: data/ is writable by every local account, so the link may not be the operator's.
    info "data/ollama is a symbolic link to the old embedding server's model, which is no longer used. byodt does not follow it: check where it points (ls -l data/ollama) before you remove anything."
  elif [ -d data/ollama ] && ! owned_by_operator data/ollama; then
    info "data/ollama is owned by uid $(path_owner data/ollama), not by you or root; byodt leaves it alone."
  elif [ -d data/ollama ]; then
    size="$(du -sh data/ollama 2>/dev/null | cut -f1 || true)"
    info "data/ollama (${size:-size unknown}) holds the old embedding server's model and is no longer used. Once the new start has worked: sudo rm -rf data/ollama"
  fi
}

# project_containers SERVICE prints the ids of this project's containers of SERVICE, found by the project AND service
# labels in both providers' namespaces (Docker Compose: com.docker.compose.*, podman-compose: io.podman.compose.*),
# never by name or image, so no other project's container is ever selected.
project_containers() {
  local ns
  resolve_engine
  for ns in com.docker.compose io.podman.compose; do
    "$ENGINE" ps -aq --filter "label=$ns.project=dethernety" --filter "label=$ns.service=$1" 2>/dev/null || true
  done | sort -u | grep -v '^$' || true
}

# remove_old_ollama removes the ollama container an older bundle ran. Compose leaves a service's container running once
# the service leaves the file, and podman-compose's --remove-orphans removes every container of the project or none, so
# it is removed here, by its labels. It goes before `down` too, which cannot remove the network while it holds an
# endpoint. Its image and data/ollama stay.
remove_old_ollama() {
  local ids id
  ids="$(project_containers ollama)"
  [ -n "$ids" ] || return 0
  info "Removing the old embedding server's container (the platform embeds in process now; data/ollama is kept)…"
  for id in $ids; do
    "$ENGINE" rm -f "$id" >/dev/null || warn "Could not remove container $id; remove it with: $ENGINE rm -f $id"
  done
}

# check_console_init reads console-init's last run from the engine, by its labels: a refusal there fails the command
# with the pointer under either provider (podman-compose's `up -d` exits 0 when a dependency failed). The newest
# container counts, never a one-off `compose run` of it (Docker Compose labels one oneoff; podman-compose names it
# <project>_<service>_tmp<n>); one still running, or none, is left alone.
check_console_init() {
  local id state
  id="$(for c in $(project_containers console-init); do
          [ "$("$ENGINE" inspect -f '{{index .Config.Labels "com.docker.compose.oneoff"}}' "$c" 2>/dev/null || true)" = True ] && continue
          "$ENGINE" inspect -f '{{.Name}}' "$c" 2>/dev/null | grep -q '_tmp[0-9]' && continue
          printf '%s %s\n' "$("$ENGINE" inspect -f '{{.Created}}' "$c" 2>/dev/null || true)" "$c"
        done | sort | tail -1 | awk '{ print $NF }')"
  [ -n "$id" ] || return 0
  state="$("$ENGINE" inspect -f '{{.State.Status}} {{.State.ExitCode}}' "$id" 2>/dev/null || true)"
  case "$state" in
    "exited 0") return 0 ;;
    exited\ *) die "console-init stopped the start (exit ${state#exited }): '$SELF logs console-init' says why." ;;
  esac
}

# start_stack runs `compose up -d` and says where to look when the start is refused or fails.
start_stack() {
  if ! compose up -d "$@"; then
    die "The start was refused or failed: '$SELF status' shows which service; if console-init stopped it, '$SELF logs console-init' says why."
  fi
  # console-init runs for a full start and for every service but the console (which depends on nothing), so a start
  # of the console alone says nothing about console-init's last run.
  local s
  for s in "${@:-all}"; do
    [ "$s" = console ] || { check_console_init; return; }
  done
}

cmd_up() {
  # Always repair the layout (idempotent, silent when complete) so a bundle missing the mode layer or a
  # runtime dir is fixed here instead of failing inside compose; the one-time password stays gated.
  ensure_layout
  ensure_password
  check_console_pin
  check_db_image
  check_embedding_env
  remove_old_ollama
  info "Starting the stack…"
  start_stack "$@"
  info "Up. Console: ${BOLD}$(front_door_url)${RST}"
  info "First start downloads the embedding model once (about 1.26 GB; '$SELF models pull' does it ahead) and ingests reference data — '$SELF logs platform' and '$SELF logs console-init' to follow."
}

# compose down flags that delete data/images this command promises to keep. Refuse them explicitly
# rather than forwarding — a muscle-memory `down -v` must not wipe the named-volume graph, and `--rmi`
# would make destroy's "nothing was deleted" untrue. Safe flags (--remove-orphans, -t) pass through.
refuse_volume_flags() {
  local a
  for a in "$@"; do
    case "$a" in
      -v|--volumes|--rmi|--rmi=*)
        die "Refusing '$a' — it deletes data/images this command keeps by design. Remove the graph explicitly instead ('$SELF destroy' prints how)." ;;
    esac
  done
}

cmd_down() { ensure_ready; refuse_volume_flags "$@"; remove_old_ollama; info "Stopping (data kept)…"; compose down "$@"; }

cmd_restart() {
  ensure_ready
  # A recreate binds every runtime dir; one a newer bundle added (data/models) must exist first.
  ensure_layout
  remove_old_ollama
  if [ "$#" -gt 0 ]; then
    # Named services recreate exactly those, not their dependency chain: a `restart proxy`
    # re-reads the proxy's config without bouncing the database underneath it (--force-recreate
    # alone would pull in and recreate the dependencies too).
    info "Recreating: $* (named service(s) only)"
    compose up -d --force-recreate --no-deps "$@"
  else
    info "Recreating the stack (re-reads config + the mode layer)…"
    compose up -d --force-recreate
  fi
}

cmd_status() { ensure_ready; compose ps "$@"; }

cmd_logs() { ensure_ready; compose logs -f "$@"; }

cmd_update() {
  ensure_ready
  # The new bundle may mount a runtime dir the old one did not (data/models): without it, Docker creates it
  # root-owned and the platform cannot write its weights there, and Podman refuses the missing bind source.
  ensure_layout
  check_db_image
  check_embedding_env
  info "Pulling the pinned images…"; compose pull
  # After the pull: a failed pull must not leave the running platform without its old embedding server.
  remove_old_ollama
  info "Applying…"; start_stack
  info "Updated."
}

# db_query runs a single Cypher statement through mgconsole in the db container, non-interactively.
# -T so stdin pipes; credentials come from .env (user) and .env.secrets (password), host-side.
db_query() {
  local user pass
  user="$(env_value NEO4J_USERNAME dethernety)"
  pass="$(secret_value NEO4J_PASSWORD "")"
  [ -n "$pass" ] || die "No database password in $SECRETS_FILE."
  printf '%s\n' "$1" | compose exec -T db mgconsole --username "$user" --password "$pass"
}

# cmd_backup captures a consistent Memgraph snapshot and copies it OUT to a durable location.
# CREATE SNAPSHOT is hot and consistent (no downtime); the copy-out is the point — snapshots left in
# the data dir are pruned by Memgraph's own retention (count 3). Auth is NOT in a snapshot (it is
# separate system state), so a backup is graph-only: portable, and not a secret-bearing file.
cmd_backup() {
  ensure_ready
  # Reachability + credentials, the same probe the healthcheck uses.
  db_query 'RETURN 1;' >/dev/null 2>&1 \
    || die "Database is not reachable (running? credentials right?). Check '$SELF status'."

  # Ask for a fresh snapshot; on success CREATE SNAPSHOT returns the new file's container path, and
  # we copy exactly that (not "newest by mtime", which could pick a stale file). It fails with a
  # generic error when there have been no writes since the last snapshot; that case is benign (the
  # newest existing snapshot is already current), so we fall back to it — listed inside the container.
  info "Requesting a snapshot…"
  local created snappath=""
  created="$(db_query 'CREATE SNAPSHOT;' 2>/dev/null | grep -oE '/var/lib/memgraph/snapshots/[^"]+' | head -1 || true)"
  if [ -n "$created" ]; then
    snappath="$created"
  else
    local newest
    newest="$(compose exec -T db sh -c 'ls -t /var/lib/memgraph/snapshots 2>/dev/null | head -1' 2>/dev/null | tr -d '\r')"
    [ -n "$newest" ] && snappath="/var/lib/memgraph/snapshots/$newest"
  fi
  [ -n "$snappath" ] || die "No snapshot available to back up."

  local destdir="${1:-backups}"
  # No chmod here: the snapshot is the whole graph (sensitive), and `compose cp` writes it host-side
  # as the operator, so nothing needs this dir widened — let the operator's umask govern, and never
  # broaden a directory the operator named.
  mkdir -p "$destdir"
  local out="${destdir%/}/byodt-snapshot-$(env_value PLATFORM_VERSION 0)-$(date +%Y%m%d-%H%M%S).snapshot"
  # Copy OUT through the container so this works for both a host bind mount and a named volume (the
  # host cannot see a named volume's files directly). Same mechanism restore uses.
  compose cp "db:$snappath" "$out" >/dev/null 2>&1 || die "Failed to copy the snapshot out of the db container."

  info "Backup written: ${BOLD}$out${RST} ($(du -h "$out" 2>/dev/null | cut -f1 | tr -d ' '))"
  info "The whole graph is in here (no password) — keep it private and ${BOLD}copy it off-box${RST} so it survives losing this machine."
}

# cmd_restore replaces the current graph with a backup snapshot. DESTRUCTIVE: RECOVER SNAPSHOT ...
# FORCE clears all current data first (Memgraph moves existing WAL/snapshots aside to a hidden .old,
# so it cannot load the wrong, newer state). Auth is untouched (separate store), so the platform
# keeps using this deployment's own password. Snapshots are graph-only and version-sensitive.
cmd_restore() {
  ensure_ready
  local file="${1:-}"
  [ -n "$file" ] || die "usage: $SELF restore <backup-file>"
  [ -f "$file" ] || die "No such backup file: $file"

  # Best-effort version guard: our filenames encode the PLATFORM_VERSION the snapshot was taken on.
  local cur bkv="" base rest
  cur="$(env_value PLATFORM_VERSION 0)"
  base="${file##*/}"
  case "$base" in
    byodt-snapshot-*.snapshot)
      rest="${base#byodt-snapshot-}"; rest="${rest%.snapshot}"
      rest="${rest%-*}"; bkv="${rest%-*}" ;;
  esac
  if [ -n "$bkv" ] && [ "$bkv" != "$cur" ]; then
    warn "That backup was taken on version $bkv; this deployment is $cur — a snapshot may not load across versions."
  fi

  warn "This REPLACES the current graph with '$file'. All current graph data is cleared."
  printf 'Type %srestore%s to confirm: ' "$BOLD" "$RST"
  local reply=""; read -r reply || true
  [ "$reply" = "restore" ] || die "Aborted — nothing was changed."

  db_query 'RETURN 1;' >/dev/null 2>&1 \
    || die "Database is not reachable — start it with '$SELF up' first."

  # Stage the file where memgraph can read it. Host-written files under the data bind mount are not
  # reliably visible inside the container (engine/VM file sharing), so copy it INTO a container-local
  # path with `compose cp`, then make it world-readable as root — `compose cp` lands it owned by the
  # host uid, which memgraph's uid cannot read. RECOVER SNAPSHOT then copies it into the snapshots dir.
  local staged="/tmp/byodt-restore.snapshot"
  info "Staging the snapshot into the database container…"
  compose cp "$file" "db:$staged" >/dev/null 2>&1 || die "Could not copy the snapshot into the db container."
  compose exec -u root -T db chmod 0644 "$staged" >/dev/null 2>&1 || die "Could not make the staged snapshot readable."
  info "Restoring — clearing current data and applying the snapshot…"
  if db_query "RECOVER SNAPSHOT \"$staged\" FORCE;"; then
    compose exec -u root -T db rm -f "$staged" >/dev/null 2>&1 || true
    info "Restore complete. If the app still shows old or empty data, run '$SELF restart platform'."
  else
    compose exec -u root -T db rm -f "$staged" >/dev/null 2>&1 || true
    die "RECOVER SNAPSHOT failed — the current graph was left unchanged."
  fi
}

cmd_destroy() {
  ensure_ready
  # Deliberately does NOT delete data. Tears the stack down (containers + network) and hands the
  # operator the exact wipe commands to run explicitly — a script rm-ing an operator's data is a
  # footgun. `down` (no -v) keeps volumes, so a named-volume DB_DATA survives too. Especially keep
  # .env.secrets: it holds the DB password, and the database's auth was created with it — delete it
  # while the graph exists and the operator is locked out of their own data.
  refuse_volume_flags "$@"
  remove_old_ollama
  info "Removing the stack — containers and network. Your data and config are kept."
  compose down "$@"
  info "Stack removed; nothing was deleted. '$SELF up' brings it back as it was."
  printf '\n%sKeep .env.secrets%s — the database password, the key to your graph; deleting it while\n' "$BOLD" "$RST"
  printf 'the graph exists locks you out of your own data.\n\n'
  if db_is_bind; then
    printf 'To reset the graph and re-ingest (a fresh graph adopts the kept password):\n'
    printf '  rm -rf data/memgraph data/content-cache\n'
  else
    local vol; vol="$(env_value DB_DATA memgraph-data)"
    printf 'The graph lives in the named volume %s%s%s. To reset it and re-ingest, remove it:\n' "$BOLD" "$vol" "$RST"
    printf '  %s volume rm dethernety_%s   # find the exact name with: %s volume ls | grep %s\n' "$ENGINE" "$vol" "$ENGINE" "$vol"
  fi
  printf 'Left alone: your config (.env, .env.secrets, mode/, tls/).\n'
}

cmd_console() {
  local url; url="$(front_door_url)"
  info "Console: ${BOLD}${url}${RST}"
  command -v open >/dev/null 2>&1 && open "$url" >/dev/null 2>&1 || true
}

cmd_version() {
  printf '%sbyodt%s %s\n' "$BOLD" "$RST" "$BYODT_VERSION"
  if [ -f "$ENV_FILE" ]; then
    printf 'Pinned release (from %s):\n' "$ENV_FILE"
    grep -E '^(PLATFORM_VERSION|[A-Z_]*_IMAGE)=' "$ENV_FILE" | grep -v '^OLLAMA_IMAGE=' | sed 's/^/  /' || true
  fi
}

cmd_compose() { ensure_ready; compose "$@"; }

# cmd_models pull downloads and verifies the embedding model's weights into data/models ahead of the first start,
# with the platform's own code in a one-off platform container: its environment, its models mount, no database.
# --no-deps is required, not a nicety: without it podman-compose starts the dependencies with remove-orphans on.
cmd_models() {
  [ "${1:-}" = pull ] || die "Usage: $SELF models pull"
  do_bootstrap
  check_embedding_env
  local tty=()
  [ -t 0 ] || tty=(-T)
  info "Downloading and verifying the embedding model into data/models (once; the platform's first start then skips it)…"
  compose run --rm --no-deps ${tty[@]+"${tty[@]}"} platform node dist/scripts/models-pull.js
}

# Front-door TLS certificate management. The proxy terminates TLS for the whole stack when cert.pem +
# key.pem are present in tls/; these helpers create or inspect them. Apply a change with
# `byodt restart proxy` — the files sit inside an already-mounted directory, so `up` recreates
# nothing and the proxy entrypoint never re-renders the TLS server block.
cmd_tls() {
  local sub="${1:-status}"; shift || true
  case "$sub" in
    generate) tls_generate "$@" ;;
    status)   tls_status ;;
    *) die "usage: $SELF tls {generate|status}" ;;
  esac
}

tls_generate() {
  command -v openssl >/dev/null 2>&1 || die "openssl is required to generate a certificate."
  local host="${1:-$(hostname 2>/dev/null || echo localhost)}"
  mkdir -p tls
  # RSA (not EC) for portability across the openssl/LibreSSL an operator's machine might ship. A
  # self-signed cert encrypts the hop and makes the browser a secure context; it does not attest identity.
  umask 077
  if ! openssl req -x509 -newkey rsa:2048 -nodes -days 730 \
      -keyout tls/key.pem -out tls/cert.pem \
      -subj "/CN=${host}" \
      -addext "subjectAltName=DNS:localhost,DNS:${host},IP:127.0.0.1" >/dev/null 2>&1; then
    die "openssl failed to generate the certificate."
  fi
  chmod 600 tls/key.pem
  info "Wrote a self-signed certificate to tls/ (SANs: localhost, ${host}, 127.0.0.1)."
  # `up` is NOT enough: the certificate lands inside the already-mounted ./tls directory, so no
  # service's compose config changes and the proxy is not recreated — its entrypoint never
  # re-renders the TLS server block. Recreating the proxy is what applies it.
  info "Apply it with ${BOLD}$SELF restart proxy${RST} — the front door then serves HTTPS on the published port."
}

tls_status() {
  if [ -f tls/cert.pem ] && [ -f tls/key.pem ]; then
    info "A certificate is installed (tls/cert.pem) — the front door serves HTTPS once applied:"
    if command -v openssl >/dev/null 2>&1; then
      openssl x509 -in tls/cert.pem -noout -subject -issuer -dates 2>/dev/null | sed 's/^/  /' || true
    fi
  else
    info "No certificate — the front door serves plain HTTP."
    info "Add one with ${BOLD}$SELF tls generate${RST}, or drop your own cert.pem + key.pem into tls/, then ${BOLD}$SELF up${RST}."
  fi
}

usage() {
  cat <<EOF
${BOLD}byodt${RST} — manage this Dethernety deployment

${BOLD}Usage:${RST} $SELF <command> [args]

  up                 Start the stack / apply changes (bootstraps on first run)
  down               Stop the stack (data kept)
  restart [service]  Recreate to apply config/mode changes (all, or one service)
  status             Show service state
  logs [service]     Follow logs (all, or one service)
  update             Pull the pinned images and apply
  models pull        Download and verify the embedding model ahead of the first start
  backup [dir]       Snapshot the graph and copy it out (default: backups/)
  restore <file>     Replace the graph from a backup snapshot (asks to confirm)
  bootstrap          First-run setup (dirs, database password, mode seed)
  destroy            Remove the stack (containers + network); data on disk is kept
  console            Print (and open) the console URL
  tls {generate|status}  Manage the front-door TLS certificate
  version            Show the pinned release versions
  compose [args]     Run the engine's compose with this bundle's env files
  help               Show this help

Services: db, console-init, platform, proxy, console
EOF
}

# --- dispatch -----------------------------------------------------------------
cmd="${1:-help}"; shift || true
case "$cmd" in
  up|start)            require_engine; cmd_up "$@" ;;
  down|stop)           require_engine; cmd_down "$@" ;;
  restart)             require_engine; cmd_restart "$@" ;;
  status|ps)           require_engine; cmd_status "$@" ;;
  logs)                require_engine; cmd_logs "$@" ;;
  update|pull|upgrade) require_engine; cmd_update "$@" ;;
  backup)              require_engine; cmd_backup "$@" ;;
  restore)             require_engine; cmd_restore "$@" ;;
  bootstrap|init)      cmd_bootstrap "$@" ;;
  destroy|nuke)        require_engine; cmd_destroy "$@" ;;
  console|open)        cmd_console "$@" ;;
  tls)                 cmd_tls "$@" ;;
  version|--version)   cmd_version "$@" ;;
  compose)             require_engine; cmd_compose "$@" ;;
  models)              require_engine; cmd_models "$@" ;;
  help|-h|--help)      usage ;;
  *) printf '%serror:%s unknown command: %s\n\n' "$RED" "$RST" "$cmd" >&2; usage >&2; exit 2 ;;
esac
