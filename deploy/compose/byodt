6e04a29d4e85fc6ccffa47969d658257293ce7172520af6baf359528593d4a9b  .gitignore
0d96a4ff68ad6d4b6f1f30f713b18d5184912ba8dd389f86aa7710db079abcb0  LICENSE
182aa53a69ab8e29770541eb0220676f905939c40e50742c6f40d35264de006e  NOTICE
9cbc1b0b26b9b41dcd1e2e722afe3e474a4b2265cd8517b441ca0109400e7b46  README.md
01576eab86d9fe1e7ab326e28180e86c7c677ee7aad58de66697d8035d3dbccb  byodt
7cf550af095693e35b781009733873a924c12c26ea412b2c0f4a4acf9305432e  compose.memgraph.yaml
b07a28aa44c8eba2fd305d9e54d7a254a16075ce3769d0bded936f49f5832ecf  compose.neo4j.yaml
b1dcca74de5ce0fe96cae024a2ac90e09da9fe6500003863b7c02445f4eddb4c  compose.yaml
2c3643487608ad7fe7766e6f0adb0db6c118354c17be79fb47121c65108b0c3b  proxy/40-tls.sh
dfffa7f97ec89a827ee0178cf62b03087101d871d9f44f60289d3eddaa1c1612  proxy/nginx.conf
