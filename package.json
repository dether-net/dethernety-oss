{
  "name": "dethernety",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:production": "turbo build:production",
    "build:docker": "turbo build:docker",
    "docker:build": "docker build -f Dockerfile.production -t dethernety:latest .",
    "docker:run": "docker run --env-file .env.production -p 3000:3000 dethernety:latest",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "turbo run test",
    "m-cleanup": "turbo run m-cleanup",
    "m-ingest": "turbo run m-ingest",
    "parsetest": "turbo run parsetest",
    "docs:api": "node scripts/generate-api-docs.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "neo4j-driver": "^5.28.3",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "turbo": "^2.9.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.13.2",
  "pnpm": {
    "overrides": {
      "zod": "4.3.6",
      "hono": ">=4.12.14",
      "@hono/node-server": ">=1.19.13",
      "multer": ">=2.1.0",
      "lodash": ">=4.18.1",
      "lodash-es": ">=4.18.1",
      "ajv@^6.0.0": "^6.14.0",
      "ajv@^8.0.0": "^8.18.0",
      "minimatch@>=9.0.0": ">=9.0.7",
      "webpack": ">=5.105.4",
      "express-rate-limit": ">=8.2.2",
      "dompurify": ">=3.4.0",
      "file-type": ">=21.3.1",
      "handlebars": ">=4.7.9",
      "defu": ">=6.1.5",
      "path-to-regexp@>=8.0.0": ">=8.4.0",
      "picomatch@<4.0.0": ">=2.3.2",
      "picomatch@>=4.0.0": ">=4.0.4",
      "brace-expansion@<2.0.0": ">=1.1.13 <2.0.0",
      "brace-expansion@>=2.0.0 <3.0.0": ">=2.0.3 <3.0.0",
      "brace-expansion@>=5.0.0": ">=5.0.5",
      "yaml@<2.0.0": ">=1.10.3 <2.0.0",
      "flatted": ">=3.4.2",
      "@apollo/federation-internals": ">=2.13.2"
    }
  }
}
