      "body-parser": ">=2.3.0 <3.0.0",
      "@apollo/federation-internals": ">=2.13.2",
      "tmp": ">=0.2.6 <0.3.0",
      "protobufjs": ">=7.6.5 <8.0.0",
      "qs": ">=6.15.2 <7.0.0",
      "@grpc/grpc-js": ">=1.14.4",
      "esbuild": ">=0.28.1",
      "form-data": ">=4.0.6",
      "ws@>=8.0.0 <9.0.0": ">=8.21.0 <9.0.0",
